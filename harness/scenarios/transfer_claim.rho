// Claim a transfer through the recipient's account and read the balance.
// Placeholders: __ROOT_URI__, __RECIPIENT_PUB__, __TRANSFER_URI__, __SECRET__.
new
  rl(`rho:registry:lookup`),
  rootCh, afCh, ac, oCh, cCh, bCh,
  deployId(`rho:rchain:deployId`),
  deployerId(`rho:rchain:deployerId`)
in {
  rl!(`__ROOT_URI__`, *rootCh) |
  for (Root <- rootCh) {
    Root!("resolve", "component:account-factory", 1, *afCh) |
    for (@(true, afUri, _) <- afCh) {
      rl!(afUri, *ac) |
      for (AccountFactory <- ac) {
        AccountFactory!("getOrCreate", "__RECIPIENT_PUB__".hexToBytes(), *oCh) |
        for (@(true, account, ownerId) <- oCh) {
          @account!("claimTransfer", *deployerId, `__TRANSFER_URI__`,
                    "__SECRET__".hexToBytes(), *cCh) |
          for (@c <- cCh) {
            @account!("balance", *deployerId, "REV", *bCh) |
            for (@b <- bCh) { deployId!([c, b]) }
          }
        }
      }
    }
  }
}
