// Phase-1 scenario: report the owner's Account REV balance.
// Placeholders: __FACTORY_URI__
new
  deployerId(`rho:rchain:deployerId`),
  deployerIdOps(`rho:rchain:deployerId:ops`),
  rl(`rho:registry:lookup`),
  factoryCh,
  accountCh,
  pkCh,
  balCh,
  deployId(`rho:rchain:deployId`)
in {
  rl!(`__FACTORY_URI__`, *factoryCh) |
  deployerIdOps!("pubKeyBytes", *deployerId, *pkCh) |
  for (factory <- factoryCh; @pk <- pkCh) {
    factory!("getOrCreate", pk, *accountCh) |
    for (@(true, account, ownerId) <- accountCh) {
      @account!("balance", *deployerId, "REV", *balCh) |
      for (@b <- balCh) { deployId!((ownerId, b)) }
    }
  }
}
