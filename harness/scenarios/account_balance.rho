// The owner's REV account balance. Returns [balance].
// Placeholders: __ROOT_URI__, __PUBKEY__, __ASSET__.
new
  rl(`rho:registry:lookup`), rootCh, afCh, ac, oCh, balCh,
  deployId(`rho:rchain:deployId`)
in {
  rl!(`__ROOT_URI__`, *rootCh) |
  for (Root <- rootCh) {
    Root!("resolve", "component:account-factory", 1, *afCh) |
    for (@(true, afUri, _) <- afCh) {
      rl!(afUri, *ac) |
      for (AccountFactory <- ac) {
        AccountFactory!("getOrCreate", "__PUBKEY__".hexToBytes(), *oCh) |
        for (@(true, account, ownerId) <- oCh) {
          @account!("balance", ownerId, "__ASSET__", *balCh) |
          for (@b <- balCh) { deployId!([b]) }
        }
      }
    }
  }
}
