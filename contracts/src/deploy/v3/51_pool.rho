// v0.4 pool assembly: one oracle-anchored FxPool per direct market.
// PoolTemplate resolves the assets and creates the purses; assemblePool holds
// the pool arms. The factory calls the template and binds the returned URI.
// Placeholders: __ROOT_URI__, __ASSET_RESOLVER_URI__.
new
  PoolTemplate, assemblePool, poolAmmMath, poolRate, lockCreate,
  poolStatus, poolActive, poolOpen, poolGate, poolTradeAdmit,
  rl(`rho:registry:lookup`),
  revAddress(`rho:rev:address`),
  deployerIdOps(`rho:rchain:deployerId:ops`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, Root, uTemplate, ack
in {

  contract poolStatus(@marketId, ret) = {
    new rCh, iCh, ic in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:market-index", 1, *iCh) |
        for (@(true, idxUri, _) <- iCh) {
          rl!(idxUri, *ic) |
          for (MarketIndex <- ic) { MarketIndex!("market", marketId, *ret) }
        }
      }
    }
  } |

  contract poolActive(@marketId, ret) = {
    new r in {
      poolStatus!(marketId, *r) |
      for (@x <- r) {
        match x {
          (true, record) => { ret!((true, record.get("status") == "active")) }
          (false, why) => { ret!((false, why)) }
          _ => { ret!(1 / 0) }
        }
      }
    }
  } |

  // A pool may be seeded while its market is a draft; the draft becomes active
  // only after the seed and the lock. Paused and delisted markets refuse adds.
  contract poolOpen(@marketId, ret) = {
    new r in {
      poolStatus!(marketId, *r) |
      for (@x <- r) {
        match x {
          (true, record) => {
            match record.get("status") {
              "draft" => { ret!((true, true)) }
              "active" => { ret!((true, true)) }
              _ => { ret!((true, false)) }
            }
          }
          (false, why) => { ret!((false, why)) }
          _ => { ret!(1 / 0) }
        }
      }
    }
  } |

  contract poolGate(ret) = {
    new rCh, gCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:tradability-gate", 1, *gCh) |
        for (@(true, gateUri, _) <- gCh) {
          new gc in {
            rl!(gateUri, *gc) |
            for (TradabilityGate <- gc) { ret!(*TradabilityGate) }
          }
        }
      }
    }
  } |

  contract poolTradeAdmit(@terms, @inValue, @poolValue, ret) = {
    new capCh, gCh in {
      poolGate!(*capCh) |
      for (TradabilityGate <- capCh) {
        TradabilityGate!("admit", "active", true, inValue, poolValue, terms, *gCh) |
        for (@g <- gCh) { ret!(g) }
      }
    }
  } |

  contract poolRate(@base, @quote, @maxAge, ret) = {
    new rCh, xCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:oracle-hub", 1, *xCh) |
        for (@(true, hubUri, _) <- xCh) {
          new hc, rrCh in {
            rl!(hubUri, *hc) |
            for (OracleHub <- hc) {
              OracleHub!("getPair", base, quote, maxAge, *rrCh) |
              for (@rr <- rrCh) {
                match rr {
                  (true, m) => {
                    if (m.get("fresh")) { ret!((true, m.get("rate"))) }
                    else { ret!((false, "stale feed")) }
                  }
                  (false, why) => { ret!((false, why)) }
                  _ => { ret!(1 / 0) }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract lockCreate(@lpIssuer, @lpBrand, @terms, @termsHash, ret) = {
    new rCh, fCh, fc, lockCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:liquidity-lock-factory", 1, *fCh) |
        for (@fr <- fCh) {
          match fr {
            (true, factoryUri, _) => {
              rl!(factoryUri, *fc) |
              for (LockFactory <- fc) {
                LockFactory!("create", lpIssuer, lpBrand, terms, termsHash, *lockCh) |
                for (@l <- lockCh) {
                  match l {
                    (true, lockUri) => { ret!((true, lockUri)) }
                    (false, why) => { ret!((false, why)) }
                    _ => { ret!(1 / 0) }
                  }
                }
              }
            }
            (false, why) => { ret!((false, why)) }
            _ => { ret!(1 / 0) }
          }
        }
      }
    }
  } |

  contract poolAmmMath(ret) = {
    new rCh, mCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:amm-math", 1, *mCh) |
        for (@(true, mathUri, _) <- mCh) {
          new mc in {
            rl!(mathUri, *mc) |
            for (AmmMath <- mc) { ret!(*AmmMath) }
          }
        }
      }
    }
  } |

  contract assemblePool(@terms, @termsHash, @baseBrand, @baseIssuer, @basePurse,
                       @quoteBrand, @quoteIssuer, @quotePurse,
                       @lpBrand, @lpMint, @lpIssuer, @lpBurnFacet, ret) = {
    new uPool in {
  new FxPool, commitLiquidity, poolState,
        swapCalc, swapValue, swapExec in {
    contract commitLiquidity(@s, basePayment, quotePayment,
                               @baseAmt, @quoteAmt, @rate,
                               @minShares, ret2) = {
        new mCh in { poolAmmMath!(*mCh) | for (AmmMath <- mCh) { new valCh, oldValCh, sharesCh in {
          AmmMath!("value", s.get("rb") + baseAmt,
                   s.get("rq") + quoteAmt, rate, *valCh) |
          AmmMath!("value", s.get("rb"), s.get("rq"), rate, *oldValCh) |
          for (@depositValue <- valCh; @poolValue <- oldValCh) {
            match (s.get("seeded")) {
              true => {
                AmmMath!("shares", depositValue - poolValue,
                         s.get("totalShares"), poolValue, false,
                         *sharesCh)
              }
              _ => {
                new okCh in {
                  match ((baseAmt * rate) / 100000000).toInt() {
                    baseValue => {
                      if (baseValue >= quoteAmt) {
                        if ((baseValue - quoteAmt) * 10000
                            > terms.get("firstDepositToleranceBps")
                              * (baseValue + quoteAmt)) { okCh!(false) }
                        else { okCh!(true) }
                      } else {
                        if ((quoteAmt - baseValue) * 10000
                            > terms.get("firstDepositToleranceBps")
                              * (baseValue + quoteAmt)) { okCh!(false) }
                        else { okCh!(true) }
                      }
                    }
                  } |
                  for (@ok2 <- okCh) {
                    if (ok2 == false) {
                      poolState!(s) | ret2!((false, "first deposit balance", *basePayment, *quotePayment))
                    } else {
                      if (depositValue < terms.get("minLiquidity")) {
                        poolState!(s) | ret2!((false, "min liquidity", *basePayment, *quotePayment))
                      } else {
                        AmmMath!("shares", depositValue, 0, 0, true, *sharesCh)
                      }
                    }
                  }
                }
              }
            } |
            for (@sharesOut <- sharesCh) {
              if (sharesOut <= 0 || sharesOut < minShares) {
                poolState!(s) | ret2!((false, "shares", *basePayment, *quotePayment))
              } else {
                new bdCh, qdCh, lpCh in {
                  @basePurse!("deposit", *basePayment, *bdCh) |
                  @quotePurse!("deposit", *quotePayment, *qdCh) |
                  for (@bd <- bdCh; @qd <- qdCh) {
                    match bd {
                      (true, _) => {
                        match qd {
                          (true, _) => {
                            @lpMint!("mintPayment", (lpBrand, sharesOut), *lpCh) |
                            for (@lp <- lpCh) {
                              match lp {
                                (true, lpPayment) => {
                                  poolState!(s.set("rb", s.get("rb") + baseAmt)
                                               .set("rq", s.get("rq") + quoteAmt)
                                               .set("totalShares", s.get("totalShares") + sharesOut)
                                               .set("seeded", true)
                                               .set("rev", s.get("rev") + 1)) |
                                  ret2!((true, lpPayment, sharesOut))
                                }
                                _ => { ret2!(1 / 0) }
                              }
                            }
                          }
                          _ => { ret2!(1 / 0) }
                        }
                      }
                      _ => { ret2!(1 / 0) }
                    }
                  }
                }
              }
            }
          }
        } } }
      } |
  
  contract FxPool(@"pair", ret2) = {
      ret2!((true, terms.get("base"), terms.get("quote")))
    } |
    contract FxPool(@"reserves", ret2) = {
      for (@s <<- poolState) {
        ret2!((true, {"base": s.get("rb"), "quote": s.get("rq"),
                      "totalShares": s.get("totalShares"),
                      "seeded": s.get("seeded")}))
      }
    } |
    contract FxPool(@"balances", ret2) = {
      new b1, b2 in {
        @basePurse!("getCurrentAmount", *b1) |
        @quotePurse!("getCurrentAmount", *b2) |
        for (@x <- b1; @y <- b2) { ret2!((true, x, y)) }
      }
    } |

    contract FxPool(@"attest", ret2) = {
      for (@s <<- poolState) {
        ret2!((true, {
          "marketId": terms.get("marketId"),
          "termsHash": termsHash,
          "base": terms.get("base"),
          "quote": terms.get("quote"),
          "rb": s.get("rb"),
          "rq": s.get("rq"),
          "totalShares": s.get("totalShares"),
          "seeded": s.get("seeded")
        }))
      }
    } |
    contract FxPool(@"quote", @dir, @dx, ret2) = {
      new rateCh, activeCh in {
        poolRate!(terms.get("base"), terms.get("quote"),
                 terms.get("maxPairAgeBlocks"), *rateCh) |
        poolActive!(terms.get("marketId"), *activeCh) |
        for (@rr <- rateCh; @active <- activeCh) {
          match rr {
            (true, rate) => {
              match active {
                (true, true) => {
                  if (rate <= 0) { ret2!((false, "stale feed")) }
                  else {
                for (@s <<- poolState) {
                  new mCh in { poolAmmMath!(*mCh) | for (AmmMath <- mCh) { new wCh, fCh in {
                    AmmMath!("weight", s.get("rb"), s.get("rq"), rate, *wCh) |
                    for (@w <- wCh) {
                      AmmMath!("fee", w, terms.get("baseSpreadBps"),
                               terms.get("skewSpreadBps"), *fCh) |
                      for (@fee <- fCh) {
                        new o2Ch in {
                          AmmMath!("out", dir, dx, rate, fee, *o2Ch) |
                          for (@out <- o2Ch) {
                            ret2!((true, out, fee, rate))
                          }
                        }
                      }
                    }
                  } } }
                }
              }
                }
                (true, false) => { ret2!((false, "not active")) }
                (false, why) => { ret2!((false, why)) }
                _ => { ret2!(1 / 0) }
              }
            }
            (false, why) => { ret2!((false, why)) }
            _ => { ret2!(1 / 0) }
          }
        }
      }
    } |
    contract FxPool(@"swap", @dir, inputPayment, @minOut, ret2) = {
      for (@s <<- poolState) {
        new rateCh, activeCh in {
          poolRate!(terms.get("base"), terms.get("quote"),
                   terms.get("maxPairAgeBlocks"), *rateCh) |
          poolActive!(terms.get("marketId"), *activeCh) |
          for (@rr <- rateCh; @active <- activeCh) {
            match rr {
            (true, rate) => {
              match active {
                (true, true) => {
                  if (rate <= 0) { ret2!((false, "stale feed", *inputPayment)) }
                  else { swapCalc!(s, dir, *inputPayment, minOut, rate, *ret2) }
                }
                (true, false) => { ret2!((false, "not active", *inputPayment)) }
                (false, why) => { ret2!((false, why, *inputPayment)) }
                _ => { ret2!(1 / 0) }
              }
            }
            (false, why) => { ret2!((false, why, *inputPayment)) }
            _ => { ret2!(1 / 0) }
          }
          }
        }
      }
    } |

    // swapCalc reads the payment amount with the input side's issuer.
    contract swapCalc(@s, @dir, inputPayment, @minOut, @rate, ret2) = {
      new amtCh in {
        match dir {
          "b2q" => { @baseIssuer!("getAmountOf", *inputPayment, *amtCh) }
          _ => { @quoteIssuer!("getAmountOf", *inputPayment, *amtCh) }
        } |
        for (@am <- amtCh) {
          match am {
            (true, amount) => {
              swapValue!(s, dir, *inputPayment, minOut, rate, amount, *ret2)
            }
            _ => { ret2!((false, "not this asset", *inputPayment)) }
          }
        }
      }
    } |

    // swapValue computes the pool value, fee and output for one amount.
    contract swapValue(@s, @dir, inputPayment, @minOut, @rate, @amount, ret2) = {
      new mCh in {
        poolAmmMath!(*mCh) |
        for (AmmMath <- mCh) {
          new valCh, wCh, fCh, o2Ch in {
            AmmMath!("value", s.get("rb"), s.get("rq"), rate, *valCh) |
            AmmMath!("weight", s.get("rb"), s.get("rq"), rate, *wCh) |
            for (@poolValue <- valCh; @w <- wCh) {
              AmmMath!("fee", w, terms.get("baseSpreadBps"),
                       terms.get("skewSpreadBps"), *fCh) |
              for (@fee <- fCh) {
                AmmMath!("out", dir, amount, rate, fee, *o2Ch) |
                for (@out <- o2Ch) {
                  if (out <= 0 || out < minOut) {
                    ret2!((false, "output", *inputPayment))
                  } else {
                    new inValueCh in {
                      match dir {
                        "b2q" => {
                          match ((amount * rate) / 100000000).toInt() { v => inValueCh!(v) }
                        }
                        _ => { inValueCh!(amount) }
                      } |
                      for (@inValue <- inValueCh) {
                        swapExec!(s, dir, *inputPayment, minOut, amount, out,
                                  inValue, poolValue, *ret2)
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    } |

    // swapExec admits the trade, moves the payments and commits the reserves.
    contract swapExec(@s, @dir, inputPayment, @minOut, @amount, @out,
                      @inValue, @poolValue, ret2) = {
      new admitCh in {
        poolTradeAdmit!(terms, inValue, poolValue, *admitCh) |
        for (@g <- admitCh) {
          match g {
            (true, Nil) => {
              for (@s2 <- poolState) {
                if (s2.get("rev") != s.get("rev")) {
                  poolState!(s2) | ret2!((false, "conflict", *inputPayment))
                } else {
                  new depCh, wdCh in {
                    match dir {
                      "b2q" => {
                        @basePurse!("deposit", *inputPayment, *depCh) |
                        @quotePurse!("withdraw", (quoteBrand, out), *wdCh)
                      }
                      _ => {
                        @quotePurse!("deposit", *inputPayment, *depCh) |
                        @basePurse!("withdraw", (baseBrand, out), *wdCh)
                      }
                    } |
                    for (@d <- depCh; @w2 <- wdCh) {
                      match d {
                        (true, _) => {
                          match w2 {
                            (true, outPayment) => {
                              match dir {
                                "b2q" => {
                                  poolState!(s2.set("rb", s2.get("rb") + amount)
                                               .set("rq", s2.get("rq") - out)
                                               .set("rev", s2.get("rev") + 1))
                                }
                                _ => {
                                  poolState!(s2.set("rb", s2.get("rb") - out)
                                               .set("rq", s2.get("rq") + amount)
                                               .set("rev", s2.get("rev") + 1))
                                }
                              } |
                              ret2!((true, outPayment, out))
                            }
                            _ => { ret2!(1 / 0) }
                          }
                        }
                        _ => { ret2!(1 / 0) }
                      }
                    }
                  }
                }
              }
            }
            _ => { ret2!(g) }
          }
        }
      }
    } |
    contract FxPool(@"addLiquidity", basePayment, quotePayment, @minShares, ret2) = {
      for (@s <<- poolState) {
        new rateCh, activeCh in {
          poolRate!(terms.get("base"), terms.get("quote"),
                   terms.get("maxPairAgeBlocks"), *rateCh) |
          poolOpen!(terms.get("marketId"), *activeCh) |
          for (@rr <- rateCh; @active <- activeCh) {
            match rr {
            (true, rate) => {
              match active {
                (true, true) => {
                  if (rate <= 0) { ret2!((false, "stale feed", *basePayment, *quotePayment)) }
                  else {
                    new bAmtCh, qAmtCh in {
                      @baseIssuer!("getAmountOf", *basePayment, *bAmtCh) |
                      @quoteIssuer!("getAmountOf", *quotePayment, *qAmtCh) |
                      for (@ba <- bAmtCh; @qa <- qAmtCh) {
                        match ba {
                          (true, baseAmt) => {
                            match qa {
                              (true, quoteAmt) => {
                                for (@s2 <- poolState) {
                                  if (s2.get("rev") != s.get("rev")) {
                                    poolState!(s2) | ret2!((false, "conflict", *basePayment, *quotePayment))
                                  } else {
                                    commitLiquidity!(s2, *basePayment, *quotePayment,
                                                     baseAmt, quoteAmt, rate,
                                                     minShares, *ret2)
                                  }
                                }
                              }
                              _ => { ret2!((false, "not quote", *basePayment, *quotePayment)) }
                            }
                          }
                          _ => { ret2!((false, "not base", *basePayment, *quotePayment)) }
                        }
                      }
                    }
                  }
                }
                (true, false) => { ret2!((false, "not active", *basePayment, *quotePayment)) }
                (false, why) => { ret2!((false, why, *basePayment, *quotePayment)) }
                _ => { ret2!(1 / 0) }
              }
            }
            (false, why) => { ret2!((false, why, *basePayment, *quotePayment)) }
            _ => { ret2!(1 / 0) }
          }
          }
        }
      }
    } |
  
    contract FxPool(@"removeLiquidity", lpPayment, @minBase, @minQuote, ret2) = {
      for (@s <<- poolState) {
        new lpCh in {
          @lpIssuer!("getAmountOf", *lpPayment, *lpCh) |
          for (@lpAmt <- lpCh) {
            match lpAmt {
              (true, shares) => {
                if (shares <= 0 || s.get("totalShares") <= 0
                    || shares > s.get("totalShares")) {
                  ret2!((false, "shares", *lpPayment))
                } else {
                  new bOut, qOut in {
                    bOut!(((s.get("rb") * shares) / s.get("totalShares")).toInt()) |
                    qOut!(((s.get("rq") * shares) / s.get("totalShares")).toInt()) |
                    for (@baseOut <- bOut; @quoteOut <- qOut) {
                      if (baseOut < minBase || quoteOut < minQuote) {
                        ret2!((false, "minimum", *lpPayment))
                      } else {
                        for (@s2 <- poolState) {
                          if (s2.get("rev") != s.get("rev")) {
                            poolState!(s2) | ret2!((false, "conflict", *lpPayment))
                          } else {
                            new burnCh, bwCh, qwCh in {
                              @lpBurnFacet!("deposit", *lpPayment, *burnCh) |
                              @basePurse!("withdraw", (baseBrand, baseOut), *bwCh) |
                              @quotePurse!("withdraw", (quoteBrand, quoteOut), *qwCh) |
                              for (@bn <- burnCh; @bp <- bwCh; @qp <- qwCh) {
                                match bn {
                                  (true, _) => {
                                    match bp {
                                      (true, basePayment) => {
                                        match qp {
                                          (true, quotePayment) => {
                                            match (s2.get("totalShares") - shares) {
                                              remaining => {
                                                poolState!(s2.set("rb", s2.get("rb") - baseOut)
                                                             .set("rq", s2.get("rq") - quoteOut)
                                                             .set("totalShares", remaining)
                                                             .set("seeded", remaining > 0)
                                                             .set("rev", s2.get("rev") + 1)) |
                                                ret2!((true, basePayment, quotePayment))
                                              }
                                            }
                                          }
                                          _ => { ret2!(1 / 0) }
                                        }
                                      }
                                      _ => { ret2!(1 / 0) }
                                    }
                                  }
                                  _ => { ret2!(1 / 0) }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
              _ => { ret2!((false, "not an LP payment", *lpPayment)) }
            }
          }
        }
      }
    } |
    poolState!({"rb": 0, "rq": 0, "totalShares": 0,
                "seeded": false, "rev": 0}) |
    rs!(bundle+{*FxPool}, *uPool) |
    for (@poolUri <- uPool) {
      new lockCh in {
        lockCreate!(lpIssuer, lpBrand, terms, termsHash, *lockCh) |
        for (@lock <- lockCh) {
          match lock {
            (true, lockUri) => { ret!((true, poolUri, lockUri)) }
            (false, why) => { ret!((false, why)) }
            _ => { ret!(1 / 0) }
          }
        }
      }
    }

  }
    }
  } |

  contract PoolTemplate(@"create", @terms, @termsHash, ret) = {
    new ec, rCh, aCh, a2Ch, bpCh, qpCh, lpCh, burnPurseCh, burnFacetCh in {
      rl!(`rho:rchain:ertp`, *ec) |
      for (@(_, ERTP) <- ec) {
        rl!(`__ASSET_RESOLVER_URI__`, *rCh) |
        for (AssetResolver <- rCh) {
          AssetResolver!("issuer", terms.get("base"), *aCh) |
          for (@bi <- aCh) {
            match bi {
              (true, baseBrand, baseIssuer) => {
                AssetResolver!("issuer", terms.get("quote"), *a2Ch) |
                for (@qi <- a2Ch) {
                  match qi {
                    (true, quoteBrand, quoteIssuer) => {
                      @baseIssuer!("makeEmptyPurse", *bpCh) |
                      @quoteIssuer!("makeEmptyPurse", *qpCh) |
                      @ERTP!("makeIssuerKit", *lpCh) |
                      for (@(true, basePurse) <- bpCh; @(true, quotePurse) <- qpCh;
                           @(lpBrand, lpMint, lpIssuer) <- lpCh) {
                        @lpIssuer!("makeEmptyPurse", *burnPurseCh) |
                        for (@(true, lpBurnPurse) <- burnPurseCh) {
                          @lpBurnPurse!("getDepositFacet", *burnFacetCh) |
                          for (@(true, lpBurnFacet) <- burnFacetCh) {
                            assemblePool!(terms, termsHash, baseBrand, baseIssuer,
                                          basePurse, quoteBrand, quoteIssuer,
                                          quotePurse, lpBrand, lpMint, lpIssuer,
                                          lpBurnFacet, *ret)
                          }
                        }
                      }
                    }
                    _ => { ret!(qi) }
                  }
                }
              }
              _ => { ret!(bi) }
            }
          }
        }
      }
    }
  } |


  rl!(`__ROOT_URI__`, *rootCh) |
  for (Root <- rootCh) {
    rs!(bundle+{*PoolTemplate}, *uTemplate) |
    for (@uri <- uTemplate) {
      Root!("register", "component:pool-template", uri, 1, "factory", *deployerId, *ack) |
      for (@r <- ack) { deployId!([uri]) }
    }
  }
}
