// v0.3 ZoneTemplate: creates one CurrencyZone from signed, bounded parameters.
// The first version implements identity, views and pause. Collateral, borrow,
// repay and liquidation are the next zone increment.
// Placeholders: __ROOT_URI__.
new
  ZoneTemplate, zoneCreateCheck,
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  bd(`rho:block:data`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, Root, uTemplate, ack
in {

  contract zoneCreateCheck(@currency, @params, @paramsHash, @sponsorHex, @sig, ret) = {
    new rCh, verCh, bCh, cCh, payloadCh, dCh, okCh, bzCh, hCh in {
      payloadCh!(
        "rcash:zone-create:v3|" ++ currency ++ "|" ++ paramsHash ++ "|" ++ sponsorHex) |
      for (@payload <- payloadCh) {
        rl!(`__ROOT_URI__`, *rCh) |
        for (Root <- rCh) {
          Root!("resolve", "component:verifier", 1, *verCh) |
          Root!("resolve", "component:bounds", 1, *bCh) |
          Root!("resolve", "component:codec", 1, *cCh) |
          for (@(true, vUri, vv) <- verCh;
               @(true, bUri, bv) <- bCh;
               @(true, cUri, cv) <- cCh) {
            new vc, bc, cc in {
              rl!(vUri, *vc) | rl!(bUri, *bc) | rl!(cUri, *cc) |
              for (Verifier <- vc; Bounds <- bc; Codec <- cc) {
                Verifier!("hash", payload.toUtf8Bytes(), *dCh) |
                for (@digest <- dCh) {
                  Verifier!("sigOk", digest, sig, sponsorHex.hexToBytes(), *okCh) |
                  for (@ok <- okCh) {
                    if (ok == false) { ret!((false, "bad sponsor signature")) }
                    else {
                      Bounds!("checkZone", params, *bzCh) |
                      for (@bz <- bzCh) {
                        match bz {
                          (true, Nil) => {
                            Codec!("hash", "rcash:zone-params:v3",
                                   [currency,
                                    params.get("mcrBps").toString(),
                                    params.get("bonusBps").toString(),
                                    params.get("closeFactorBps").toString(),
                                    params.get("ratePerBlock").toString(),
                                    params.get("debtCeiling").toString(),
                                    params.get("minDebt").toString(),
                                    params.get("maxDebt").toString()], *hCh) |
                            for (@h <- hCh) {
                              if (h != paramsHash.hexToBytes()) {
                                ret!((false, "params hash"))
                              } else { ret!((true, Nil)) }
                            }
                          }
                          _ => { ret!(bz) }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract ZoneTemplate(@"create", @currency, @params, @paramsHash,
                         @sponsorHex, @sig, ret) = {
    new checkCh in {
      zoneCreateCheck!(currency, params, paramsHash, sponsorHex, sig, *checkCh) |
      for (@check <- checkCh) {
        match check {
          (true, Nil) => {
            new ertpCh, kitCh, revIssuerCh, burnPurseCh, revPurseCh, burnFacetCh,
                nowCh in {
              rl!(`rho:rchain:ertp`, *ertpCh) |
              for (@(_, ERTP) <- ertpCh) {
                @ERTP!("makeIssuerKit", *kitCh) |
                @ERTP!("getRevIssuer", *revIssuerCh) |
                for (@(brand, mint, issuer) <- kitCh;
                     @(revBrand, revIssuer) <- revIssuerCh) {
                  @issuer!("makeEmptyPurse", *burnPurseCh) |
                  @revIssuer!("makeEmptyPurse", *revPurseCh) |
                  for (@(true, burnPurse) <- burnPurseCh;
                       @(true, revPurse) <- revPurseCh) {
                    @burnPurse!("getDepositFacet", *burnFacetCh) |
                    for (@(true, burnFacet) <- burnFacetCh) {
                      bd!(*nowCh) |
                      for (@now, @sender, @ts <- nowCh) {
                        new zoneState, CurrencyZone,
                            zoneNow, zoneRate, zoneHealth, zoneGovernor,
                            uriCh, attCh in {
                          zoneState!({
                            "currency": currency,
                            "params": params,
                            "paramsHash": paramsHash,
                            "sponsor": sponsorHex,
                            "template": "rcash:currency-zone:v3",
                            "vaults": {},
                            "totalPrincipal": 0,
                            "totalDebt": 0,
                            "totalAccruedInterest": 0,
                            "totalCollateral": 0,
                            "badDebt": 0,
                            "paused": false,
                            "rev": 0
                          }) |

                          contract zoneNow(ret2) = {
                            new rCh2, cCh2 in {
                              rl!(`__ROOT_URI__`, *rCh2) |
                              for (Root2 <- rCh2) {
                                Root2!("resolve", "component:clock", 1, *cCh2) |
                                for (@(true, clockUri, v2) <- cCh2) {
                                  new cc2 in {
                                    rl!(clockUri, *cc2) |
                                    for (Clock <- cc2) { Clock!("now", *ret2) }
                                  }
                                }
                              }
                            }
                          } |

                          contract zoneRate(ret2) = {
                            new rCh2, hCh2, rrCh2 in {
                              rl!(`__ROOT_URI__`, *rCh2) |
                              for (Root2 <- rCh2) {
                                Root2!("resolve", "component:oracle-hub", 1, *hCh2) |
                                for (@(true, hubUri, v2) <- hCh2) {
                                  new hc2 in {
                                    rl!(hubUri, *hc2) |
                                    for (OracleHub <- hc2) {
                                      OracleHub!("getPair", "REV", currency, 50, *rrCh2) |
                                      for (@rr2 <- rrCh2) {
                                        match rr2 {
                                          (true, m) => { ret2!((m.get("rate"), m.get("fresh"))) }
                                          _ => { ret2!((0, false)) }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          } |

                          contract zoneHealth(@collateral, @debt, @rate, @mcr, ret2) = {
                            new rCh2, rmCh2 in {
                              rl!(`__ROOT_URI__`, *rCh2) |
                              for (Root2 <- rCh2) {
                                Root2!("resolve", "component:risk-math", 1, *rmCh2) |
                                for (@(true, rmUri, v2) <- rmCh2) {
                                  new rc2 in {
                                    rl!(rmUri, *rc2) |
                                    for (RiskMath <- rc2) {
                                      RiskMath!("health", collateral, debt, rate, mcr, *ret2)
                                    }
                                  }
                                }
                              }
                            }
                          } |

                          contract zoneGovernor(ret2) = {
                            new rCh2, gCh2 in {
                              rl!(`__ROOT_URI__`, *rCh2) |
                              for (Root2 <- rCh2) {
                                Root2!("resolve", "component:governor", 1, *gCh2) |
                                for (@(true, govUri, v2) <- gCh2) {
                                  new gc2 in {
                                    rl!(govUri, *gc2) |
                                    for (Governor <- gc2) { ret2!(*Governor) }
                                  }
                                }
                              }
                            }
                          } |

                          contract CurrencyZone(@request, ret2) = {
                            match request {
                              ["currency"] => { ret2!((true, currency)) }
                              ["params"] => { ret2!((true, params)) }
                              ["brand"] => { ret2!((true, brand)) }
                              ["issuer"] => { ret2!((true, issuer)) }
                              ["attest"] => {
                                ret2!((true, {
                                  "currency": currency,
                                  "params": params,
                                  "paramsHash": paramsHash,
                                  "sponsor": sponsorHex,
                                  "template": "rcash:currency-zone:v3"
                                }))
                              }
                              ["open", ownerId, proof] => {
                                new rCh2, afCh2, vCh2, nowCh2 in {
                                  rl!(`__ROOT_URI__`, *rCh2) |
                                  for (Root2 <- rCh2) {
                                    Root2!("resolve", "component:account-factory", 1, *afCh2) |
                                    for (@(true, afUri, v2) <- afCh2) {
                                      new ac2 in {
                                        rl!(afUri, *ac2) |
                                        for (AccountFactory <- ac2) {
                                          AccountFactory!("verify", ownerId, proof, *vCh2) |
                                          for (@vr <- vCh2) {
                                            match vr {
                                              (true, true) => {
                                                for (@s <<- zoneState) {
                                                  match s.get("vaults").get(ownerId) {
                                                    Nil => {
                                                      zoneNow!(*nowCh2) |
                                                      for (@now2 <- nowCh2) {
                                                        for (@s2 <- zoneState) {
                                                          match s2.get("vaults").get(ownerId) {
                                                            Nil => {
                                                              new vaultAuth in {
                                                                zoneState!(s2.set("vaults",
                                                                  s2.get("vaults").set(ownerId, {
                                                                    "auth": *vaultAuth,
                                                                    "collateral": 0,
                                                                    "debt": 0,
                                                                    "lastHeight": now2
                                                                  }))) |
                                                                ret2!((true, *vaultAuth))
                                                              }
                                                            }
                                                            existing => {
                                                              zoneState!(s2) |
                                                              match existing.get("auth") {
                                                                a => { ret2!((true, a)) }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                    existing => {
                                                      match existing.get("auth") {
                                                        a => { ret2!((true, a)) }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                              (true, false) => { ret2!((false, "not owner")) }
                                              _ => { ret2!((false, "verify failed")) }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                              ["vault", ownerId] => {
                                for (@s <<- zoneState) {
                                  match s.get("vaults").get(ownerId) {
                                    Nil => { ret2!((false, "no vault")) }
                                    v => {
                                      new nowCh2, rateCh2, hCh2 in {
                                        zoneNow!(*nowCh2) |
                                        zoneRate!(*rateCh2) |
                                        for (@now2 <- nowCh2; @rr <- rateCh2) {
                                          match rr {
                                            (rate, fresh) => {
                                              zoneHealth!(v.get("collateral"), v.get("debt"),
                                                          rate, params.get("mcrBps"), *hCh2) |
                                              for (@healthy <- hCh2) {
                                                ret2!((true, {
                                                  "ownerId": ownerId,
                                                  "collateral": v.get("collateral"),
                                                  "debt": v.get("debt"),
                                                  "lastHeight": v.get("lastHeight"),
                                                  "health": healthy
                                                }))
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                              ["vaults"] => {
                                for (@s <<- zoneState) {
                                  ret2!((true, s.get("vaults").keys()))
                                }
                              }
                              ["admin", action, arg, nonce, sigs] => {
                                for (@s <<- zoneState) {
                                  new gCh2, vCh2 in {
                                    zoneGovernor!(*gCh2) |
                                    for (Governor <- gCh2) {
                                      Governor!("authorize", "zone:" ++ currency, nonce,
                                                action, arg.toString(), sigs, *vCh2) |
                                      for (@v2 <- vCh2) {
                                        match v2 {
                                          (true, Nil) => {
                                            for (@s2 <- zoneState) {
                                              match action {
                                                "setPaused" => {
                                                  zoneState!(s2.set("paused", arg)
                                                    .set("rev", s2.get("rev") + 1)) |
                                                  ret2!((true, Nil))
                                                }
                                                "setParams" => {
                                                  zoneState!(s2) |
                                                  ret2!((false, "immutable params"))
                                                }
                                                _ => {
                                                  zoneState!(s2) |
                                                  ret2!((false, "unknown admin action"))
                                                }
                                              }
                                            }
                                          }
                                          _ => { ret2!(v2) }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                              _ => { ret2!((false, "unknown arm")) }
                            }
                          } |

                          rs!(bundle+{*CurrencyZone}, *uriCh) |
                          for (@uri <- uriCh) {
                            CurrencyZone!(["attest"], *attCh) |
                            for (@att <- attCh) { ret!((true, uri, att)) }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
          _ => { ret!(check) }
        }
      }
    }
  } |

  rl!(`__ROOT_URI__`, *rootCh) |
  for (Root <- rootCh) {
    rs!(bundle+{*ZoneTemplate}, *uTemplate) |
    for (@uri <- uTemplate) {
      Root!("register", "component:zone-template", uri, 1, "factory", *deployerId, *ack) |
      for (@r <- ack) { deployId!([uri]) }
    }
  }
}
