// v0.4 AccountFactory: one owner -> Account, PurseStore and AccountGate.
// getOrCreate creates the account contracts with the vault proof in closure. The
// proof is never returned or passed through a message; VaultBook.verify compares
// it by name. Every account arm takes the caller's deployerId and checks it in
// AccountGate, so a shared account capability still cannot act for the owner.
// Placeholders: __ROOT_URI__, __ASSET_RESOLVER_URI__.
new
  AccountFactory, factoryState,
  revAddress(`rho:rev:address`),
  deployerIdOps(`rho:rchain:deployerId:ops`),
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, Root, uFactory, ack
in {

  contract AccountFactory(@"getOrCreate", @pubKeyBytes, ret) = {
    new addrCh in {
      revAddress!("fromPublicKey", pubKeyBytes, *addrCh) |
      for (@ownerId <- addrCh) {
        for (@s <<- factoryState) {
          match s.get("accounts").get(ownerId) {
            Nil => {
              for (@s2 <- factoryState) {
                match s2.get("accounts").get(ownerId) {
                  Nil => {
                    new proof, account, PurseStore, purseState, AccountGate in {

                      contract AccountGate(@"verify", dId, ret2) = {
                        new pkCh, aCh in {
                          deployerIdOps!("pubKeyBytes", *dId, *pkCh) |
                          for (@pk <- pkCh) {
                            revAddress!("fromPublicKey", pk, *aCh) |
                            for (@addr <- aCh) {
                              if (addr == ownerId) { ret2!((true, Nil)) }
                              else { ret2!((false, "not owner")) }
                            }
                          }
                        }
                      } |

                      contract PurseStore(@"ensure", @assetId, ret2) = {
                        for (@ps <<- purseState) {
                          match ps.get("purses").get(assetId) {
                            Nil => {
                              new arCh, iCh, pCh in {
                                rl!(`__ASSET_RESOLVER_URI__`, *arCh) |
                                for (AssetResolver <- arCh) {
                                  AssetResolver!("issuer", assetId, *iCh) |
                                  for (@ir <- iCh) {
                                    match ir {
                                      (true, brand, issuer) => {
                                        @issuer!("makeEmptyPurse", *pCh) |
                                        for (@pr <- pCh) {
                                          match pr {
                                            (true, purse) => {
                                              for (@ps2 <- purseState) {
                                                match ps2.get("purses").get(assetId) {
                                                  Nil => {
                                                    purseState!(
                                                      ps2.set("purses",
                                                        ps2.get("purses").set(assetId,
                                                          {"purse": purse, "brand": brand}))
                                                        .set("rev", ps2.get("rev") + 1)) |
                                                    ret2!((true, Nil))
                                                  }
                                                  _ => {
                                                    purseState!(ps2) |
                                                    ret2!((true, Nil))
                                                  }
                                                }
                                              }
                                            }
                                            _ => { ret2!(pr) }
                                          }
                                        }
                                      }
                                      _ => { ret2!(ir) }
                                    }
                                  }
                                }
                              }
                            }
                            _ => { ret2!((true, Nil)) }
                          }
                        }
                      } |

                      contract PurseStore(@"deposit", @assetId, payment, ret2) = {
                        new eCh in {
                          PurseStore!("ensure", assetId, *eCh) |
                          for (@e <- eCh) {
                            match e {
                              (true, Nil) => {
                                for (@ps <<- purseState) {
                                  match ps.get("purses").get(assetId) {
                                    Nil => { ret2!((false, "no purse")) }
                                    entry => {
                                      match entry.get("purse") { p => {
                                        @p!("deposit", *payment, *ret2)
                                      } }
                                    }
                                  }
                                }
                              }
                              _ => { ret2!(e) }
                            }
                          }
                        }
                      } |

                      contract PurseStore(@"withdraw", @assetId, @amount, ret2) = {
                        if (amount <= 0) { ret2!((false, "amount")) }
                        else {
                          new eCh in {
                            PurseStore!("ensure", assetId, *eCh) |
                            for (@e <- eCh) {
                              match e {
                                (true, Nil) => {
                                  for (@ps <<- purseState) {
                                    match ps.get("purses").get(assetId) {
                                      Nil => { ret2!((false, "no purse")) }
                                      entry => {
                                        match entry.get("purse") { p => {
                                          match entry.get("brand") { b => {
                                            @p!("withdraw", (b, amount), *ret2)
                                          } }
                                        } }
                                      }
                                    }
                                  }
                                }
                                _ => { ret2!(e) }
                              }
                            }
                          }
                        }
                      } |

                      contract PurseStore(@"balance", @assetId, ret2) = {
                        new eCh in {
                          PurseStore!("ensure", assetId, *eCh) |
                          for (@e <- eCh) {
                            match e {
                              (true, Nil) => {
                                for (@ps <<- purseState) {
                                  match ps.get("purses").get(assetId) {
                                    Nil => { ret2!((false, "no purse")) }
                                    entry => {
                                      match entry.get("purse") { p => {
                                        @p!("getCurrentAmount", *ret2)
                                      } }
                                    }
                                  }
                                }
                              }
                              _ => { ret2!(e) }
                            }
                          }
                        }
                      } |

                      contract PurseStore(@"facet", @assetId, ret2) = {
                        new eCh in {
                          PurseStore!("ensure", assetId, *eCh) |
                          for (@e <- eCh) {
                            match e {
                              (true, Nil) => {
                                for (@ps <<- purseState) {
                                  match ps.get("purses").get(assetId) {
                                    Nil => { ret2!((false, "no purse")) }
                                    entry => {
                                      match entry.get("purse") { p => {
                                        @p!("getDepositFacet", *ret2)
                                      } }
                                    }
                                  }
                                }
                              }
                              _ => { ret2!(e) }
                            }
                          }
                        }
                      } |

                      purseState!({"purses": {}, "rev": 0}) |

                      contract account(@"vaultOpen", dId, @vaultUri, ret2) = {
                        new vCh in {
                          AccountGate!("verify", *dId, *vCh) |
                          for (@v <- vCh) {
                            match v {
                              (true, Nil) => {
                                new vc in {
                                  rl!(vaultUri, *vc) |
                                  for (VaultBook <- vc) {
                                    VaultBook!("open", ownerId, *proof, *ret2)
                                  }
                                }
                              }
                              _ => { ret2!((false, "not owner")) }
                            }
                          }
                        }
                      } |

                      contract account(@"deposit", dId, @assetId, payment, ret2) = {
                        new vCh in {
                          AccountGate!("verify", *dId, *vCh) |
                          for (@v <- vCh) {
                            match v {
                              (true, Nil) => {
                                PurseStore!("deposit", assetId, *payment, *ret2)
                              }
                              _ => { ret2!((false, "not owner")) }
                            }
                          }
                        }
                      } |

                      contract account(@"withdraw", dId, @assetId, @amount, ret2) = {
                        new vCh in {
                          AccountGate!("verify", *dId, *vCh) |
                          for (@v <- vCh) {
                            match v {
                              (true, Nil) => {
                                PurseStore!("withdraw", assetId, amount, *ret2)
                              }
                              _ => { ret2!((false, "not owner")) }
                            }
                          }
                        }
                      } |

                      contract account(@"balance", dId, @assetId, ret2) = {
                        new vCh in {
                          AccountGate!("verify", *dId, *vCh) |
                          for (@v <- vCh) {
                            match v {
                              (true, Nil) => {
                                PurseStore!("balance", assetId, *ret2)
                              }
                              _ => { ret2!((false, "not owner")) }
                            }
                          }
                        }
                      } |

                      contract account(@"depositFacet", dId, @assetId, ret2) = {
                        new vCh in {
                          AccountGate!("verify", *dId, *vCh) |
                          for (@v <- vCh) {
                            match v {
                              (true, Nil) => {
                                PurseStore!("facet", assetId, *ret2)
                              }
                              _ => { ret2!((false, "not owner")) }
                            }
                          }
                        }
                      } |

                      factoryState!(s2.set("accounts",
                        s2.get("accounts").set(ownerId, {
                          "account": bundle+{*account},
                          "proof": *proof
                        }))) |
                      ret!((true, bundle+{*account}, ownerId))
                    }
                  }
                  entry => {
                    factoryState!(s2) |
                    ret!((true, entry.get("account"), ownerId))
                  }
                }
              }
            }
            entry => {
              ret!((true, entry.get("account"), ownerId))
            }
          }
        }
      }
    }
  } |

  contract AccountFactory(@"verify", @ownerId, proof, ret) = {
    for (@s <<- factoryState) {
      match s.get("accounts").get(ownerId) {
        Nil => { ret!((true, false)) }
        stored => { ret!((true, stored.get("proof") == *proof)) }
      }
    }
  } |

  contract AccountFactory(@"accountOf", @ownerId, ret) = {
    for (@s <<- factoryState) {
      match s.get("accounts").get(ownerId) {
        Nil => { ret!((false, "no account")) }
        entry => { ret!((true, entry.get("account"))) }
      }
    }
  } |

  factoryState!({"accounts": {}}) |

  rl!(`__ROOT_URI__`, *rootCh) |
  for (Root <- rootCh) {
    rs!(bundle+{*AccountFactory}, *uFactory) |
    for (@uri <- uFactory) {
      Root!("register", "component:account-factory", uri, 1, "account", *deployerId, *ack) |
      for (@r <- ack) { deployId!([uri]) }
    }
  }
}
