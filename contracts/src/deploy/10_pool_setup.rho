// Pool setup: create the rNGN/rKES ERTP purses and LP kit, and store them in Components.
// Placeholders: __DIRECTORY_URI__, __COMPONENTS_URI__
new
  rl(`rho:registry:lookup`),
  dirCh,
  compCh,
  ertpCh,
  ngnUriCh,
  kesUriCh,
  ngnCapCh,
  kesCapCh,
  ngnBrandCh,
  ngnIssuerCh,
  kesBrandCh,
  kesIssuerCh,
  ngnPurseCh,
  kesPurseCh,
  lpKitCh,
  lpBurnPurseCh,
  lpBurnFacetCh,
  a1, a2, a3, a4, a5, a6, a7, a8, a9, a10,
  deployId(`rho:rchain:deployId`)
in {
  rl!(`__DIRECTORY_URI__`, *dirCh) |
  rl!(`__COMPONENTS_URI__`, *compCh) |
  rl!(`rho:rchain:ertp`, *ertpCh) |
  for (Directory <- dirCh; Components <- compCh; @(_, ERTP) <- ertpCh) {
    Directory!("get", "component:zone:NGN", *ngnUriCh) |
    Directory!("get", "component:zone:KES", *kesUriCh) |
    for (@(true, ngnUri) <- ngnUriCh; @(true, kesUri) <- kesUriCh) {
      rl!(ngnUri, *ngnCapCh) |
      rl!(kesUri, *kesCapCh) |
      for (ngnZone <- ngnCapCh; kesZone <- kesCapCh) {
        ngnZone!("brand", *ngnBrandCh) |
        ngnZone!("issuer", *ngnIssuerCh) |
        kesZone!("brand", *kesBrandCh) |
        kesZone!("issuer", *kesIssuerCh) |
        for (@(true, ngnBrand) <- ngnBrandCh; @(true, ngnIssuer) <- ngnIssuerCh;
             @(true, kesBrand) <- kesBrandCh; @(true, kesIssuer) <- kesIssuerCh) {
          @ngnIssuer!("makeEmptyPurse", *ngnPurseCh) |
          @kesIssuer!("makeEmptyPurse", *kesPurseCh) |
          @ERTP!("makeIssuerKit", *lpKitCh) |
          for (@(true, ngnPurse) <- ngnPurseCh; @(true, kesPurse) <- kesPurseCh;
               @(lpBrand, lpMint, lpIssuer) <- lpKitCh) {
            @lpIssuer!("makeEmptyPurse", *lpBurnPurseCh) |
            for (@(true, lpBurnPurse) <- lpBurnPurseCh) {
              @lpBurnPurse!("getDepositFacet", *lpBurnFacetCh) |
              for (@(true, lpBurnFacet) <- lpBurnFacetCh) {
                Components!("setValue", "pool:NGN/KES:baseBrand", ngnBrand, *a1) |
                Components!("setValue", "pool:NGN/KES:baseIssuer", ngnIssuer, *a2) |
                Components!("setValue", "pool:NGN/KES:basePurse", ngnPurse, *a3) |
                Components!("setValue", "pool:NGN/KES:quoteBrand", kesBrand, *a4) |
                Components!("setValue", "pool:NGN/KES:quoteIssuer", kesIssuer, *a5) |
                Components!("setValue", "pool:NGN/KES:quotePurse", kesPurse, *a6) |
                Components!("setValue", "pool:NGN/KES:lpBrand", lpBrand, *a7) |
                Components!("setValue", "pool:NGN/KES:lpMint", lpMint, *a8) |
                Components!("setValue", "pool:NGN/KES:lpIssuer", lpIssuer, *a9) |
                Components!("setValue", "pool:NGN/KES:lpBurnFacet", lpBurnFacet, *a10) |
                for (@_ <- a1; @_ <- a2; @_ <- a3; @_ <- a4; @_ <- a5;
                     @_ <- a6; @_ <- a7; @_ <- a8; @_ <- a9; @_ <- a10) {
                  deployId!("pool-setup")
                }
              }
            }
          }
        }
      }
    }
  }
}
