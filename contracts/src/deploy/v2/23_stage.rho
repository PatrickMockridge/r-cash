// v0.2 install step 7d: stage the market now that pool, lock and book are registered.
new
  rl(`rho:registry:lookup`),
  regCh,
  compCh,
  poolCh, bookCh, lockCh,
  stageCh,
  deployId(`rho:rchain:deployId`)
in {
  rl!(`__COMPONENTS_URI__`, *compCh) |
  for (Components <- compCh) {
    Components!("get", "component:listings", *regCh) |
    for (@(true, ListingRegistry) <- regCh) {
      @ListingRegistry!("marketCap", "__MARKET_ID__", "pool", *poolCh) |
      @ListingRegistry!("marketCap", "__MARKET_ID__", "book", *bookCh) |
      @ListingRegistry!("marketCap", "__MARKET_ID__", "lock", *lockCh) |
      for (@(true, pool) <- poolCh; @(true, book) <- bookCh; @(true, lock) <- lockCh) {
        @ListingRegistry!("stageMarket", "__MARKET_ID__", __VERSION__, "__STAGE_NONCE__",
                         "__BASE__", "__QUOTE__", pool, book, lock,
                         __TERMS_MAP__, __TERMS_VALUES__, "__TERMS_HASH__",
                         "__SPONSOR_SIG__".hexToBytes(), *stageCh) |
        for (@r <- stageCh) { deployId!(r) }
      }
    }
  }
}
