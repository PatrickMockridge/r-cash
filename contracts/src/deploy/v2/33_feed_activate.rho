// v0.2 listing call: activate a feed after its trial.
// Placeholders: __ORACLE_URI__, __CODE__.
new
  rl(`rho:registry:lookup`),
  oracleCh,
  ret,
  deployId(`rho:rchain:deployId`)
in {
  rl!(`__ORACLE_URI__`, *oracleCh) |
  for (OracleHub <- oracleCh) {
    OracleHub!("activateFeed", "__CODE__", *ret) |
    for (@r <- ret) { deployId!(r) }
  }
}
