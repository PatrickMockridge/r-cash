// v0.2 install step 4: AccountFactory with the registry-aware Account body.
// Placeholders: __DIRECTORY_URI__, __COMPONENTS_URI__.
// The ListingRegistry capability is read from ComponentRegistry at install time.
new
  AccountFactory,
  factoryState,
  Directory,
  Components,
  ListingRegistry,
  dirCh,
  compCh,
  regCh,
  rl(`rho:registry:lookup`),
  revAddress(`rho:rev:address`),
  deployerIdOps(`rho:rchain:deployerId:ops`),
  uriCh,
  rs(`rho:registry:insertArbitrary`),
  deployId(`rho:rchain:deployId`)
in {
  rl!(`__DIRECTORY_URI__`, *dirCh) |
  rl!(`__COMPONENTS_URI__`, *compCh) |
  for (Directory <- dirCh; Components <- compCh) {
    Components!("get", "component:listings", *regCh) |
    for (@(true, ListingRegistry) <- regCh) {
      factoryState!({}) |

      // @@INLINE:core/AccountFactoryV2.rho@@

      rs!(bundle+{*AccountFactory}, *uriCh) |
      for (@uri <- uriCh) { deployId!(uri) }
    }
  }
}
