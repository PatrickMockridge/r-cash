// v0.2 install step 2: OracleHubV2 with the global reporter allowlist.
// Placeholders: __REPORTER_KEYS__, __ADMIN_KEYS__, __ORACLE_PARAMS__.
// Returns the oracle URI on deployId.
new
  OracleHubV2,
  oracleState,
  bd(`rho:block:data`),
  hash(`rho:crypto:blake2b256Hash`),
  verify(`rho:crypto:secp256k1Verify`),
  uriCh,
  rs(`rho:registry:insertArbitrary`),
  deployId(`rho:rchain:deployId`),
  termsJoin,
  termsCanonical,
  termsHash,
  guardArgsToString,
  guardArgsAppend,
  guardAnySig,
  guardCount,
  verifyAdmin,
  oracleNowV2,
  oracleB2IV2,
  oracleInList,
  oracleListRemove,
  oracleMedian3V2,
  oracleMax3V2,
  oracleMin3V2,
  oracleIsFreshV2,
  oracleDecideV2,
  oracleMarkSeen,
  oracleCountSeen,
  oraclePolicyHashV2,
  oracleFeedPayload,
  oracleValuePair,
  oracleFeedStore,
  oracleFeedRead,
  oracleFeedActivateCheck,
  oracleFeed,
  oracleFeedEntry,
  oracleEntryParts,
  oraclePairReplyV2,
  oracleAddReporter,
  oracleRemoveReporter,
  oraclePauseFeedAdmin,
  oracleRestartTrialAdmin,
  oracleAdminApplyV2
in {
  // @@INLINE:lib/Guard.rho@@
  // @@INLINE:lib/Terms.rho@@
  // @@INLINE:oracle/OracleHubV2.rho@@

  oracleState!({
    "allowlist": __REPORTER_KEYS__,
    "keyUse": {},
    "feeds": {},
    "prices": {},
    "params": __ORACLE_PARAMS__,
    "admins": __ADMIN_KEYS__,
    "threshold": 2,
    "govNonce": 0
  }) |

  rs!(bundle+{*OracleHubV2}, *uriCh) |
  for (@uri <- uriCh) { deployId!(uri) }
}
