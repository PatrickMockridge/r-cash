// v0.2 install step 3: ListingRegistry.
// Placeholders: __ORACLE_URI__, __COMPONENTS_URI__, __ADMIN_KEYS__.
// The registry is stored as a live capability in the ComponentRegistry. The contract
// definitions stay at the top level of the deploy scope; only the registration call
// runs inside the lookup receive.
new
  ListingRegistry,
  listingState,
  rl(`rho:registry:lookup`),
  compCh,
  revAddress(`rho:rev:address`),
  bd(`rho:block:data`),
  hash(`rho:crypto:blake2b256Hash`),
  verify(`rho:crypto:secp256k1Verify`),
  ack,
  deployId(`rho:rchain:deployId`),
  termsJoin,
  termsCanonical,
  termsHash,
  guardArgsToString,
  guardArgsAppend,
  guardAnySig,
  guardCount,
  verifyAdmin,
  listingNow,
  listingOraclePair,
  listingOracleStatus,
  listingCurrencyLookup,
  listingPinnedOk,
  listingRegisterCurrency,
  listingPairKey,
  listingZoneOk,
  listingZoneParamsHash,
  listingCurrencyPayload,
  listingSponsorPayload,
  listingMarketView,
  listingStage,
  listingStoreDraft,
  listingActivate,
  listingAdminApply
in {
  // @@INLINE:lib/Guard.rho@@
  // @@INLINE:lib/Terms.rho@@
  // @@INLINE:listing/ListingRegistry.rho@@

  listingState!({
    "oracleUri": "__ORACLE_URI__",
    "pinned": __PINNED_CURRENCIES__,
    "currencies": {},
    "assets": {"REV": {"kind": "rev", "controller": {"type": "rev"}, "decimals": 8}},
    "markets": {},
    "marketViews": {},
    "marketCaps": {},
    "byPair": {},
    "byPairVersion": {},
    "bounds": {},
    "admins": __ADMIN_KEYS__,
    "threshold": 2,
    "govNonce": 0
  }) |

  rl!(`__COMPONENTS_URI__`, *compCh) |
  for (Components <- compCh) {
    Components!("set", "component:listings", *ListingRegistry, *ack) |
    for (@r <- ack) { deployId!(r) }
  }
}
