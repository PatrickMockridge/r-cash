// v0.2 install step 7b: create the generic TransferBook for one market and publish it.
// It resolves the pool capability by URI and creates its own escrow purses.
new
  rl(`rho:registry:lookup`),
  regCh,
  compCh,
  poolCh,
  accountsCh,
  baseZoneCh,
  quoteZoneCh,
  baseBrandCh, baseIssuerCh, quoteBrandCh, quoteIssuerCh,
  escrowBaseCh, escrowQuoteCh,
  bookV2, bookState, bookNowV2, bookRecordV2, bookSetStatusV2, bookTransferV2,
  bookEscrowDepositV2, bookEscrowWithdrawV2, bookAdminApplyV2,
  capOutCh,
  bd(`rho:block:data`),
  hash(`rho:crypto:blake2b256Hash`),
  verify(`rho:crypto:secp256k1Verify`),
  termsJoin, termsCanonical, termsHash,
  guardArgsToString, guardArgsAppend, guardAnySig, guardCount, verifyAdmin,
  baseCh, quoteCh, marketIdCh,
  deployId(`rho:rchain:deployId`)
in {
  baseCh!("__BASE__") |
  quoteCh!("__QUOTE__") |
  marketIdCh!("__MARKET_ID__") |
  for (@base <- baseCh; @quote <- quoteCh; @marketId <- marketIdCh) {
    rl!(`__COMPONENTS_URI__`, *compCh) |
    rl!(`__ACCOUNTS_URI__`, *accountsCh) |
    rl!(`__BASE_ZONE_URI__`, *baseZoneCh) |
    rl!(`__QUOTE_ZONE_URI__`, *quoteZoneCh) |
    for (Components <- compCh; AccountFactory <- accountsCh;
         baseZone <- baseZoneCh; quoteZone <- quoteZoneCh) {
      Components!("get", "component:listings", *regCh) |
      for (@(true, ListingRegistry) <- regCh) {
        @ListingRegistry!("marketCap", marketId, "pool", *poolCh) |
        baseZone!("brand", *baseBrandCh) | baseZone!("issuer", *baseIssuerCh) |
        quoteZone!("brand", *quoteBrandCh) | quoteZone!("issuer", *quoteIssuerCh) |
        for (@(true, pool) <- poolCh;
             @(true, baseBrand) <- baseBrandCh; @(true, baseIssuer) <- baseIssuerCh;
             @(true, quoteBrand) <- quoteBrandCh; @(true, quoteIssuer) <- quoteIssuerCh) {
        @baseIssuer!("makeEmptyPurse", *escrowBaseCh) |
        @quoteIssuer!("makeEmptyPurse", *escrowQuoteCh) |
        for (@(true, escrowBase) <- escrowBaseCh; @(true, escrowQuote) <- escrowQuoteCh) {
          bookState!({
            "marketId": marketId,
            "base": base,
            "quote": quote,
            "termsHash": "__TERMS_HASH__".hexToBytes(),
            "paramsHash": "00".hexToBytes(),
            "params": __BOOK_PARAMS__,
            "active": true,
            "paused": false,
            "transfers": {},
            "nextId": 0,
            "admins": __ADMIN_KEYS__,
            "threshold": 2,
            "govNonce": 0
          }) |

          // @@INLINE:lib/Guard.rho@@
          // @@INLINE:lib/Terms.rho@@
          // @@INLINE:transfer/TransferBookV2.rho@@

          @ListingRegistry!("registerMarketCap", marketId, "book", *bookV2, *capOutCh) |
          for (@capOut <- capOutCh) { deployId!(capOut) }
        }
        }
      }
    }
  }
}
