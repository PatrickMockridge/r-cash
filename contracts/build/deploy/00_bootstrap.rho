// Phase-3 bootstrap: Directory + AccountFactory + OracleHub + rNGN/rKES CurrencyZones.
// Seeds the REV/NGN/KES assets and the component names, locks the Directory, publishes its URI,
// and returns (directory, accounts, oracle, zoneNGN, zoneKES) URIs on deployId.
//
// Placeholders substituted by harness/bootstrap.py:
//   __REPORTER_KEYS__  -> [ "hex".hexToBytes(), ... ] (three reporter public keys)
//   __ADMIN_KEYS__     -> [ "hex".hexToBytes(), ... ] (three admin public keys)
//   __ZONE_PARAMS__    -> [mcrBps, bonusBps, closeFactorBps, ratePerBlock, ceiling, minDebt, maxDebt]
//
// This is one atomic deploy. Directory registration is only open while `locked` is false, and
// the lock happens in the same term.
new
  Directory,
  AccountFactory,
  OracleHub,
  Components,
  state,
  componentsState,
  factoryState,
  oracleState,
  uriDirCh,
  uriFactoryCh,
  uriOracleCh,
  uriComponentsCh,
  zNgnCh,
  zKesCh,
  seedCh,
  rs(`rho:registry:insertArbitrary`),
  revAddress(`rho:rev:address`),
  deployerIdOps(`rho:rchain:deployerId:ops`),
  bd(`rho:block:data`),
  hash(`rho:crypto:blake2b256Hash`),
  verify(`rho:crypto:secp256k1Verify`),
  guardArgsToString,
  guardArgsAppend,
  guardAnySig,
  guardCount,
  verifyAdmin,
  oracleNow,
  oracleEntry,
  oracleValue,
  oracleMedian3,
  oracleMax3,
  oracleMin3,
  oracleIsFresh,
  oracleB2I,
  oracleDecide,
  oracleStore,
  oracleAdminApply,
  oraclePairReply,
  createCurrencyZone,
  directorySeed,
  deployId(`rho:rchain:deployId`)
in {
  state!({
    "names": {},
    "assets": {},
    "locked": false,
    "admins": [],
    "threshold": 2,
    "govNonce": 0
  }) |
// ---- begin core/Directory.inc ----
// Directory: names -> component URIs, assetId -> {kind, controllerKey, decimals}.
// State is seeded by the bootstrap term (which holds the private `state` channel):
//   {names: Map, assets: Map, locked: Bool, admins: List, threshold: Int, govNonce: Int}
// Bootstrap registration is only possible while locked == false; the bootstrap deploy registers
// and locks in one atomic term. Admin-signed registration after the lock is phase 2.
// Rholang note: method calls are not chained here; each `.get`/`.set` is a single call bound by
// a match, which the parser accepts unambiguously.

contract Directory(@"get", @name, ret) = {
  for (@s <<- state) {
    match s.get("names") {
      Nil => ret!((false, "unknown"))
      names => {
        match names.get(name) {
          Nil => ret!((false, "unknown"))
          uri => ret!((true, uri))
        }
      }
    }
  }
} |

contract Directory(@"asset", @assetId, ret) = {
  for (@s <<- state) {
    match s.get("assets") {
      Nil => ret!((false, "unknown asset"))
      assets => {
        match assets.get(assetId) {
          Nil => ret!((false, "unknown asset"))
          meta => ret!((true, meta))
        }
      }
    }
  }
} |

contract Directory(@"register", @name, @uri, ret) = {
  for (@s <- state) {
    if (s.get("locked")) {
      state!(s) |
      ret!((false, "locked"))
    } else {
      match s.get("names") {
        Nil => { state!(s) | ret!((false, "no names map")) }
        names => {
          state!(s.set("names", names.set(name, uri))) |
          ret!((true, Nil))
        }
      }
    }
  }
} |

contract Directory(@"registerAsset", @assetId, @kind, @controller, @decimals, ret) = {
  for (@s <- state) {
    if (s.get("locked")) {
      state!(s) |
      ret!((false, "locked"))
    } else {
      match s.get("assets") {
        Nil => { state!(s) | ret!((false, "no assets map")) }
        assets => {
          state!(s.set("assets", assets.set(
            assetId,
            {"kind": kind, "controllerKey": controller, "decimals": decimals}
          ))) |
          ret!((true, Nil))
        }
      }
    }
  }
} |

contract Directory(@"lock", ret) = {
  for (@s <- state) {
    state!(s.set("locked", true)) |
    ret!((true, Nil))
  }
} |

contract Directory(@"names", ret) = {
  for (@s <<- state) {
    match s.get("names") {
      Nil => ret!((true, {}))
      names => ret!((true, names))
    }
  }
} |

contract Directory(@"admin", @nonce, @action, @args, @sigs, ret) = {
  ret!((false, "admin actions are phase 2"))
} |
// ---- end core/Directory.inc ----
  componentsState!({"locked": false}) |
// ---- begin core/ComponentRegistry.inc ----
// ComponentRegistry: name -> live contract channel. A large contract cannot always be wrapped in
// a bundle on this node (the bundle free-variable check rejects some nested captures), so the
// bootstrap holds the live name here instead of installing a bundle. The registry is a simple
// contract and bundles cleanly.
//
// State is seeded by the bootstrap: componentsState!({}).

contract Components(@"set", @key, cap, ret) = {
  for (@s <- componentsState) {
    if (s.get("locked")) {
      componentsState!(s) |
      ret!((false, "locked"))
    } else {
      componentsState!(s.set(key, *cap)) |
      ret!((true, Nil))
    }
  }
} |


contract Components(@"setValue", @key, @value, ret) = {
  for (@s <- componentsState) {
    if (s.get("locked")) {
      componentsState!(s) |
      ret!((false, "locked"))
    } else {
      componentsState!(s.set(key, value)) |
      ret!((true, Nil))
    }
  }
} |

contract Components(@"lock", ret) = {
  for (@s <- componentsState) {
    componentsState!(s.set("locked", true)) |
    ret!((true, Nil))
  }
} |

contract Components(@"get", @key, ret) = {
  for (@s <<- componentsState) {
    match s.get(key) {
      Nil => ret!((false, "unknown component"))
      cap => ret!((true, cap))
    }
  }
} |

contract Components(@"has", @key, ret) = {
  for (@s <<- componentsState) {
    match s.get(key) {
      Nil => ret!((true, false))
      cap => ret!((true, true))
    }
  }
} |
// ---- end core/ComponentRegistry.inc ----
  factoryState!({}) |
// ---- begin core/AccountFactory.inc ----
// AccountFactory: ownerId -> {account: bundle, proof: unforgeable}.
// Captured: factoryState, revAddress, Directory, deployerIdOps.
// The proof is passed only into the Account at creation and is never returned by getOrCreate.

contract AccountFactory(@"getOrCreate", @pubKeyBytes, ret) = {
  new addrCh in {
    revAddress!("fromPublicKey", pubKeyBytes, *addrCh) |
    for (@ownerId <- addrCh) {
      for (@accounts <- factoryState) {
        match accounts.get(ownerId) {
          Nil => {
            new account, accountInternalPurse, accountLookupPurse, accountZone, accountVaultAuth, accountEnsurePurse, accountTransferBook, proof, purseState, vaultState in {
              purseState!({}) |
              vaultState!({}) |
// ---- begin core/AccountBody.inc ----
// AccountBody: the per-key non-custodial Account. Inlined inside AccountFactory's
// `new account, accountInternalPurse, accountLookupPurse, proof, purseState, vaultState in { ... }`.
//
// Captured names: pubKeyBytes, ownerId, proof, purseState, vaultState, Directory, deployerIdOps.
// Authority: every owner op presents the deploy's own *deployerId; this body makes one read-only
// `pubKeyBytes` call and compares it with the owner key. It never stores, emits or spends with it.
//
// Concurrency rule: never hold a consumed state cell across an external await. Reads use `<<-`
// peeks; the only state mutations happen after the purse/zone call has returned.

// Lazily create a purse for an asset and return it on ret. Does not touch state.
// Phase 1 implements the REV kind; stable/LP controllers arrive with their contracts.
contract accountInternalPurse(@assetId, @meta, ret) = {
  if (meta.get("kind") == "rev") {
    new rl(`rho:registry:lookup`), ertpCh, issuerCh, purseCh in {
      rl!(`rho:rchain:ertp`, *ertpCh) |
      for (@(_, ERTP) <- ertpCh) {
        @ERTP!("getRevIssuer", *issuerCh) |
        for (@(revBrand, issuer) <- issuerCh) {
          @issuer!("makeEmptyPurse", *purseCh) |
          for (@(true, purse) <- purseCh) {
            ret!((true, purse, revBrand))
          }
        }
      }
    }
  } else {
    if (meta.get("kind") == "stable") {
      new uriCh, rl(`rho:registry:lookup`), capCh, issuerCh, brandCh, purseCh in {
        Directory!("get", meta.get("controllerKey"), *uriCh) |
        for (@u <- uriCh) {
          match u {
            (true, uri) => {
              rl!(uri, *capCh) |
              for (zone <- capCh) {
                zone!("issuer", *issuerCh) |
                zone!("brand", *brandCh) |
                for (@(true, issuer) <- issuerCh; @(true, brand) <- brandCh) {
                  @issuer!("makeEmptyPurse", *purseCh) |
                  for (@(true, purse) <- purseCh) { ret!((true, purse, brand)) }
                }
              }
            }
            _ => ret!((false, "no controller"))
          }
        }
      }
    } else {
      if (meta.get("kind") == "lp") {
        new uriCh, rl(`rho:registry:lookup`), capCh, assetCh, poolCh, purseCh in {
          Directory!("get", "component:pools", *uriCh) |
          for (@u <- uriCh) {
            match u {
              (true, uri) => {
                rl!(uri, *capCh) |
                for (components <- capCh) {
                  components!("get", meta.get("controllerKey"), *poolCh) |
                  for (@(true, pool) <- poolCh) {
                    @pool!("lpAsset", *assetCh) |
                    for (@(true, lpBrand, lpIssuer) <- assetCh) {
                      @lpIssuer!("makeEmptyPurse", *purseCh) |
                      for (@(true, purse) <- purseCh) { ret!((true, purse, lpBrand)) }
                    }
                  }
                }
              }
              _ => ret!((false, "no controller"))
            }
          }
        }
      } else {
        ret!((false, "unsupported asset kind"))
      }
    }
  }
} |

// Return the stored purse for an asset, or Nil. Peek only.
contract accountLookupPurse(@assetId, ret) = {
  for (@purses <<- purseState) {
    match purses.get(assetId) {
      Nil => ret!(Nil)
      entry => {
        match entry.get("purse") {
          p => {
            match entry.get("brand") {
              brand => ret!((p, brand))
            }
          }
        }
      }
    }
  }
} |

contract accountZone(@currency, ret) = {
  new uriCh in {
    Directory!("get", "component:zone:" ++ currency, *uriCh) |
    for (@r <- uriCh) {
      match r {
        (true, uri) => {
          new rl(`rho:registry:lookup`), capCh in {
            rl!(uri, *capCh) |
            for (zone <- capCh) { ret!((true, *zone)) }
          }
        }
        _ => ret!((false, "no zone"))
      }
    }
  }
} |

contract accountVaultAuth(@currency, ret) = {
  for (@vs <<- vaultState) {
    match vs.get(currency) {
      Nil => ret!(Nil)
      auth => ret!(auth)
    }
  }
} |

// Ensure this Account has a purse for an asset, creating it if absent. The state mutation
// happens only after the purse exists.
contract accountEnsurePurse(@assetId, ret) = {
  new lookupCh, infoCh in {
    accountLookupPurse!(assetId, *lookupCh) |
    Directory!("asset", assetId, *infoCh) |
    for (@found <- lookupCh; @info <- infoCh) {
      match found {
        Nil => {
          match info {
            (true, meta) => {
              new createdCh in {
                accountInternalPurse!(assetId, meta, *createdCh) |
                for (@created <- createdCh) {
                  match created {
                    (true, purse, brand) => {
                      for (@ps <- purseState) {
                        match ps.get(assetId) {
                          Nil => {
                            purseState!(ps.set(assetId, {"purse": purse, "brand": brand})) |
                            ret!((true, purse, brand))
                          }
                          entry => {
                            purseState!(ps) |
                            match entry.get("purse") {
                              p => {
                                match entry.get("brand") {
                                  b => ret!((true, p, b))
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                    _ => ret!(created)
                  }
                }
              }
            }
            _ => ret!((false, "unknown asset"))
          }
        }
        (p, brand) => ret!((true, p, brand))
      }
    }
  }
} |

contract account(@"deposit", @assetId, payment, ret) = {
  new infoCh, lookupCh in {
    Directory!("asset", assetId, *infoCh) |
    accountLookupPurse!(assetId, *lookupCh) |
    for (@info <- infoCh; @found <- lookupCh) {
      match info {
        (true, meta) => {
          match found {
            Nil => {
              new newPurseCh in {
                accountInternalPurse!(assetId, meta, *newPurseCh) |
                for (@created <- newPurseCh) {
                  match created {
                    (true, purse, brand) => {
                      for (@purses <- purseState) {
                        match purses.get(assetId) {
                          Nil => {
                            purseState!(purses.set(assetId, {"purse": purse, "brand": brand})) |
                            @purse!("deposit", *payment, *ret)
                          }
                          entry => {
                            purseState!(purses) |
                            match entry.get("purse") {
                              p => @p!("deposit", *payment, *ret)
                            }
                          }
                        }
                      }
                    }
                    _ => ret!(created)
                  }
                }
              }
            }
            (p, brand) => {
              @p!("deposit", *payment, *ret)
            }
          }
        }
        _ => ret!((false, "unknown asset"))
      }
    }
  }
} |

contract account(@"withdraw", deployerId, @assetId, @amount, ret) = {
  new pkCh in {
    deployerIdOps!("pubKeyBytes", *deployerId, *pkCh) |
    for (@pk <- pkCh) {
      if (pk == pubKeyBytes) {
        new lookupCh in {
          accountLookupPurse!(assetId, *lookupCh) |
          for (@found <- lookupCh) {
            match found {
              Nil => ret!((false, "no purse"))
              (p, brand) => @p!("withdraw", (brand, amount), *ret)
            }
          }
        }
      } else {
        ret!((false, "not owner"))
      }
    }
  }
} |

contract account(@"balance", deployerId, @assetId, ret) = {
  new pkCh in {
    deployerIdOps!("pubKeyBytes", *deployerId, *pkCh) |
    for (@pk <- pkCh) {
      if (pk == pubKeyBytes) {
        new lookupCh in {
          accountLookupPurse!(assetId, *lookupCh) |
          for (@found <- lookupCh) {
            match found {
              Nil => ret!((false, "no purse"))
              (p, brand) => @p!("getCurrentAmount", *ret)
            }
          }
        }
      } else {
        ret!((false, "not owner"))
      }
    }
  }
} |

contract account(@"depositFacet", @assetId, ret) = {
  new infoCh, lookupCh in {
    Directory!("asset", assetId, *infoCh) |
    accountLookupPurse!(assetId, *lookupCh) |
    for (@info <- infoCh; @found <- lookupCh) {
      match info {
        (true, meta) => {
          match found {
            Nil => {
              new newPurseCh in {
                accountInternalPurse!(assetId, meta, *newPurseCh) |
                for (@created <- newPurseCh) {
                  match created {
                    (true, purse, brand) => {
                      for (@purses <- purseState) {
                        match purses.get(assetId) {
                          Nil => {
                            purseState!(purses.set(assetId, {"purse": purse, "brand": brand})) |
                            @purse!("getDepositFacet", *ret)
                          }
                          entry => {
                            purseState!(purses) |
                            match entry.get("purse") {
                              p => @p!("getDepositFacet", *ret)
                            }
                          }
                        }
                      }
                    }
                    _ => ret!(created)
                  }
                }
              }
            }
            (p, brand) => @p!("getDepositFacet", *ret)
          }
        }
        _ => ret!((false, "unknown asset"))
      }
    }
  }
} |


// ---- Transfer product ops ----------------------------------------------------------------
contract accountTransferBook(ret) = {
  new uriCh, rl(`rho:registry:lookup`), capCh, bookCh in {
    Directory!("get", "component:pools", *uriCh) |
    for (@u <- uriCh) {
      match u {
        (true, uri) => {
          rl!(uri, *capCh) |
          for (components <- capCh) {
            components!("get", "transfer:NGN/KES", *bookCh) |
            for (@(true, book) <- bookCh) { ret!((true, book)) }
          }
        }
        _ => ret!((false, "no book"))
      }
    }
  }
} |

contract account(@"sendTransfer", deployerId, @sourceAsset, @destAsset, @sourceAmount,
                @minDest, @claimHash, @expiry, ret) = {
  new pkCh in {
    deployerIdOps!("pubKeyBytes", *deployerId, *pkCh) |
    for (@pk <- pkCh) {
      if (pk == pubKeyBytes) {
        new purseCh in {
          accountEnsurePurse!(sourceAsset, *purseCh) |
          for (@pc <- purseCh) {
            match pc {
              (true, purse, brand) => {
                new wdCh in {
                  @purse!("withdraw", (brand, sourceAmount), *wdCh) |
                  for (@wp <- wdCh) {
                    match wp {
                      (true, payment) => {
                        new bookCh in {
                          accountTransferBook!(*bookCh) |
                          for (@b <- bookCh) {
                            match b {
                              (true, book) => {
                                @book!("send", sourceAsset, destAsset, payment, minDest,
                                       claimHash, expiry, ownerId, *proof, *ret)
                              }
                              _ => ret!((false, "no book"))
                            }
                          }
                        }
                      }
                      _ => ret!(wp)
                    }
                  }
                }
              }
              _ => ret!(pc)
            }
          }
        }
      } else { ret!((false, "not owner")) }
    }
  }
} |

contract account(@"claimTransfer", @transferId, @destAsset, @secret, ret) = {
  new purseCh in {
    accountEnsurePurse!(destAsset, *purseCh) |
    for (@pc <- purseCh) {
      match pc {
        (true, purse, brand) => {
          new bookCh in {
            accountTransferBook!(*bookCh) |
            for (@b <- bookCh) {
              match b {
                (true, book) => {
                  new cCh in {
                    @book!("claim", transferId, secret, *cCh) |
                    for (@c <- cCh) {
                      match c {
                        (true, amount, payment) => {
                          new claimDepCh in {
                            @purse!("deposit", payment, *claimDepCh) |
                            for (@d <- claimDepCh) { ret!((true, amount)) }
                          }
                        }
                        _ => ret!(c)
                      }
                    }
                  }
                }
                _ => ret!((false, "no book"))
              }
            }
          }
        }
        _ => ret!(pc)
      }
    }
  }
} |

contract account(@"refundTransfer", deployerId, @transferId, @destAsset, ret) = {
  new pkCh in {
    deployerIdOps!("pubKeyBytes", *deployerId, *pkCh) |
    for (@pk <- pkCh) {
      if (pk == pubKeyBytes) {
        new purseCh in {
          accountEnsurePurse!(destAsset, *purseCh) |
          for (@pc <- purseCh) {
            match pc {
              (true, purse, brand) => {
                new bookCh in {
                  accountTransferBook!(*bookCh) |
                  for (@b <- bookCh) {
                    match b {
                      (true, book) => {
                        new cCh in {
                          @book!("refund", transferId, ownerId, *proof, *cCh) |
                          for (@c <- cCh) {
                            match c {
                              (true, amount, payment) => {
                                new refundDepCh in {
                                  @purse!("deposit", payment, *refundDepCh) |
                                  for (@d <- refundDepCh) { ret!((true, amount)) }
                                }
                              }
                              _ => ret!(c)
                            }
                          }
                        }
                      }
                      _ => ret!((false, "no book"))
                    }
                  }
                }
              }
              _ => ret!(pc)
            }
          }
        }
      } else { ret!((false, "not owner")) }
    }
  }
} |

// ---- Vault operations (phase 3) ---------------------------------------------------------
// Every owner op authenticates the deploy's own *deployerId against pubKeyBytes, then uses the
// vaultAuth stored by openVault. The zone never sees the deployerId.

contract account(@"openVault", deployerId, @currency, ret) = {
  new pkCh in {
    deployerIdOps!("pubKeyBytes", *deployerId, *pkCh) |
    for (@pk <- pkCh) {
      if (pk == pubKeyBytes) {
        new zoneCh in {
          accountZone!(currency, *zoneCh) |
          for (@z <- zoneCh) {
            match z {
              (true, zone) => {
                new vCh in {
                  @zone!("open", ownerId, *proof, *vCh) |
                  for (@r <- vCh) {
                    match r {
                      (true, auth) => {
                        for (@vs <- vaultState) {
                          vaultState!(vs.set(currency, auth)) |
                          ret!((true, ownerId))
                        }
                      }
                      _ => ret!(r)
                    }
                  }
                }
              }
              _ => ret!((false, "no zone"))
            }
          }
        }
      } else { ret!((false, "not owner")) }
    }
  }
} |

contract account(@"depositCollateral", deployerId, @currency, @amount, ret) = {
  new pkCh in {
    deployerIdOps!("pubKeyBytes", *deployerId, *pkCh) |
    for (@pk <- pkCh) {
      if (pk == pubKeyBytes) {
        new authCh in {
          accountVaultAuth!(currency, *authCh) |
          for (@a <- authCh) {
            match a {
              Nil => ret!((false, "open a vault first"))
              auth => {
                new purseCh in {
                  accountEnsurePurse!("REV", *purseCh) |
                  for (@pc <- purseCh) {
                    match pc {
                      (true, purse, revBrand) => {
                        new payCh in {
                          @purse!("withdraw", (revBrand, amount), *payCh) |
                          for (@wp <- payCh) {
                            match wp {
                              (true, payment) => {
                                new zoneCh in {
                                  accountZone!(currency, *zoneCh) |
                                  for (@z <- zoneCh) {
                                    match z {
                                      (true, zone) => {
                                        @zone!("depositCollateral", ownerId, auth, payment, *ret)
                                      }
                                      _ => ret!((false, "no zone"))
                                    }
                                  }
                                }
                              }
                              _ => ret!(wp)
                            }
                          }
                        }
                      }
                      _ => ret!(pc)
                    }
                  }
                }
              }
            }
          }
        }
      } else { ret!((false, "not owner")) }
    }
  }
} |

contract account(@"withdrawCollateral", deployerId, @currency, @amount, ret) = {
  new pkCh in {
    deployerIdOps!("pubKeyBytes", *deployerId, *pkCh) |
    for (@pk <- pkCh) {
      if (pk == pubKeyBytes) {
        new authCh in {
          accountVaultAuth!(currency, *authCh) |
          for (@a <- authCh) {
            match a {
              Nil => ret!((false, "open a vault first"))
              auth => {
                new zoneCh in {
                  accountZone!(currency, *zoneCh) |
                  for (@z <- zoneCh) {
                    match z {
                      (true, zone) => {
                        new payCh in {
                          @zone!("withdrawCollateral", ownerId, auth, amount, *payCh) |
                          for (@wp <- payCh) {
                            match wp {
                              (true, payment) => {
                                new purseCh in {
                                  accountEnsurePurse!("REV", *purseCh) |
                                  for (@pc <- purseCh) {
                                    match pc {
                                      (true, purse, revBrand) => {
                                        new depCh in {
                                        @purse!("deposit", payment, *depCh) |
                                        for (@d <- depCh) { ret!((true, amount)) }
                                        }
                                      }
                                      _ => ret!(pc)
                                    }
                                  }
                                }
                              }
                              _ => ret!(wp)
                            }
                          }
                        }
                      }
                      _ => ret!((false, "no zone"))
                    }
                  }
                }
              }
            }
          }
        }
      } else { ret!((false, "not owner")) }
    }
  }
} |

contract account(@"borrow", deployerId, @currency, @amount, ret) = {
  new pkCh in {
    deployerIdOps!("pubKeyBytes", *deployerId, *pkCh) |
    for (@pk <- pkCh) {
      if (pk == pubKeyBytes) {
        new authCh in {
          accountVaultAuth!(currency, *authCh) |
          for (@a <- authCh) {
            match a {
              Nil => ret!((false, "open a vault first"))
              auth => {
                new purseCh in {
                  accountEnsurePurse!(currency, *purseCh) |
                  for (@pc <- purseCh) {
                    match pc {
                      (true, purse, brand) => {
                        new facetCh in {
                          @purse!("getDepositFacet", *facetCh) |
                          for (@f <- facetCh) {
                            match f {
                              (true, facet) => {
                                new zoneCh in {
                                  accountZone!(currency, *zoneCh) |
                                  for (@z <- zoneCh) {
                                    match z {
                                      (true, zone) => {
                                        @zone!("borrow", ownerId, auth, amount, facet, *ret)
                                      }
                                      _ => ret!((false, "no zone"))
                                    }
                                  }
                                }
                              }
                              _ => ret!(f)
                            }
                          }
                        }
                      }
                      _ => ret!(pc)
                    }
                  }
                }
              }
            }
          }
        }
      } else { ret!((false, "not owner")) }
    }
  }
} |

contract account(@"repay", deployerId, @currency, @amount, ret) = {
  new pkCh in {
    deployerIdOps!("pubKeyBytes", *deployerId, *pkCh) |
    for (@pk <- pkCh) {
      if (pk == pubKeyBytes) {
        new authCh in {
          accountVaultAuth!(currency, *authCh) |
          for (@a <- authCh) {
            match a {
              Nil => ret!((false, "open a vault first"))
              auth => {
                new purseCh in {
                  accountEnsurePurse!(currency, *purseCh) |
                  for (@pc <- purseCh) {
                    match pc {
                      (true, purse, brand) => {
                        new payCh in {
                          @purse!("withdraw", (brand, amount), *payCh) |
                          for (@wp <- payCh) {
                            match wp {
                              (true, payment) => {
                                new zoneCh in {
                                  accountZone!(currency, *zoneCh) |
                                  for (@z <- zoneCh) {
                                    match z {
                                      (true, zone) => {
                                        @zone!("repay", ownerId, auth, payment, *ret)
                                      }
                                      _ => ret!((false, "no zone"))
                                    }
                                  }
                                }
                              }
                              _ => ret!(wp)
                            }
                          }
                        }
                      }
                      _ => ret!(pc)
                    }
                  }
                }
              }
            }
          }
        }
      } else { ret!((false, "not owner")) }
    }
  }
} |

contract account(@"liquidate", deployerId, @currency, @victimOwnerId, @amount, ret) = {
  new pkCh in {
    deployerIdOps!("pubKeyBytes", *deployerId, *pkCh) |
    for (@pk <- pkCh) {
      if (pk == pubKeyBytes) {
        new purseCh in {
          accountEnsurePurse!(currency, *purseCh) |
          for (@pc <- purseCh) {
            match pc {
              (true, purse, brand) => {
                new payCh in {
                  @purse!("withdraw", (brand, amount), *payCh) |
                  for (@wp <- payCh) {
                    match wp {
                      (true, payment) => {
                        new zoneCh in {
                          accountZone!(currency, *zoneCh) |
                          for (@z <- zoneCh) {
                            match z {
                              (true, zone) => {
                                new lpCh in {
                                  @zone!("liquidate", victimOwnerId, payment, *lpCh) |
                                  for (@lp <- lpCh) {
                                    match lp {
                                      (true, revPayment) => {
                                        new revPurseCh in {
                                          accountEnsurePurse!("REV", *revPurseCh) |
                                          for (@rpc <- revPurseCh) {
                                            match rpc {
                                              (true, revPurse, revBrand) => {
                                                new depCh in {
                                                  @revPurse!("deposit", revPayment, *depCh) |
                                                  for (@d <- depCh) { ret!((true, amount)) }
                                                }
                                              }
                                              _ => ret!(rpc)
                                            }
                                          }
                                        }
                                      }
                                      _ => ret!(lp)
                                    }
                                  }
                                }
                              }
                              _ => ret!((false, "no zone"))
                            }
                          }
                        }
                      }
                      _ => ret!(wp)
                    }
                  }
                }
              }
              _ => ret!(pc)
            }
          }
        }
      } else { ret!((false, "not owner")) }
    }
  }
} |

contract account(@"vaultInfo", deployerId, @currency, ret) = {
  new pkCh in {
    deployerIdOps!("pubKeyBytes", *deployerId, *pkCh) |
    for (@pk <- pkCh) {
      if (pk == pubKeyBytes) {
        new authCh in {
          accountVaultAuth!(currency, *authCh) |
          for (@a <- authCh) {
            match a {
              Nil => ret!((false, "open a vault first"))
              auth => {
                new zoneCh in {
                  accountZone!(currency, *zoneCh) |
                  for (@z <- zoneCh) {
                    match z {
                      (true, zone) => { @zone!("vault", ownerId, *ret) }
                      _ => ret!((false, "no zone"))
                    }
                  }
                }
              }
            }
          }
        }
      } else { ret!((false, "not owner")) }
    }
  }
} |
// ---- end core/AccountBody.inc ----
              factoryState!(accounts.set(ownerId, {
                "account": bundle+{*account},
                "proof": *proof
              })) |
              ret!((true, bundle+{*account}, ownerId))
            }
          }
          entry => {
            factoryState!(accounts) |
            ret!((true, entry.get("account"), ownerId))
          }
        }
      }
    }
  }
} |

contract AccountFactory(@"verify", @ownerId, proof, ret) = {
  for (@accounts <<- factoryState) {
    match accounts.get(ownerId) {
      Nil => ret!((true, false))
      entry => ret!((true, entry.get("proof") == *proof))
    }
  }
} |

contract AccountFactory(@"accountOf", @ownerId, ret) = {
  for (@accounts <<- factoryState) {
    match accounts.get(ownerId) {
      Nil => ret!((false, "no account"))
      entry => ret!((true, entry.get("account")))
    }
  }
} |
