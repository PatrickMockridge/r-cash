// v0.4 market layer: content-addressed terms, the market index and directory,
// and the factory that creates one oracle-anchored FxPool per direct pair.
// The factory is the only writer of the directory and the index; both hold its
// locally created authorisation. A caller never supplies a pool URI.
// Placeholders: __ROOT_URI__, __ASSET_RESOLVER_URI__.
new
  MarketTerms, termsState,
  MarketIndex, indexState,
  MarketDirectory, directoryState,
  MarketFactory, TradabilityGate, ListingViews,
  marketNow, marketVerifier, marketOracle, stageCheck, stageMarket, createMarketPool,
  activatePool, marketTransition, pauseAssetMarkets,
  marketOwner, marketOwnerCheck,
  marketAuth,
  rl(`rho:registry:lookup`),
  revAddress(`rho:rev:address`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployerIdOps(`rho:rchain:deployerId:ops`),
  deployId(`rho:rchain:deployId`),
  ertpCh, rootCh, Root, uTerms, uIndex, uDirectory, uFactory,
  uGate, uViews, ack
in {

  contract marketNow(ret) = {
    new rCh, cCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:clock", 1, *cCh) |
        for (@(true, clockUri, _) <- cCh) {
          new cc in {
            rl!(clockUri, *cc) |
            for (Clock <- cc) { Clock!("now", *ret) }
          }
        }
      }
    }
  } |

  contract marketVerifier(ret) = {
    new rCh, vCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:verifier", 1, *vCh) |
        for (@(true, verUri, _) <- vCh) {
          new vc in {
            rl!(verUri, *vc) |
            for (Verifier <- vc) { ret!(*Verifier) }
          }
        }
      }
    }
  } |

  contract marketOracle(ret) = {
    new rCh, hCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:oracle-registry", 1, *hCh) |
        for (@(true, hubUri, _) <- hCh) {
          new hc in {
            rl!(hubUri, *hc) |
            for (OracleRegistry <- hc) { ret!(*OracleRegistry) }
          }
        }
      }
    }
  } |

  contract marketOwner(@pubHex, ret) = {
    revAddress!("fromPublicKey", pubHex.hexToBytes(), *ret)
  } |

  // Sponsor identity checks: the submitter is the sponsor key, the sponsor
  // owns the named address and is the seed-lock beneficiary, and the lock
  // length meets the factory floor. Requiring the submitter removes
  // third-party replay of a signed create payload.
  contract marketOwnerCheck(@terms, @sponsorHex, dId, ret) = {
    new pkCh in {
      deployerIdOps!("pubKeyBytes", *dId, *pkCh) |
      for (@pk <- pkCh) {
        if (pk != sponsorHex.hexToBytes()) {
          ret!((false, "bad sponsor"))
        } else {
          if (terms.get("lockBeneficiaryPubKey") != sponsorHex) {
            ret!((false, "lock beneficiary"))
          } else {
            if (terms.get("lockMinBlocks") < __MIN_LOCK_BLOCKS__) {
              ret!((false, "lock too short"))
            } else {
              new oCh in {
                marketOwner!(sponsorHex, *oCh) |
                for (@ownerId <- oCh) {
                  if (ownerId != terms.get("sponsorOwnerId")) {
                    ret!((false, "sponsor owner"))
                  } else { ret!((true, Nil)) }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract marketTransition(@from, @to, ret) = {
    if (from == "active") {
      if (to == "paused" || to == "delisted") { ret!(true) }
      else { ret!(false) }
    } else {
      if (from == "paused") {
        if (to == "active" || to == "delisted") { ret!(true) }
        else { ret!(false) }
      } else {
        if (from == "draft") {
          if (to == "delisted") { ret!(true) } else { ret!(false) }
        } else { ret!(false) }
      }
    }
  } |

  // A put is authenticated: the sponsor signs the canonical hash in the same
  // market-create preimage the factory uses.  The terms store is content-
  // addressed, so a relayer can carry the payload but cannot mint a new one.
  contract MarketTerms(@"put", @terms, @values, @sponsorHex, @sig, ret) = {
    new rCh, bCh, cCh, vCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:bounds", 1, *bCh) |
        Root!("resolve", "component:codec", 1, *cCh) |
        marketVerifier!(*vCh) |
        for (@(true, boundsUri, _) <- bCh; @(true, codecUri, _) <- cCh;
             Verifier <- vCh) {
          new bc, cc, checkCh in {
            rl!(boundsUri, *bc) | rl!(codecUri, *cc) |
            for (Bounds <- bc; Codec <- cc) {
              Bounds!("checkTerms", terms, values, *checkCh) |
              for (@checked <- checkCh) {
                match checked {
                  (true, Nil) => {
                    new hCh, payloadCh, digestCh, okCh in {
                      Codec!("canonical", "rcash:market-terms:v4", values, *hCh) |
                      for (@hash <- hCh) {
                        payloadCh!("rcash:market-create:v1|" ++ terms.get("marketId")
                                   ++ "|" ++ hash ++ "|" ++ sponsorHex) |
                        for (@payload <- payloadCh) {
                          Verifier!("hash", payload.toUtf8Bytes(), *digestCh) |
                          for (@digest <- digestCh) {
                            Verifier!("sigOk", digest, sig, sponsorHex.hexToBytes(), *okCh) |
                            for (@ok <- okCh) {
                              if (ok == false || terms.get("sponsorPubKey") != sponsorHex) {
                                ret!((false, "bad sponsor signature"))
                              } else {
                                for (@s <- termsState) {
                                  match s.get("terms").get(hash) {
                                    Nil => {
                                      termsState!(s.set("terms",
                                        s.get("terms").set(hash, {"terms": terms, "values": values}))
                                        .set("rev", s.get("rev") + 1)) |
                                      ret!((true, hash))
                                    }
                                    _ => { termsState!(s) | ret!((true, hash)) }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                  _ => { ret!(checked) }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract MarketTerms(@"get", @hash, ret) = {
    for (@s <<- termsState) {
      match s.get("terms").get(hash) {
        Nil => { ret!((false, "no terms")) }
        entry => { ret!((true, entry)) }
      }
    }
  } |

  contract MarketDirectory(@"bind", @marketId, @slot, @auth, ret) = {
    if (auth != *marketAuth) { ret!((false, "bad directory authority")) }
    else {
      for (@s <- directoryState) {
        match s.get("slots").get(marketId) {
          Nil => {
            directoryState!(s.set("slots", s.get("slots").set(marketId, slot))
                             .set("rev", s.get("rev") + 1)) |
            ret!((true, Nil))
          }
          existing => {
            // Create-only, with an exact retry idempotent. Never overwrite a
            // different slot: a duplicate create must not replace a pool that
            // the sponsor may already have seeded.
            if (existing.get("termsHash") == slot.get("termsHash")
                && existing.get("poolUri") == slot.get("poolUri")
                && existing.get("lockUri") == slot.get("lockUri")) {
              directoryState!(s) | ret!((true, Nil))
            } else {
              directoryState!(s) | ret!((false, "exists", existing))
            }
          }
        }
      }
    }
  } |

  contract MarketDirectory(@"seal", @marketId, @auth, ret) = {
    if (auth != *marketAuth) { ret!((false, "bad directory authority")) }
    else {
      for (@s <- directoryState) {
        match s.get("slots").get(marketId) {
          Nil => { directoryState!(s) | ret!((false, "no slot")) }
          existing => {
            directoryState!(s.set("slots",
              s.get("slots").set(marketId, existing.set("sealed", true)))
              .set("rev", s.get("rev") + 1)) |
            ret!((true, Nil))
          }
        }
      }
    }
  } |

  contract MarketDirectory(@"byId", @marketId, ret) = {
    for (@s <<- directoryState) {
      match s.get("slots").get(marketId) {
        Nil => { ret!((false, "no slot")) }
        slot => { ret!((true, slot)) }
      }
    }
  } |

  contract MarketDirectory(@"slot", @marketId, ret) = {
    for (@s <<- directoryState) {
      match s.get("slots").get(marketId) {
        Nil => { ret!((false, "no slot")) }
        slot => { ret!((true, slot)) }
      }
    }
  } |

  contract stageMarket(@s, @record, ret) = {
    indexState!(s.set("markets", s.get("markets").set(record.get("marketId"), record))
                 .set("byPair", s.get("byPair")
                   .set(record.get("pairKey"), record.get("marketId"))
                   .set("market:" ++ record.get("quote") ++ "/" ++ record.get("base"),
                        record.get("marketId")))
                 .set("bySlug", s.get("bySlug").set(record.get("slug"), record.get("marketId")))
                 .set("rev", s.get("rev") + 1)) |
    ret!((true, record.get("marketId")))
  } |


  contract activatePool(@slot, @record, @entry, @marketId, ret) = {
    new pCh, aCh in {
                          rl!(slot.get("poolUri"), *pCh) |
                          for (FxPool <- pCh) {
                            FxPool!("attest", *aCh) |
                            for (@a <- aCh) {
                              match a {
                                (true, att) => {
                                  if (att.get("seeded") == false) { ret!((false, "not seeded")) }
                                  else {
                                    if (att.get("termsHash") != record.get("termsHash")) {
                                      ret!((false, "terms mismatch"))
                                    } else {
                                      if (att.get("rb") < entry.get("terms").get("seedBase")
                                          || att.get("rq") < entry.get("terms").get("seedQuote")) {
                                        ret!((false, "seed mismatch"))
                                      } else {
                                        if (att.get("totalShares") < entry.get("terms").get("seedInitialShares")) {
                                          ret!((false, "shares mismatch"))
                                        } else {
                                          if (att.get("rq") < entry.get("terms").get("depthFloorQuote")) {
                                            ret!((false, "depth"))
                                          } else {
                                            for (@s2 <- indexState) {
                                              match s2.get("markets").get(marketId) {
                                                Nil => { ret!(1 / 0) }
                                                r2 => {
                                                  if (r2.get("status") != "draft") { ret!(1 / 0) }
                                                  else {
                                                    new goCh in {
                                                      match s2.get("byPair").get(record.get("pairKey")) {
                                                        Nil => { goCh!(true) }
                                                        owner => {
                                                          if (owner == marketId) { goCh!(true) }
                                                          else {
                                                            match s2.get("markets").get(owner) {
                                                              Nil => { goCh!(true) }
                                                              p => {
                                                                if (p.get("status") == "delisted"
                                                                    && record.get("version") > p.get("version")) {
                                                                  goCh!(true)
                                                                } else { goCh!(false) }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      } |
                                                      for (@ok <- goCh) {
                                                        if (ok) {
                                                          indexState!(s2.set("markets",
                                                            s2.get("markets").set(marketId,
                                                              r2.set("status", "active")))
                                                            .set("byPair",
                                                              s2.get("byPair").set(record.get("pairKey"), marketId)
                                                                .set("market:" ++ record.get("quote")
                                                                      ++ "/" ++ record.get("base"), marketId))
                                                            .set("rev", s2.get("rev") + 1)) |
                                                          ret!((true, "active"))
                                                        } else {
                                                          indexState!(s2) | ret!((false, "pair active"))
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                                _ => { ret!((false, "no attestation")) }
                              }
                            }
                          }
                        }
  } |

  // Pure stage guard: the same checks as `MarketIndex.stage`, without writing.
  // `stage` uses it after the take; `checkStage` uses it before the factory
  // creates a pool or touches the directory, so a refused create cannot leave
  // a bound or sealed slot behind. The prior-market check is inlined for both
  // pair orientations to stay inside the contract budget.
  contract stageCheck(@s, @record, ret) = {
    match s.get("markets").get(record.get("marketId")) {
      Nil => {
        match s.get("bySlug").get(record.get("slug")) {
          Nil => {
            match s.get("byPair").get(record.get("pairKey")) {
              Nil => {
                match s.get("byPair").get(
                        "market:" ++ record.get("quote") ++ "/" ++ record.get("base")) {
                  Nil => { ret!((true, Nil)) }
                  prior => {
                    match s.get("markets").get(prior) {
                      Nil => { ret!((true, Nil)) }
                      p => {
                        if (p.get("status") == "active" || p.get("status") == "paused") {
                          ret!((false, "pair active"))
                        } else {
                          if (record.get("version") <= p.get("version")) {
                            ret!((false, "version"))
                          } else { ret!((true, Nil)) }
                        }
                      }
                    }
                  }
                }
              }
              prior => {
                match s.get("markets").get(prior) {
                  Nil => { ret!((true, Nil)) }
                  p => {
                    if (p.get("status") == "active" || p.get("status") == "paused") {
                      ret!((false, "pair active"))
                    } else {
                      if (record.get("version") <= p.get("version")) {
                        ret!((false, "version"))
                      } else { ret!((true, Nil)) }
                    }
                  }
                }
              }
            }
          }
          _ => { ret!((false, "slug")) }
        }
      }
      _ => { ret!((false, "exists")) }
    }
  } |

  // Pure transformer over the market map for the pauseAsset kill switch.
  contract pauseAssetMarkets(@ids, @i, @code, @markets, ret) = {
    if (i >= ids.length()) { ret!(markets) }
    else {
      match ids.nth(i) {
        id => {
          match markets.get(id) {
            Nil => { pauseAssetMarkets!(ids, i + 1, code, markets, *ret) }
            record => {
              if ((record.get("base") == code || record.get("quote") == code)
                  && record.get("status") == "active") {
                pauseAssetMarkets!(ids, i + 1, code,
                                   markets.set(id, record.set("status", "paused")), *ret)
              } else {
                pauseAssetMarkets!(ids, i + 1, code, markets, *ret)
              }
            }
          }
        }
      }
    }
  } |

  contract MarketIndex(@"stage", @record, @auth, ret) = {
    if (auth != *marketAuth) { ret!((false, "bad index authority")) }
    else {
      for (@s <- indexState) {
        new gCh in {
          stageCheck!(s, record, *gCh) |
          for (@g <- gCh) {
            match g {
              (true, Nil) => { stageMarket!(s, record, *ret) }
              _ => { indexState!(s) | ret!(g) }
            }
          }
        }
      }
    }
  } |

  // Read-only pre-check used by the factory before it creates a pool or writes
  // the directory. A refusal here leaves the index and directory untouched.
  contract MarketIndex(@"checkStage", @record, ret) = {
    for (@s <<- indexState) { stageCheck!(s, record, *ret) }
  } |

  contract MarketIndex(@"activate", @marketId, ret) = {
    for (@s <<- indexState) {
      match s.get("markets").get(marketId) {
        Nil => { ret!((false, "no market")) }
        record => {
          if (record.get("status") != "draft") { ret!((false, "not draft")) }
          else {
            new dCh, tCh, pCh, aCh, lCh, iCh in {
              MarketDirectory!("byId", marketId, *dCh) |
              MarketTerms!("get", record.get("termsHash"), *tCh) |
              for (@d <- dCh; @t <- tCh) {
                match d {
                  (true, slot) => {
                    match t {
                      (true, entry) => {
                        if (slot.get("sealed") == false) { ret!((false, "not sealed")) }
                        else {
                          rl!(slot.get("lockUri"), *lCh) |
                          for (LiquidityLock <- lCh) {
                            LiquidityLock!("info", *iCh) |
                            for (@i <- iCh) {
                              match i {
                                (true, info) => {
                                  if (info.get("funded") == false) {
                                    ret!((false, "lock unfunded"))
                                  } else {
                                    if (info.get("untilHeight") < entry.get("terms").get("lockUntilHeight")) {
                                      ret!((false, "lock height"))
                                    } else {
                                      activatePool!(slot, record, entry, marketId, *ret)
                                    }
                                  }
                                }
                                _ => { ret!((false, "no lock")) }
                              }
                            }
                          }
                        }
                      }
                      _ => { ret!(t) }
                    }
                  }
                  _ => { ret!(d) }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract MarketIndex(@"market", @marketId, ret) = {
    for (@s <<- indexState) {
      match s.get("markets").get(marketId) {
        Nil => { ret!((false, "no market")) }
        record => { ret!((true, record)) }
      }
    }
  } |

  contract MarketIndex(@"markets", ret) = {
    for (@s <<- indexState) { ret!((true, s.get("markets"))) }
  } |

  contract MarketIndex(@"marketFor", @base, @quote, ret) = {
    for (@s <<- indexState) {
      match s.get("byPair").get("market:" ++ base ++ "/" ++ quote) {
        Nil => {
          match s.get("byPair").get("market:" ++ quote ++ "/" ++ base) {
            Nil => { ret!((false, "no market")) }
            marketId => {
              match s.get("markets").get(marketId) {
                Nil => { ret!((false, "no market")) }
                record => { ret!((true, record)) }
              }
            }
          }
        }
        marketId => {
          match s.get("markets").get(marketId) {
            Nil => { ret!((false, "no market")) }
            record => { ret!((true, record)) }
          }
        }
      }
    }
  } |

  contract MarketIndex(@"setStatus", @marketId, @status, @nonce, @sigs, ret) = {
    new gCh, vCh, tCh in {
      rl!(`__ROOT_URI__`, *gCh) |
      for (Root <- gCh) {
        Root!("resolve", "component:governor", 1, *vCh) |
        for (@(true, govUri, _) <- vCh) {
          new gc in {
            rl!(govUri, *gc) |
            for (Governor <- gc) {
              Governor!("authorize", "market-index", nonce, "setStatus",
                        marketId ++ "|" ++ status, sigs, *gCh) |
              for (@v <- gCh) {
                match v {
                  (true, Nil) => {
                    for (@s <- indexState) {
                      match s.get("markets").get(marketId) {
                        Nil => { indexState!(s) | ret!((false, "no market")) }
                        record => {
                          marketTransition!(record.get("status"), status, *tCh) |
                          for (@ok <- tCh) {
                            if (ok == false) {
                              indexState!(s) | ret!((false, "transition"))
                            } else {
                              indexState!(s.set("markets",
                                s.get("markets").set(marketId, record.set("status", status)))
                                .set("rev", s.get("rev") + 1)) |
                              ret!((true, status))
                            }
                          }
                        }
                      }
                    }
                  }
                  _ => { ret!(v) }
                }
              }
            }
          }
        }
      }
    }
  } |

  // Governor kill switch for an asset: pause every active market that uses it.
  contract MarketIndex(@"pauseAsset", @code, @nonce, @sigs, ret) = {
    new rootCh, resolveCh, gcCh, replyCh, mCh in {
      rl!(`__ROOT_URI__`, *rootCh) |
      for (Root <- rootCh) {
        Root!("resolve", "component:governor", 1, *resolveCh) |
        for (@(true, govUri, _) <- resolveCh) {
          rl!(govUri, *gcCh) |
          for (Governor <- gcCh) {
            Governor!("authorize", "market-index", nonce, "pauseAsset", code, sigs, *replyCh) |
            for (@v <- replyCh) {
              match v {
                (true, Nil) => {
                  for (@s <- indexState) {
                    pauseAssetMarkets!(s.get("markets").keys().toList(), 0, code,
                                       s.get("markets"), *mCh) |
                    for (@markets <- mCh) {
                      indexState!(s.set("markets", markets)
                                   .set("rev", s.get("rev") + 1)) |
                      ret!((true, Nil))
                    }
                  }
                }
                _ => { ret!(v) }
              }
            }
          }
        }
      }
    }
  } |

  contract TradabilityGate(@"admit", @status, @fresh, @inputValue, @poolValue,
                           @terms, ret) = {
    if (status != "active") { ret!((false, "not active")) }
    else {
      if (fresh == false) { ret!((false, "stale")) }
      else {
        if (inputValue < terms.get("minTicketQuote")) { ret!((false, "min ticket")) }
        else {
          if (inputValue * 10000 > poolValue * terms.get("maxTradeBps")) {
            ret!((false, "max trade"))
          } else { ret!((true, Nil)) }
        }
      }
    }
  } |

  contract ListingViews(@"marketFor", @base, @quote, ret) = {
    new rCh, iCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:market-index", 1, *iCh) |
        for (@(true, indexUri, _) <- iCh) {
          new ic in {
            rl!(indexUri, *ic) |
            for (MarketIndex <- ic) {
              MarketIndex!("marketFor", base, quote, *ret)
            }
          }
        }
      }
    }
  } |

  contract ListingViews(@"market", @marketId, ret) = {
    new rCh, iCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:market-index", 1, *iCh) |
        for (@(true, indexUri, _) <- iCh) {
          new ic in {
            rl!(indexUri, *ic) |
            for (MarketIndex <- ic) { MarketIndex!("market", marketId, *ret) }
          }
        }
      }
    }
  } |

  contract ListingViews(@"isActive", @marketId, ret) = {
    new rCh, iCh, mCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:market-index", 1, *iCh) |
        for (@(true, indexUri, _) <- iCh) {
          new ic in {
            rl!(indexUri, *ic) |
            for (MarketIndex <- ic) {
              MarketIndex!("market", marketId, *mCh) |
              for (@m <- mCh) {
                match m {
                  (true, record) => { ret!((true, record.get("status") == "active")) }
                  _ => { ret!((false, "no market")) }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract ListingViews(@"terms", @termsHash, ret) = {
    new rCh, iCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:market-terms", 1, *iCh) |
        for (@(true, termsUri, _) <- iCh) {
          new tc in {
            rl!(termsUri, *tc) |
            for (MarketTerms <- tc) { MarketTerms!("get", termsHash, *ret) }
          }
        }
      }
    }
  } |

  contract ListingViews(@"currency", @code, ret) = {
    new rCh, iCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:currency-registry", 1, *iCh) |
        for (@(true, regUri, _) <- iCh) {
          new rc in {
            rl!(regUri, *rc) |
            for (CurrencyRegistry <- rc) { CurrencyRegistry!("currency", code, *ret) }
          }
        }
      }
    }
  } |

  contract ListingViews(@"currencies", ret) = {
    new rCh, iCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:currency-registry", 1, *iCh) |
        for (@(true, regUri, _) <- iCh) {
          new rc in {
            rl!(regUri, *rc) |
            for (CurrencyRegistry <- rc) { CurrencyRegistry!("currencies", *ret) }
          }
        }
      }
    }
  } |

  contract ListingViews(@"markets", ret) = {
    new rCh, iCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:market-index", 1, *iCh) |
        for (@(true, indexUri, _) <- iCh) {
          new ic in {
            rl!(indexUri, *ic) |
            for (MarketIndex <- ic) { MarketIndex!("markets", *ret) }
          }
        }
      }
    }
  } |

  // Create the pool, bind and seal the directory slot, then stage the index.
  // The stage pre-check has already passed in the caller. Any refusal after
  // bind/seal fails the deploy so the directory write rolls back.
  contract createMarketPool(@terms, @termsHash, @record, ret) = {
    new tCh, trCh, tc, pcCh, bindCh, sealCh, stageCh in {
      rl!(`__ROOT_URI__`, *tCh) |
      for (Root <- tCh) {
        Root!("resolve", "component:pool-template", 1, *trCh) |
        for (@(true, tplUri, _) <- trCh) {
          rl!(tplUri, *tc) |
          for (PoolTemplate <- tc) {
            PoolTemplate!("create", terms, termsHash, *pcCh) |
            for (@pc <- pcCh) {
              match pc {
                (true, poolUri, lockUri) => {
                  MarketDirectory!("bind", terms.get("marketId"),
                    {"poolUri": poolUri, "lockUri": lockUri,
                     "termsHash": termsHash, "sealed": false},
                    *marketAuth, *bindCh) |
                  for (@bound <- bindCh) {
                    match bound {
                      (true, Nil) => {
                        MarketDirectory!("seal", terms.get("marketId"),
                                         *marketAuth, *sealCh) |
                        for (@sealed <- sealCh) {
                          match sealed {
                            (true, Nil) => {
                              MarketIndex!("stage", record, *marketAuth, *stageCh) |
                              for (@staged <- stageCh) {
                                match staged {
                                  (true, _) => {
                                    ret!((true, terms.get("marketId"),
                                          poolUri, lockUri, termsHash))
                                  }
                                  _ => { ret!(1 / 0) }
                                }
                              }
                            }
                            _ => { ret!(1 / 0) }
                          }
                        }
                      }
                      (false, "exists", existing) => {
                        // A concurrent create won the slot. Same terms is an
                        // idempotent success; a different slot is refused
                        // without touching the winner.
                        if (existing.get("termsHash") == termsHash) {
                          ret!((true, terms.get("marketId"),
                                existing.get("poolUri"),
                                existing.get("lockUri"), termsHash))
                        } else { ret!((false, "exists", existing)) }
                      }
                      _ => { ret!(bound) }
                    }
                  }
                }
                _ => { ret!(pc) }
              }
            }
          }
        }
      }
    }
  } |

  contract MarketFactory(@"createMarket", @terms, @values, @sponsorHex, @sig, dId, ret) = {
    new vCh, hCh, regCh, oCh, bpCh, qpCh, dataCh, spCh,
        slotCh, idxCh, ckCh, stCh, recCh in {
      marketVerifier!(*vCh) |
      for (Verifier <- vCh) {
        MarketTerms!("put", terms, values, sponsorHex, sig, *hCh) |
        for (@put <- hCh) {
          match put {
            (true, termsHash) => {
              Verifier!("hash",
                ("rcash:market-create:v1|" ++ terms.get("marketId") ++ "|"
                 ++ termsHash ++ "|" ++ sponsorHex).toUtf8Bytes(), *dataCh) |
              for (@digest <- dataCh) {
                Verifier!("sigOk", digest, sig, sponsorHex.hexToBytes(), *oCh) |
                for (@ok <- oCh) {
                  if (ok == false) { ret!((false, "bad sponsor signature")) }
                  else {
                    if (terms.get("sponsorPubKey") != sponsorHex) {
                      ret!((false, "sponsor mismatch"))
                    } else {
                      marketOwnerCheck!(terms, sponsorHex, *dId, *spCh) |
                      for (@sp <- spCh) {
                        match sp {
                          (true, Nil) => {
                                  marketOracle!(*regCh) |
                                  for (Registry <- regCh) {
                                    Registry!("feedEntry", terms.get("base"), *bpCh) |
                                    Registry!("feedEntry", terms.get("quote"), *qpCh) |
                                    for (@bf <- bpCh; @qf <- qpCh) {
                                      match bf {
                                        (true, bfeed) => {
                                          match qf {
                                            (true, qfeed) => {
                                              if (bfeed.get("policyHash") != terms.get("baseFeedPolicyHash")) {
                                                ret!((false, "base feed policy"))
                                              } else {
                                                if (qfeed.get("policyHash") != terms.get("quoteFeedPolicyHash")) {
                                                  ret!((false, "quote feed policy"))
                                                } else {
                                                  if (bfeed.get("status") != "active"
                                                      || qfeed.get("status") != "active") {
                                                    ret!((false, "feed inactive"))
                                                  } else {
                                                    recCh!({"marketId": terms.get("marketId"),
                                                            "slug": terms.get("slug"),
                                                            "pairKey": "market:" ++ terms.get("base")
                                                                       ++ "/" ++ terms.get("quote"),
                                                            "base": terms.get("base"),
                                                            "quote": terms.get("quote"),
                                                            "version": terms.get("version"),
                                                            "termsHash": termsHash,
                                                            "status": "draft"}) |
                                                    for (@record <- recCh) {
                                                      MarketDirectory!("slot", terms.get("marketId"), *slotCh) |
                                                      for (@slot <- slotCh) {
                                                        match slot {
                                                          (true, existing) => {
                                                            if (existing.get("termsHash") != termsHash) {
                                                              ret!((false, "exists", existing))
                                                            } else {
                                                              MarketIndex!("market", terms.get("marketId"), *idxCh) |
                                                              for (@idx <- idxCh) {
                                                                match idx {
                                                                  (true, _) => {
                                                                    ret!((true, terms.get("marketId"),
                                                                          existing.get("poolUri"),
                                                                          existing.get("lockUri"),
                                                                          termsHash))
                                                                  }
                                                                  (false, "no market") => {
                                                                    MarketIndex!("checkStage", record, *ckCh) |
                                                                    for (@ck <- ckCh) {
                                                                      match ck {
                                                                        (true, Nil) => {
                                                                          MarketIndex!("stage", record, *stCh) |
                                                                          for (@st <- stCh) {
                                                                            match st {
                                                                              (true, _) => {
                                                                                ret!((true, terms.get("marketId"),
                                                                                      existing.get("poolUri"),
                                                                                      existing.get("lockUri"),
                                                                                      termsHash))
                                                                              }
                                                                              _ => { ret!(st) }
                                                                            }
                                                                          }
                                                                        }
                                                                        _ => { ret!(ck) }
                                                                      }
                                                                    }
                                                                  }
                                                                  _ => { ret!(idx) }
                                                                }
                                                              }
                                                            }
                                                          }
                                                          (false, "no slot") => {
                                                            MarketIndex!("checkStage", record, *ckCh) |
                                                            for (@ck <- ckCh) {
                                                              match ck {
                                                                (true, Nil) => {
                                                                  createMarketPool!(terms, termsHash, record, *ret)
                                                                }
                                                                _ => { ret!(ck) }
                                                              }
                                                            }
                                                          }
                                                          _ => { ret!(slot) }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                            _ => { ret!(qf) }
                                          }
                                        }
                                        _ => { ret!(bf) }
                                      }
                                    }
                                  }
                                }
                                _ => { ret!(sp) }
                              }
                            }
                    }
                  }
                }
              }
            }
            _ => { ret!(put) }
          }
        }
      }
    }
  } |

  termsState!({"terms": {}, "rev": 0}) |
  directoryState!({"slots": {}, "rev": 0}) |
  indexState!({"markets": {}, "byPair": {}, "bySlug": {}, "rev": 0}) |

  rl!(`rho:rchain:ertp`, *ertpCh) |
  for (@(_, ERTP) <- ertpCh) {
    rs!(bundle+{*MarketTerms}, *uTerms) |
    rs!(bundle+{*MarketDirectory}, *uDirectory) |
    rs!(bundle+{*MarketIndex}, *uIndex) |
    rs!(bundle+{*MarketFactory}, *uFactory) |
    rs!(bundle+{*TradabilityGate}, *uGate) |
    rs!(bundle+{*ListingViews}, *uViews) |
    for (@termsUri <- uTerms; @dirUri <- uDirectory;
         @indexUri <- uIndex; @factoryUri <- uFactory;
         @gateUri <- uGate; @viewsUri <- uViews) {
      rl!(`__ROOT_URI__`, *rootCh) |
      for (Root <- rootCh) {
        Root!("register", "component:market-terms", termsUri, 1, "registry", *deployerId, *ack) |
        for (@r1 <- ack) {
          Root!("register", "component:market-directory", dirUri, 1, "registry", *deployerId, *ack) |
          for (@r2 <- ack) {
            Root!("register", "component:market-index", indexUri, 1, "registry", *deployerId, *ack) |
            for (@r3 <- ack) {
              Root!("register", "component:market-factory", factoryUri, 1, "registry", *deployerId, *ack) |
              for (@r4 <- ack) {
                Root!("register", "component:tradability-gate", gateUri, 1, "view", *deployerId, *ack) |
                for (@r5 <- ack) {
                  Root!("register", "component:listing-views", viewsUri, 1, "view", *deployerId, *ack) |
                  for (@r6 <- ack) {
                    deployId!([termsUri, dirUri, indexUri, factoryUri, gateUri, viewsUri])
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
