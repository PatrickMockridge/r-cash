// v0.3 Governor: the sole admin authorisation and per-domain replay ledger.
// Units call authorize(domain, nonce, ...) and apply the verified intent.
// Placeholders: __ROOT_URI__, __ADMIN_KEYS__.
new
  Governor, governorState, governorLast, governorAdminGuard,
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  bd(`rho:block:data`),
  rootCh, Root, agCh, AdminGuard, nowCh,
  uGovernor, ack
in {

  contract governorLast(@nonces, @domain, ret) = {
    match nonces.get(domain) {
      Nil => { ret!(0) }
      value => { ret!(value) }
    }
  } |

  contract governorAdminGuard(ret) = {
    new rootCh, rCh, agCh in {
      rl!(`__ROOT_URI__`, *rootCh) |
      for (Root <- rootCh) {
        Root!("resolve", "component:admin-guard", 1, *rCh) |
        for (@(true, agUri, v) <- rCh) {
          rl!(agUri, *agCh) |
          for (AdminGuard <- agCh) { ret!(*AdminGuard) }
        }
      }
    }
  } |

  contract Governor(@"authorize", @domain, @nonce, @action, @argsHash, @sigs, ret) = {
    for (@s <<- governorState) {
      new lastCh in {
        governorLast!(s.get("nonces"), domain, *lastCh) |
        for (@last <- lastCh) {
          if (nonce <= last) { ret!((false, "replay")) }
          else {
            new vCh in {
              governorAdminGuard!(*agCh) |
              for (AG <- agCh) {
                AG!("verify", domain, nonce, action, argsHash, sigs,
                    s.get("admins"), s.get("threshold"), *vCh) |
                for (@v <- vCh) {
                  match v {
                    (true, Nil) => {
                      for (@s2 <- governorState) {
                        new last2Ch in {
                          governorLast!(s2.get("nonces"), domain, *last2Ch) |
                          for (@last2 <- last2Ch) {
                            if (nonce <= last2) {
                              governorState!(s2) | ret!((false, "replay"))
                            } else {
                              governorState!(s2.set("nonces",
                                s2.get("nonces").set(domain, nonce))) |
                              ret!((true, Nil))
                            }
                          }
                        }
                      }
                    }
                    _ => { ret!(v) }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract Governor(@"schedule", @domain, @nonce, @action, @argsHash,
                            @args, @sigs, ret) = {
    for (@s <<- governorState) {
      new lastCh, nowCh in {
        governorLast!(s.get("nonces"), domain, *lastCh) |
        bd!(*nowCh) |
        for (@last <- lastCh; @height, @sender, @ts <- nowCh) {
          if (nonce <= last) { ret!((false, "replay")) }
          else {
            match s.get("pending").get(domain ++ "|" ++ nonce.toString()) {
              Nil => {
                new vCh in {
                  governorAdminGuard!(*agCh) |
                  for (AG <- agCh) {
                    AG!("verify", domain, nonce, action, argsHash, sigs,
                        s.get("admins"), s.get("threshold"), *vCh) |
                    for (@v <- vCh) {
                      match v {
                        (true, Nil) => {
                          for (@s2 <- governorState) {
                            if (s2.get("nonces").get(domain) >= nonce) {
                              governorState!(s2) | ret!((false, "replay"))
                            } else {
                              governorState!(s2.set("pending",
                                s2.get("pending").set(
                                  domain ++ "|" ++ nonce.toString(),
                                  {"action": action, "argsHash": argsHash,
                                   "args": args, "readyAt": height + s2.get("timelock")}))) |
                              ret!((true, height + s2.get("timelock")))
                            }
                          }
                        }
                        _ => { ret!(v) }
                      }
                    }
                  }
                }
              }
              _ => { ret!((false, "pending")) }
            }
          }
        }
      }
    }
  } |

  contract Governor(@"execute", @domain, @nonce, ret) = {
    for (@s <<- governorState) {
      new nowCh in {
        bd!(*nowCh) |
        for (@height, @sender, @ts <- nowCh) {
          match s.get("pending").get(domain ++ "|" ++ nonce.toString()) {
            Nil => { ret!((false, "unknown")) }
            entry => {
              if (height < entry.get("readyAt")) { ret!((false, "early")) }
              else {
                for (@s2 <- governorState) {
                  if (s2.get("nonces").get(domain) >= nonce) {
                    governorState!(s2) | ret!((false, "replay"))
                  } else {
                    governorState!(s2.set("nonces",
                      s2.get("nonces").set(domain, nonce)).set("pending",
                      s2.get("pending").set(
                        domain ++ "|" ++ nonce.toString(), Nil))) |
                    ret!((true, entry.get("action"), entry.get("argsHash"),
                          entry.get("args")))
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract Governor(@"admins", ret) = {
    for (@s <<- governorState) {
      ret!((true, s.get("admins"), s.get("threshold")))
    }
  } |

  contract Governor(@"admin", @nonce, @action, @args, @sigs, ret) = {
    for (@s <<- governorState) {
      new lastCh in {
        governorLast!(s.get("nonces"), "governor", *lastCh) |
        for (@last <- lastCh) {
          if (nonce <= last) { ret!((false, "replay")) }
          else {
            new vCh in {
              governorAdminGuard!(*agCh) |
              for (AG <- agCh) {
                AG!("verify", "governor", nonce, action, args.toString(), sigs,
                    s.get("admins"), s.get("threshold"), *vCh) |
                for (@v <- vCh) {
                  match v {
                    (true, Nil) => {
                      for (@s2 <- governorState) {
                        new last2Ch in {
                          governorLast!(s2.get("nonces"), "governor", *last2Ch) |
                          for (@last2 <- last2Ch) {
                            if (nonce <= last2) {
                              governorState!(s2) | ret!((false, "replay"))
                            } else {
                              match action {
                                "setAdmins" => {
                                  match args.nth(0) {
                                    newAdmins => {
                                      match args.nth(1) {
                                        newThreshold => {
                                          if (newThreshold < 1
                                              || newThreshold > newAdmins.length()) {
                                            governorState!(s2) | ret!((false, "threshold"))
                                          } else {
                                            governorState!(s2.set("admins", newAdmins)
                                              .set("threshold", newThreshold)
                                              .set("nonces", s2.get("nonces")
                                                .set("governor", nonce))) |
                                            ret!((true, Nil))
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                                "setThreshold" => {
                                  match args.nth(0) {
                                    newThreshold => {
                                      if (newThreshold < 1
                                          || newThreshold > s2.get("admins").length()) {
                                        governorState!(s2) | ret!((false, "threshold"))
                                      } else {
                                        governorState!(s2.set("threshold", newThreshold)
                                          .set("nonces", s2.get("nonces")
                                            .set("governor", nonce))) |
                                        ret!((true, Nil))
                                      }
                                    }
                                  }
                                }
                                "setTimelock" => {
                                  match args.nth(0) {
                                    newTimelock => {
                                      if (newTimelock < 1 || newTimelock > 1296000) {
                                        governorState!(s2) | ret!((false, "timelock"))
                                      } else {
                                        governorState!(s2.set("timelock", newTimelock)
                                          .set("nonces", s2.get("nonces")
                                            .set("governor", nonce))) |
                                        ret!((true, Nil))
                                      }
                                    }
                                  }
                                }
                                _ => {
                                  governorState!(s2) | ret!((false, "unknown admin action"))
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                    _ => { ret!(v) }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  governorState!({
    "admins": __ADMIN_KEYS__,
    "threshold": 2,
    "nonces": {},
    "timelock": 100,
    "pending": {}
  }) |

  rl!(`__ROOT_URI__`, *rootCh) |
  for (Root <- rootCh) {
    rs!(bundle+{*Governor}, *uGovernor) |
    for (@uri <- uGovernor) {
      Root!("register", "component:governor", uri, 1, "authority", *deployerId, *ack) |
      for (@r <- ack) { deployId!([uri]) }
    }
  }
}
