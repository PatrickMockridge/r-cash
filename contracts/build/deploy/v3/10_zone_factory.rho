// v0.3 ZoneDirectory + ZoneFactory.
// The directory accepts writes only from the factory through a fresh capability
// created in this deploy. The factory creates a zone through the canonical
// ZoneTemplate, so a caller cannot inject a zone URI.
// Placeholders: __ROOT_URI__.
new
  ZoneDirectory, zoneDirectoryState, ZoneFactory,
  directoryAuth,
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, Root, uDirectory, uFactory,
  a1, a2
in {

  contract ZoneDirectory(@"register", @currency, @uri, auth, ret) = {
    if (*auth != *directoryAuth) { ret!((false, "not factory")) }
    else {
      for (@s <- zoneDirectoryState) {
        match s.get("zones").get(currency) {
          Nil => {
            zoneDirectoryState!(s.set("zones", s.get("zones").set(currency, uri))) |
            ret!((true, Nil))
          }
          _ => { zoneDirectoryState!(s) | ret!((false, "duplicate")) }
        }
      }
    }
  } |

  contract ZoneDirectory(@"lookup", @currency, ret) = {
    for (@s <<- zoneDirectoryState) {
      match s.get("zones").get(currency) {
        Nil => { ret!((false, "no zone")) }
        uri => { ret!((true, uri)) }
      }
    }
  } |

  contract ZoneDirectory(@"entries", ret) = {
    for (@s <<- zoneDirectoryState) {
      ret!((true, s.get("zones")))
    }
  } |

  contract ZoneFactory(@"create", @currency, @params, @paramsHash,
                        @sponsorHex, @sig, ret) = {
    new rCh, tCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:zone-template", 1, *tCh) |
        for (@(true, templateUri, v) <- tCh) {
          new tc, crCh in {
            rl!(templateUri, *tc) |
            for (Template <- tc) {
              Template!("create", currency, params, paramsHash, sponsorHex, sig, *crCh) |
              for (@created <- crCh) {
                match created {
                  (true, zoneUri, att) => {
                    new regCh in {
                      ZoneDirectory!("register", currency, zoneUri,
                                     *directoryAuth, *regCh) |
                      for (@reg <- regCh) {
                        match reg {
                          (true, Nil) => { ret!((true, zoneUri, att)) }
                          _ => { ret!(reg) }
                        }
                      }
                    }
                  }
                  _ => { ret!(created) }
                }
              }
            }
          }
        }
      }
    }
  } |

  zoneDirectoryState!({"zones": {}}) |

  rl!(`__ROOT_URI__`, *rootCh) |
  for (Root <- rootCh) {
    rs!(bundle+{*ZoneDirectory}, *uDirectory) |
    rs!(bundle+{*ZoneFactory}, *uFactory) |
    for (@dirUri <- uDirectory; @factoryUri <- uFactory) {
      Root!("register", "component:zone-directory", dirUri, 1, "registry", *deployerId, *a1) |
      Root!("register", "component:zone-factory", factoryUri, 1, "factory", *deployerId, *a2) |
      for (@r1 <- a1; @r2 <- a2) { deployId!([dirUri, factoryUri]) }
    }
  }
}
