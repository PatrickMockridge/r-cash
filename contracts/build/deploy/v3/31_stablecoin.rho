// v0.4 stablecoin system: one REV-collateralised issuer per currency.
// The issuer, collateral custody, risk parameters and vault book are separate
// contracts with separate capabilities. This is issuer infrastructure, not a
// lending product; there is no borrower-facing UI.
// Placeholders: __ROOT_URI__, __CURRENCY__, __PARAMS__, __PARAMS_HASH__,
//               __SPONSOR_PUB__, __SPONSOR_SIG__.
new
  Stablecoin, issuerState,
  CollateralCustody,
  RiskParameters, paramsState,
  VaultBook, vaultState,
  LiquidationEngine,
  SavingsPool, savingsState,
  SurplusBuffer, bufferState,
  PegStabilityModule, psmState,
  callerOwner, bufferCancelled,
  stablecoinCheck, vaultLiquidateCommit, vaultWriteOff, repayCommit, vaultMintCommit,
  vaultNow, vaultPrice, vaultMath, vaultUpdate, vaultGovernor, vaultAccountFactory,
  vaultCodec, vaultBounds, paramsValues, feeCeil,
  psmSellCommit, psmBuyCommit,
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  bd(`rho:block:data`),
  deployerId(`rho:rchain:deployerId`),
  deployerIdOps(`rho:rchain:deployerId:ops`),
  revAddress(`rho:rev:address`),
  deployId(`rho:rchain:deployId`),
  currencyCh, paramsCh, paramsHashCh, sponsorCh, checkCh, nowCh,
  ertpCh, kitCh, revIssuerCh, burnPurseCh, revPurseCh, burnFacetCh,
  savingsPurseCh, bufferPurseCh, psmRevPurseCh,
  mintAuth, burnAuth, custodyAuth, liquidationAuth,
  settlementAuth, psmMintAuth, psmBurnAuth,
  bufferDepositAuth, bufferPayAuth, bufferCoverAuth, savingsNotifyAuth,
  uSC, uCustody, uParams, uVault, uLiq, uSavings, uBuffer, uPsm,
  scUri, custodyUri, paramsUri, vaultUri, liqUri, savingsUri, psmUri, attCh
in {

  contract stablecoinCheck(@currency, @params, @paramsHash, @sponsorHex, @sig, ret) = {
    new rCh, verCh, bCh, cCh, dCh, okCh, bzCh, hCh, payloadCh in {
      payloadCh!(
        "rcash:stablecoin-create:v1|" ++ currency ++ "|" ++ paramsHash ++ "|" ++ sponsorHex) |
      for (@payload <- payloadCh) {
        rl!(`__ROOT_URI__`, *rCh) |
        for (Root <- rCh) {
          Root!("resolve", "component:verifier", 1, *verCh) |
          Root!("resolve", "component:bounds", 1, *bCh) |
          Root!("resolve", "component:codec", 1, *cCh) |
          for (@(true, vUri, vv) <- verCh;
               @(true, bUri, bv) <- bCh;
               @(true, cUri, cv) <- cCh) {
            new vc, bc, cc in {
              rl!(vUri, *vc) | rl!(bUri, *bc) | rl!(cUri, *cc) |
              for (Verifier <- vc; Bounds <- bc; Codec <- cc) {
                Verifier!("hash", payload.toUtf8Bytes(), *dCh) |
                for (@digest <- dCh) {
                  Verifier!("sigOk", digest, sig, sponsorHex.hexToBytes(), *okCh) |
                  for (@ok <- okCh) {
                    if (ok == false) { ret!((false, "bad sponsor signature")) }
                    else {
                      Bounds!("checkIssuer", params, *bzCh) |
                      for (@bz <- bzCh) {
                        match bz {
                          (true, Nil) => {
                            Codec!("hash", "rcash:stablecoin-params:v2",
                                   [currency,
                                    params.get("mcrBps").toString(),
                                    params.get("bonusBps").toString(),
                                    params.get("closeFactorBps").toString(),
                                    params.get("ratePerBlock").toString(),
                                    params.get("debtCeiling").toString(),
                                    params.get("minDebt").toString(),
                                    params.get("maxDebt").toString(),
                                    params.get("maxOracleAge").toString(),
                                    params.get("savingsShareBps").toString(),
                                    params.get("psmFeeBps").toString()], *hCh) |
                            for (@h <- hCh) {
                              if (h != paramsHash.hexToBytes()) {
                                ret!((false, "params hash"))
                              } else { ret!((true, Nil)) }
                            }
                          }
                          _ => { ret!(bz) }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract vaultNow(ret2) = {
    new rCh, cCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:clock", 1, *cCh) |
        for (@(true, clockUri, v) <- cCh) {
          new cc in {
            rl!(clockUri, *cc) |
            for (Clock <- cc) { Clock!("now", *ret2) }
          }
        }
      }
    }
  } |

  contract vaultPrice(@currency, @maxAge, ret2) = {
    new rCh, hCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:oracle-hub", 1, *hCh) |
        for (@(true, hubUri, v) <- hCh) {
          new hc, rrCh in {
            rl!(hubUri, *hc) |
            for (OracleHub <- hc) {
              OracleHub!("getPair", "REV", currency, maxAge, *rrCh) |
              for (@rr <- rrCh) {
                match rr {
                  (true, m) => { ret2!((m.get("rate"), m.get("fresh"))) }
                  _ => { ret2!((0, false)) }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract vaultMath(ret2) = {
    new rCh, mCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:collateral-math", 1, *mCh) |
        for (@(true, mathUri, v) <- mCh) {
          new mc in {
            rl!(mathUri, *mc) |
            for (CollateralMath <- mc) { ret2!(*CollateralMath) }
          }
        }
      }
    }
  } |

  contract vaultGovernor(ret2) = {
    new rCh, gCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:governor", 1, *gCh) |
        for (@(true, govUri, v) <- gCh) {
          new gc in {
            rl!(govUri, *gc) |
            for (Governor <- gc) { ret2!(*Governor) }
          }
        }
      }
    }
  } |

  contract vaultCodec(ret2) = {
    new rCh, cCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:codec", 1, *cCh) |
        for (@(true, codecUri, v) <- cCh) {
          new cc in {
            rl!(codecUri, *cc) |
            for (Codec <- cc) { ret2!(*Codec) }
          }
        }
      }
    }
  } |

  contract vaultBounds(ret2) = {
    new rCh, bCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:bounds", 1, *bCh) |
        for (@(true, boundsUri, v) <- bCh) {
          new bc in {
            rl!(boundsUri, *bc) |
            for (Bounds <- bc) { ret2!(*Bounds) }
          }
        }
      }
    }
  } |

  // Fee ceiling in basis points, rounded up so the protocol never undercharges.
  contract feeCeil(@amount, @bps, ret2) = {
    ret2!(((amount * bps + 9999) / 10000).toInt())
  } |

  // PSM sell commit: burn the stablecoin, pay the net REV, then update the
  // signed debt. The fee stays in the REV purse because only revOut leaves.
  contract psmSellCommit(@amount, @revOut, @feeRev, @st, payment, revFacet, ret2) = {
    new bCh, wCh, depCh in {
      Stablecoin!("burn", *payment, amount, *psmBurnAuth, *bCh) |
      for (@b <- bCh) {
        match b {
          (true, _, _) => {
            @psmRevPurse!("withdraw", (revBrand, revOut), *wCh) |
            for (@w <- wCh) {
              match w {
                (true, revPayment) => {
                  revFacet!("deposit", revPayment, *depCh) |
                  for (@dep <- depCh) {
                    match dep {
                      (true, _) => {
                        for (@s2 <- psmState) {
                          if (s2.get("rev") != st.get("rev")) { ret2!(1 / 0) }
                          else {
                            psmState!(s2.set("stableDebt",
                              s2.get("stableDebt") - amount)
                              .set("rev", s2.get("rev") + 1)) |
                            ret2!((true, revOut, feeRev))
                          }
                        }
                      }
                      _ => { ret2!(1 / 0) }
                    }
                  }
                }
                _ => { ret2!(1 / 0) }
              }
            }
          }
          _ => { ret2!((false, "burn", *payment)) }
        }
      }
    }
  } |

  // PSM buy commit: deposit the full REV, mint only the net stablecoin, then
  // update the signed debt. The fee is retained as extra REV backing.
  contract psmBuyCommit(@stableOut, @fee, @st, payment, stableFacet, ret2) = {
    new dCh, mCh, depCh in {
      @psmRevPurse!("deposit", *payment, *dCh) |
      for (@d <- dCh) {
        match d {
          (true, _) => {
            Stablecoin!("mint", stableOut, *psmMintAuth, *mCh) |
            for (@m <- mCh) {
              match m {
                (true, stablePayment, _) => {
                  stableFacet!("deposit", stablePayment, *depCh) |
                  for (@dep <- depCh) {
                    match dep {
                      (true, _) => {
                        for (@s2 <- psmState) {
                          if (s2.get("rev") != st.get("rev")) { ret2!(1 / 0) }
                          else {
                            psmState!(s2.set("stableDebt",
                              s2.get("stableDebt") + stableOut)
                              .set("rev", s2.get("rev") + 1)) |
                            ret2!((true, stableOut, fee))
                          }
                        }
                      }
                      _ => { ret2!(1 / 0) }
                    }
                  }
                }
                _ => { ret2!(1 / 0) }
              }
            }
          }
          _ => { ret2!((false, "deposit", *payment)) }
        }
      }
    }
  } |

  // Canonical params values in the v2 order, from a params map.
  contract paramsValues(@p, ret2) = {
    ret2!([currency,
           p.get("mcrBps").toString(),
           p.get("bonusBps").toString(),
           p.get("closeFactorBps").toString(),
           p.get("ratePerBlock").toString(),
           p.get("debtCeiling").toString(),
           p.get("minDebt").toString(),
           p.get("maxDebt").toString(),
           p.get("maxOracleAge").toString(),
           p.get("savingsShareBps").toString(),
           p.get("psmFeeBps").toString()])
  } |

  contract vaultAccountFactory(ret2) = {
    new rCh, aCh in {
      rl!(`__ROOT_URI__`, *rCh) |
      for (Root <- rCh) {
        Root!("resolve", "component:account-factory", 1, *aCh) |
        for (@(true, afUri, v) <- aCh) {
          new ac in {
            rl!(afUri, *ac) |
            for (AccountFactory <- ac) { ret2!(*AccountFactory) }
          }
        }
      }
    }
  } |

  contract vaultUpdate(@s, @ownerId, @vault, @td, @ti, @tc, @bd, @rev, ret2) = {
    match s.get("vaults").set(ownerId, vault) {
      vaults => {
        match s.set("vaults", vaults) {
          s1 => {
            match s1.set("totalDebt", td) {
              s2 => {
                match s2.set("totalAccruedInterest", ti) {
                  s3 => {
                    match s3.set("totalCollateral", tc) {
                      s4 => {
                        match s4.set("badDebt", bd) {
                          s5 => { ret2!(s5.set("rev", rev)) }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  // Write-off commit: book the cumulative badDebt memo, add the shortfall to
  // the buffer's outstanding sin and let cover burn min(surplus, sin), then
  // clear the vault and totals. A rev mismatch after cover fails the deploy so
  // the cover burn and the vault write roll back together.
  contract vaultWriteOff(@s2, @v2, @ownerId, @now2, @accrued, @amount, @seized,
                         paymentOut, ret2) = {
    new coverCh, nsCh in {
      SurplusBuffer!("cover", accrued - amount, *bufferCoverAuth, *coverCh) |
      for (@cv <- coverCh) {
        match cv {
          (true, cancelled, sinOut) => {
            vaultUpdate!(s2, ownerId, {
              "auth": v2.get("auth"),
              "collateral": 0,
              "debt": 0,
              "lastHeight": now2
            }, s2.get("totalDebt") - v2.get("debt"),
            s2.get("totalAccruedInterest") + (accrued - v2.get("debt")),
            s2.get("totalCollateral") - seized,
            s2.get("badDebt") + (accrued - amount),
            s2.get("rev") + 1, *nsCh) |
            for (@ns <- nsCh) {
              for (@s3 <- vaultState) {
                if (s3.get("rev") != s2.get("rev")) { ret2!(1 / 0) }
                else {
                  vaultState!(ns) |
                  ret2!((true, paymentOut, {
                    "repaid": amount,
                    "seized": seized,
                    "badDebt": accrued - amount,
                    "cancelled": cancelled,
                    "sin": sinOut
                  }))
                }
              }
            }
          }
          _ => { ret2!(1 / 0) }
        }
      }
    }
  } |

  // Effect-then-commit liquidation: burn the liquidator's stablecoin, seize REV
  // from custody, then write the vault and totals in one cell update. Any
  // refusal aborts the deploy, so a half-settled liquidation cannot persist.
  contract vaultLiquidateCommit(@s, @v, @ownerId, @now2, @accrued, @amount,
                                @seized, @writeOff, payment, ret2) = {
    new burnCh, wdCh, nsCh in {
      for (@s2 <<- vaultState) {
        match s2.get("vaults").get(ownerId) {
          Nil => { ret2!(1 / 0) }
          v2 => {
            if (v2.get("auth") != v.get("auth") || s2.get("rev") != s.get("rev")) {
              ret2!(1 / 0)
            } else {
              Stablecoin!("burn", *payment, amount, *burnAuth, *burnCh) |
              for (@b <- burnCh) {
                match b {
                  (true, burned, supply) => {
                    CollateralCustody!("withdraw", seized, *custodyAuth, *wdCh) |
                    for (@w <- wdCh) {
                      match w {
                        (true, paymentOut) => {
                          if (writeOff == true) {
                            vaultWriteOff!(s2, v2, ownerId, now2, accrued, amount,
                                           seized, paymentOut, *ret2)
                          } else {
                            vaultUpdate!(s2, ownerId, {
                              "auth": v2.get("auth"),
                              "collateral": v2.get("collateral") - seized,
                              "debt": accrued - amount,
                              "lastHeight": now2
                            }, s2.get("totalDebt") + (accrued - v2.get("debt")) - amount,
                            s2.get("totalAccruedInterest") + (accrued - v2.get("debt")),
                            s2.get("totalCollateral") - seized,
                            s2.get("badDebt"),
                            s2.get("rev") + 1, *nsCh) |
                            for (@ns <- nsCh) {
                              for (@s3 <- vaultState) {
                                if (s3.get("rev") != s2.get("rev")) { ret2!(1 / 0) }
                                else {
                                  vaultState!(ns) |
                                  ret2!((true, paymentOut, {
                                    "repaid": amount,
                                    "seized": seized,
                                    "badDebt": 0
                                  }))
                                }
                              }
                            }
                          }
                        }
                        _ => { ret2!(1 / 0) }
                      }
                    }
                  }
                  _ => { ret2!(1 / 0) }
                }
              }
            }
          }
        }
      }
    }
  } |

  // Repay commit: settle the measured payment (burn principal, deposit interest),
  // absorb outstanding sin against the new surplus, pay the savings share, then
  // write the vault and totals once. Every step is in the same deploy; a rev
  // mismatch fails the deploy so the burn and transfers roll back together.
  contract repayCommit(@s, @v, @ownerId, @now2, @accrued, @amount,
                       @interestPaid, @principalPaid, payment, ret2) = {
    new settleCh, coverCh, payCh in {
      Stablecoin!("settle", *payment, principalPaid, interestPaid,
                  *settlementAuth, *settleCh) |
      for (@st <- settleCh) {
        match st {
          (true, p, i) => {
            SurplusBuffer!("cover", 0, *bufferCoverAuth, *coverCh) |
            for (@cv <- coverCh) {
              match cv {
                (true, cancelled, sinOut) => {
                  SurplusBuffer!("paySavings", *bufferPayAuth, *payCh) |
                  for (@pv <- payCh) {
                    match pv {
                      (true, moved, left) => {
                        for (@s2 <- vaultState) {
                          match s2.get("vaults").get(ownerId) {
                            Nil => { ret2!(1 / 0) }
                            v2 => {
                              if (v2.get("auth") != v.get("auth")
                                  || s2.get("rev") != s.get("rev")) {
                                ret2!(1 / 0)
                              } else {
                                new nsCh in {
                                  vaultUpdate!(s2, ownerId, {
                                    "auth": v2.get("auth"),
                                    "collateral": v2.get("collateral"),
                                    "debt": accrued - amount,
                                    "lastHeight": now2
                                  }, s2.get("totalDebt")
                                     + (accrued - v2.get("debt")) - amount,
                                  s2.get("totalAccruedInterest")
                                     + (accrued - v2.get("debt")) - interestPaid,
                                  s2.get("totalCollateral"),
                                  s2.get("badDebt"),
                                  s2.get("rev") + 1, *nsCh) |
                                  for (@ns <- nsCh) {
                                    vaultState!(ns) |
                                    ret2!((true, {
                                      "debt": accrued - amount,
                                      "repaid": amount,
                                      "principalPaid": principalPaid,
                                      "interestPaid": interestPaid,
                                      "cancelled": cancelled,
                                      "savingsPaid": moved
                                    }))
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                      _ => { ret2!(1 / 0) }
                    }
                  }
                }
                _ => { ret2!(1 / 0) }
              }
            }
          }
          _ => { ret2!(st) }
        }
      }
    }
  } |

  // Mint commit: revalidate the vault and the buffer halt after the price and
  // health work, write the vault and totals, then mint. A mint refusal fails the
  // deploy so the vault update rolls back.
  contract vaultMintCommit(@s, @v, @ownerId, @now2, @accrued, @amount, ret2) = {
    new payCh, nsCh in {
      for (@s2 <- vaultState; @b2 <- bufferState) {
        match s2.get("vaults").get(ownerId) {
          Nil => { ret2!(1 / 0) }
          v2 => {
            if (v2.get("auth") != v.get("auth")
                || s2.get("rev") != s.get("rev")
                || s2.get("paused")) {
              ret2!(1 / 0)
            } else {
              if (b2.get("sin") > b2.get("surplus")) {
                ret2!((false, "recapitalise"))
              } else {
                vaultUpdate!(s2, ownerId, {
                  "auth": v2.get("auth"),
                  "collateral": v2.get("collateral"),
                  "debt": accrued + amount,
                  "lastHeight": now2
                }, s2.get("totalDebt") + (accrued - v2.get("debt")) + amount,
                s2.get("totalAccruedInterest") + (accrued - v2.get("debt")),
                s2.get("totalCollateral"),
                s2.get("badDebt"),
                s2.get("rev") + 1, *nsCh) |
                for (@ns <- nsCh) {
                  Stablecoin!("mint", amount, *mintAuth, *payCh) |
                  for (@p <- payCh) {
                    match p {
                      (true, payment, supply) => {
                        vaultState!(ns) |
                        ret2!((true, payment, accrued + amount))
                      }
                      _ => { ret2!(1 / 0) }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  currencyCh!("__CURRENCY__") |
  paramsCh!(__PARAMS__) |
  paramsHashCh!("__PARAMS_HASH__") |
  sponsorCh!("__SPONSOR_PUB__") |
  for (@currency <- currencyCh; @params <- paramsCh;
       @paramsHash <- paramsHashCh; @sponsorHex <- sponsorCh) {
    stablecoinCheck!(currency, params, paramsHash, sponsorHex,
                     "__SPONSOR_SIG__".hexToBytes(), *checkCh) |
    for (@check <- checkCh) {
      match check {
        (true, Nil) => {
          rl!(`rho:rchain:ertp`, *ertpCh) |
          for (@(_, ERTP) <- ertpCh) {
            @ERTP!("makeIssuerKit", *kitCh) |
            @ERTP!("getRevIssuer", *revIssuerCh) |
            for (@(brand, mint, issuer) <- kitCh; @(revBrand, revIssuer) <- revIssuerCh) {
              @issuer!("makeEmptyPurse", *burnPurseCh) |
              @issuer!("makeEmptyPurse", *savingsPurseCh) |
              @issuer!("makeEmptyPurse", *bufferPurseCh) |
              @revIssuer!("makeEmptyPurse", *revPurseCh) |
              @revIssuer!("makeEmptyPurse", *psmRevPurseCh) |
              for (@(true, burnPurse) <- burnPurseCh; @(true, revPurse) <- revPurseCh;
                   @(true, savingsPurse) <- savingsPurseCh;
                   @(true, bufferPurse) <- bufferPurseCh;
                   @(true, psmRevPurse) <- psmRevPurseCh) {
                @burnPurse!("getDepositFacet", *burnFacetCh) |
                for (@(true, burnFacet) <- burnFacetCh) {
                  bd!(*nowCh) |
                  for (@now, @sender, @ts <- nowCh) {
  contract Stablecoin(@"brand", ret2) = {
    ret2!((true, brand))
  } |

  contract Stablecoin(@"issuer", ret2) = {
    ret2!((true, issuer))
  } |

  contract Stablecoin(@"supply", ret2) = {
    for (@s <<- issuerState) { ret2!((true, s.get("totalPrincipal"))) }
  } |

  contract Stablecoin(@"mint", @amount, @auth, ret2) = {
    if (auth != *mintAuth && auth != *psmMintAuth) { ret2!((false, "bad mint authority")) }
    else {
      if (amount <= 0) { ret2!((false, "amount")) }
      else {
        for (@s <<- issuerState; @b <<- bufferState) {
          if (b.get("sin") > b.get("surplus")) {
            ret2!((false, "recapitalise"))
          } else {
          if (s.get("totalPrincipal") + amount > s.get("maxSupply")) {
            ret2!((false, "max supply"))
          } else {
            for (@s2 <- issuerState; @b2 <- bufferState) {
              if (s2.get("totalPrincipal") != s.get("totalPrincipal")) {
                issuerState!(s2) | ret2!((false, "changed"))
              } else {
                if (b2.get("sin") > b2.get("surplus")) {
                  issuerState!(s2) | ret2!((false, "recapitalise"))
                } else {
                  new payCh in {
                    @mint!("mintPayment", (brand, amount), *payCh) |
                    for (@p <- payCh) {
                      match p {
                        (true, payment) => {
                          issuerState!(s2.set("totalPrincipal",
                            s2.get("totalPrincipal") + amount)) |
                          ret2!((true, payment, s2.get("totalPrincipal") + amount))
                        }
                        _ => { ret2!(1 / 0) }
                      }
                    }
                  }
                }
              }
            }
          }
          }
        }
      }
    }
  } |

  contract Stablecoin(@"burn", payment, @maxAmount, @auth, ret2) = {
    if (auth != *burnAuth && auth != *psmBurnAuth) { ret2!((false, "bad burn authority")) }
    else {
      new amtCh in {
        @issuer!("getAmountOf", *payment, *amtCh) |
        for (@a <- amtCh) {
          match a {
            (true, amount) => {
              if (amount <= 0 || amount > maxAmount) { ret2!((false, "amount")) }
              else {
                for (@s <<- issuerState) {
                  if (s.get("totalPrincipal") < amount) {
                    ret2!((false, "supply"))
                  } else {
                    for (@s2 <- issuerState) {
                      if (s2.get("totalPrincipal") != s.get("totalPrincipal")) {
                        issuerState!(s2) | ret2!((false, "changed"))
                      } else {
                        new depCh in {
                          @burnFacet!("deposit", *payment, *depCh) |
                          for (@d <- depCh) {
                            match d {
                              (true, bal) => {
                                issuerState!(s2.set("totalPrincipal",
                                  s2.get("totalPrincipal") - amount)) |
                                ret2!((true, amount, s2.get("totalPrincipal") - amount))
                              }
                              _ => { ret2!(1 / 0) }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
            _ => { ret2!((false, "not a stablecoin payment")) }
          }
        }
      }
    }
  } |

  contract Stablecoin(@"settle", payment, @principal, @interest, @auth, ret2) = {
    if (auth != *settlementAuth) { ret2!((false, "bad settlement authority", *payment)) }
    else {
      if (principal < 0 || interest < 0) { ret2!((false, "amount", *payment)) }
      else {
        new amtCh, sCh in {
          @issuer!("getAmountOf", *payment, *amtCh) |
          for (@a <- amtCh) {
            match a {
              (true, total) => {
                if (total != principal + interest) {
                  ret2!((false, "amount", *payment))
                } else {
                  if (principal == 0) {
                    SurplusBuffer!("deposit", *payment, *bufferDepositAuth, *sCh) |
                    for (@s <- sCh) {
                      match s {
                        (true, _) => { ret2!((true, 0, interest)) }
                        _ => { ret2!(s) }
                      }
                    }
                  } else {
                    if (interest == 0) {
                      new bCh in {
                        Stablecoin!("burn", *payment, principal, *burnAuth, *bCh) |
                        for (@b <- bCh) {
                          match b {
                            (true, _, _) => { ret2!((true, principal, 0)) }
                            _ => { ret2!(b) }
                          }
                        }
                      }
                    } else {
                      new pCh, dCh, wpCh, wiCh, bCh in {
                        @issuer!("makeEmptyPurse", *pCh) |
                        for (@(true, purse) <- pCh) {
                          @purse!("deposit", *payment, *dCh) |
                          for (@(true, _) <- dCh) {
                            @purse!("withdraw", (brand, principal), *wpCh) |
                            for (@(true, principalPay) <- wpCh) {
                              @purse!("withdraw", (brand, interest), *wiCh) |
                              for (@(true, interestPay) <- wiCh) {
                                Stablecoin!("burn", principalPay, principal, *burnAuth, *bCh) |
                                for (@b <- bCh) {
                                  match b {
                                    (true, _, _) => {
                                      SurplusBuffer!("deposit", interestPay,
                                                     *bufferDepositAuth, *sCh) |
                                      for (@s <- sCh) {
                                        match s {
                                          (true, _) => { ret2!((true, principal, interest)) }
                                          _ => { ret2!(1 / 0) }
                                        }
                                      }
                                    }
                                    _ => { ret2!(1 / 0) }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
              _ => { ret2!((false, "asset", *payment)) }
            }
          }
        }
      }
    }
  } |

  contract Stablecoin(@"amountOf", payment, ret2) = {
    @issuer!("getAmountOf", *payment, *ret2)
  } |

  contract Stablecoin(@"attest", ret2) = {
    ret2!((true, {
      "currency": currency,
      "paramsHash": paramsHash,
      "sponsor": sponsorHex,
      "template": "rcash:stablecoin:v1"
    }))
  } |

  contract CollateralCustody(@"deposit", payment, @auth, ret2) = {
    if (auth != *custodyAuth) { ret2!((false, "bad custody authority")) }
    else {
      new amtCh, depCh in {
        @revIssuer!("getAmountOf", *payment, *amtCh) |
        for (@a <- amtCh) {
          match a {
            (true, amount) => {
              @revPurse!("deposit", *payment, *depCh) |
              for (@d <- depCh) {
                match d {
                  (true, bal) => { ret2!((true, amount)) }
                  _ => { ret2!(1 / 0) }
                }
              }
            }
            _ => { ret2!((false, "not a REV payment")) }
          }
        }
      }
    }
  } |

  contract CollateralCustody(@"withdraw", @amount, @auth, ret2) = {
    if (auth != *custodyAuth) { ret2!((false, "bad custody authority")) }
    else {
      if (amount <= 0) { ret2!((false, "amount")) }
      else {
        @revPurse!("withdraw", (revBrand, amount), *ret2)
      }
    }
  } |

  contract CollateralCustody(@"balance", ret2) = {
    @revPurse!("getCurrentAmount", *ret2)
  } |

  contract CollateralCustody(@"attest", ret2) = {
    ret2!((true, {
      "currency": currency,
      "kind": "rev",
      "template": "rcash:collateral-custody:v1"
    }))
  } |

  contract RiskParameters(@"params", ret2) = {
    for (@s <<- paramsState) { ret2!((true, s.get("params"))) }
  } |

  contract RiskParameters(@"info", ret2) = {
    for (@s <<- paramsState) {
      ret2!((true, {"params": s.get("params"), "paramsHash": paramsHash,
                    "currentHash": s.get("hash"), "genesis": params,
                    "rev": s.get("rev")}))
    }
  } |

  contract RiskParameters(@"scheduleParams", @newParams, @nonce, @sigs, ret2) = {
    new boundsCapCh, bzCh, pvCh, codecCh, argsCh, govCh, sCh in {
      vaultBounds!(*boundsCapCh) |
      for (Bounds <- boundsCapCh) {
        Bounds!("checkIssuer", newParams, *bzCh) |
        for (@bz <- bzCh) {
          match bz {
            (true, Nil) => {
              paramsValues!(newParams, *pvCh) |
              for (@values <- pvCh) {
                vaultCodec!(*codecCh) |
                for (Codec <- codecCh) {
                  Codec!("canonical", "rcash:stablecoin-params:v2", values, *argsCh) |
                  for (@argsHash <- argsCh) {
                    vaultGovernor!(*govCh) |
                    for (Governor <- govCh) {
                      Governor!("schedule", "stablecoin:" ++ currency, nonce,
                                "setRiskParams", argsHash, newParams, sigs, *sCh) |
                      for (@gv <- sCh) {
                        match gv {
                          (true, readyAt) => { ret2!((true, readyAt, argsHash)) }
                          _ => { ret2!(gv) }
                        }
                      }
                    }
                  }
                }
              }
            }
            _ => { ret2!(bz) }
          }
        }
      }
    }
  } |

  contract RiskParameters(@"applyParams", @nonce, ret2) = {
    new govCh, eCh, pvCh, codecCh, canCh, hashCh, boundsCh, bzCh in {
      vaultGovernor!(*govCh) |
      for (Governor <- govCh) {
        Governor!("execute", "stablecoin:" ++ currency, nonce, *eCh) |
        for (@ex <- eCh) {
          match ex {
            (true, action, argsHash, args) => {
              if (action != "setRiskParams") { ret2!((false, "action")) }
              else {
                paramsValues!(args, *pvCh) |
                for (@values <- pvCh) {
                  vaultCodec!(*codecCh) |
                  for (Codec <- codecCh) {
                    Codec!("canonical", "rcash:stablecoin-params:v2", values, *canCh) |
                    for (@canonical <- canCh) {
                      if (canonical != argsHash) { ret2!((false, "params hash")) }
                      else {
                        vaultBounds!(*boundsCh) |
                        for (Bounds <- boundsCh) {
                          Bounds!("checkIssuer", args, *bzCh) |
                          for (@bz <- bzCh) {
                            match bz {
                              (true, Nil) => {
                                Codec!("hash", "rcash:stablecoin-params:v2", values, *hashCh) |
                                for (@h <- hashCh) {
                                  for (@s <- paramsState) {
                                    paramsState!(s.set("params", args).set("hash", h)
                                      .set("rev", s.get("rev") + 1)) |
                                    ret2!((true, {"params": args, "currentHash": h}))
                                  }
                                }
                              }
                              _ => { ret2!(bz) }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
            _ => { ret2!(ex) }
          }
        }
      }
    }
  } |

  contract RiskParameters(@"attest", ret2) = {
    ret2!((true, {
      "currency": currency,
      "paramsHash": paramsHash,
      "sponsor": sponsorHex,
      "template": "rcash:risk-params:v1"
    }))
  } |

  contract VaultBook(@"open", @ownerId, @proof, ret2) = {
    new afCh, vCh, nowCh2 in {
      vaultAccountFactory!(*afCh) |
      for (AccountFactory <- afCh) {
        AccountFactory!("verify", ownerId, proof, *vCh) |
        for (@vr <- vCh) {
          match vr {
            (true, true) => {
              for (@s <<- vaultState) {
                match s.get("vaults").get(ownerId) {
                  Nil => {
                    vaultNow!(*nowCh2) |
                    for (@now2 <- nowCh2) {
                      for (@s2 <- vaultState) {
                        match s2.get("vaults").get(ownerId) {
                          Nil => {
                            new auth in {
                              vaultState!(s2.set("vaults",
                                s2.get("vaults").set(ownerId, {
                                  "auth": *auth,
                                  "collateral": 0,
                                  "debt": 0,
                                  "lastHeight": now2
                                }))) |
                              ret2!((true, *auth))
                            }
                          }
                          existing => {
                            vaultState!(s2) |
                            match existing.get("auth") { a => { ret2!((true, a)) } }
                          }
                        }
                      }
                    }
                  }
                  existing => {
                    match existing.get("auth") { a => { ret2!((true, a)) } }
                  }
                }
              }
            }
            (true, false) => { ret2!((false, "not owner")) }
            _ => { ret2!((false, "verify failed")) }
          }
        }
      }
    }
  } |

  contract VaultBook(@"deposit", @ownerId, @auth, payment, ret2) = {
    for (@s <<- vaultState; @ps <- paramsState) {
      match s.get("vaults").get(ownerId) {
        Nil => { ret2!((false, "no vault")) }
        v => {
          if (v.get("auth") != auth) { ret2!((false, "bad vault auth")) }
          else {
            new cCh, nowCh2, accCh, mathCh in {
              CollateralCustody!("deposit", *payment, *custodyAuth, *cCh) |
              for (@c <- cCh) {
                match c {
                  (true, amount) => {
                    vaultNow!(*nowCh2) |
                    for (@now2 <- nowCh2) {
                      vaultMath!(*mathCh) |
                      for (CollateralMath <- mathCh) {
                        CollateralMath!("accrue", v.get("debt"), v.get("lastHeight"),
                                        now2, ps.get("params").get("ratePerBlock"), *accCh) |
                        for (@accrued <- accCh) {
                          for (@s2 <- vaultState) {
                            match s2.get("vaults").get(ownerId) {
                              Nil => { ret2!(1 / 0) }
                              v2 => {
                                if (v2.get("auth") != auth
                                    || s2.get("rev") != s.get("rev")) {
                                  ret2!(1 / 0)
                                } else {
                                  new nsCh in {
                                    vaultUpdate!(s2, ownerId, {
                                      "auth": v2.get("auth"),
                                      "collateral": v2.get("collateral") + amount,
                                      "debt": accrued,
                                      "lastHeight": now2
                                    }, s2.get("totalDebt") + (accrued - v2.get("debt")),
                                    s2.get("totalAccruedInterest") + (accrued - v2.get("debt")),
                                    s2.get("totalCollateral") + amount,
                                    s2.get("badDebt"),
                                    s2.get("rev") + 1, *nsCh) |
                                    for (@ns <- nsCh) {
                                      vaultState!(ns) |
                                      ret2!((true, {"collateral": v2.get("collateral") + amount,
                                                    "debt": accrued}))
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                  _ => { ret2!((false, "custody")) }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract VaultBook(@"mint", @ownerId, @auth, @amount, ret2) = {
    if (amount <= 0) { ret2!((false, "amount")) }
    else {
      for (@s <<- vaultState; @ps <- paramsState) {
        if (s.get("paused")) { ret2!((false, "paused")) }
        else {
          match s.get("vaults").get(ownerId) {
            Nil => { ret2!((false, "no vault")) }
            v => {
              if (v.get("auth") != auth) { ret2!((false, "bad vault auth")) }
              else {
                new nowCh2, rateCh, accCh, hCh, mathCh, payCh in {
                  vaultNow!(*nowCh2) |
                  vaultPrice!(currency, ps.get("params").get("maxOracleAge"), *rateCh) |
                  for (@now2 <- nowCh2; @rr <- rateCh) {
                    match rr {
                      (rate, fresh) => {
                        if (fresh == false) { ret2!((false, "stale feed")) }
                        else {
                          if (rate <= 0) { ret2!((false, "no rate")) }
                          else {
                            vaultMath!(*mathCh) |
                            for (CollateralMath <- mathCh) {
                              CollateralMath!("accrue", v.get("debt"), v.get("lastHeight"),
                                              now2, ps.get("params").get("ratePerBlock"), *accCh) |
                              for (@accrued <- accCh) {
                                if (accrued + amount < ps.get("params").get("minDebt")) {
                                  ret2!((false, "min debt"))
                                } else {
                                  if (accrued + amount > ps.get("params").get("maxDebt")) {
                                    ret2!((false, "max debt"))
                                  } else {
                                    if (s.get("totalDebt") + (accrued - v.get("debt"))
                                        + amount > ps.get("params").get("debtCeiling")) {
                                      ret2!((false, "ceiling"))
                                    } else {
                                      CollateralMath!("health", v.get("collateral"),
                                                      accrued + amount, rate,
                                                      ps.get("params").get("mcrBps"), *hCh) |
                                      for (@healthy <- hCh) {
                                        if (healthy) {
                                          vaultMintCommit!(s, v, ownerId, now2,
                                                           accrued, amount, *ret2)
                                        } else { ret2!((false, "below MCR")) }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract VaultBook(@"withdraw", @ownerId, @auth, @amount, ret2) = {
    if (amount <= 0) { ret2!((false, "amount")) }
    else {
      for (@s <<- vaultState; @ps <- paramsState) {
        match s.get("vaults").get(ownerId) {
          Nil => { ret2!((false, "no vault")) }
          v => {
            if (s.get("paused")) { ret2!((false, "paused")) }
            else {
            if (v.get("auth") != auth) { ret2!((false, "bad vault auth")) }
            else {
              if (v.get("collateral") < amount) { ret2!((false, "amount")) }
              else {
                new nowCh2, rateCh, accCh, hCh, mathCh, payCh in {
                  vaultNow!(*nowCh2) |
                  vaultPrice!(currency, ps.get("params").get("maxOracleAge"), *rateCh) |
                  for (@now2 <- nowCh2; @rr <- rateCh) {
                    match rr {
                      (rate, fresh) => {
                        if (fresh == false) { ret2!((false, "stale feed")) }
                        else {
                          if (rate <= 0) { ret2!((false, "no rate")) }
                          else {
                            vaultMath!(*mathCh) |
                            for (CollateralMath <- mathCh) {
                              CollateralMath!("accrue", v.get("debt"), v.get("lastHeight"),
                                              now2, ps.get("params").get("ratePerBlock"), *accCh) |
                              for (@accrued <- accCh) {
                                CollateralMath!("health", v.get("collateral") - amount,
                                                accrued, rate, ps.get("params").get("mcrBps"), *hCh) |
                                for (@healthy <- hCh) {
                                  if (healthy) {
                                    for (@s2 <- vaultState) {
                                      match s2.get("vaults").get(ownerId) {
                                        Nil => { ret2!(1 / 0) }
                                        v2 => {
                                          if (v2.get("auth") != auth
                                              || s2.get("rev") != s.get("rev")) {
                                            ret2!(1 / 0)
                                          } else {
                                            new nsCh in {
                                              vaultUpdate!(s2, ownerId, {
                                                "auth": v2.get("auth"),
                                                "collateral": v2.get("collateral") - amount,
                                                "debt": accrued,
                                                "lastHeight": now2
                                              }, s2.get("totalDebt") + (accrued - v2.get("debt")),
                                              s2.get("totalAccruedInterest") + (accrued - v2.get("debt")),
                                              s2.get("totalCollateral") - amount,
                                              s2.get("badDebt"),
                                              s2.get("rev") + 1, *nsCh) |
                                              for (@ns <- nsCh) {
                                                CollateralCustody!("withdraw", amount, *custodyAuth, *payCh) |
                                                for (@p <- payCh) {
                                                  match p {
                                                    (true, payment) => { vaultState!(ns) | ret2!((true, payment)) }
                                                    _ => { ret2!(1 / 0) }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  } else { ret2!((false, "below MCR")) }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    }
  } |

  contract VaultBook(@"repay", @ownerId, @auth, payment, ret2) = {
    for (@s <<- vaultState; @ps <- paramsState) {
      match s.get("vaults").get(ownerId) {
        Nil => { ret2!((false, "no vault")) }
        v => {
          if (v.get("auth") != auth) { ret2!((false, "bad vault auth")) }
          else {
            new amtCh, nowCh2, accCh, mathCh in {
              Stablecoin!("amountOf", payment, *amtCh) |
              for (@a <- amtCh) {
                match a {
                  (true, amount) => {
                    if (amount <= 0) { ret2!((false, "amount", *payment)) }
                    else {
                      vaultNow!(*nowCh2) |
                      for (@now2 <- nowCh2) {
                        vaultMath!(*mathCh) |
                        for (CollateralMath <- mathCh) {
                          CollateralMath!("accrue", v.get("debt"), v.get("lastHeight"),
                                          now2, ps.get("params").get("ratePerBlock"), *accCh) |
                          for (@accrued <- accCh) {
                            if (amount > accrued) {
                              ret2!((false, "amount", *payment))
                            } else {
                              if (accrued - amount > 0
                                  && accrued - amount < ps.get("params").get("minDebt")) {
                                ret2!((false, "min debt", *payment))
                              } else {
                                match (accrued - v.get("debt")) {
                                  interestDue => {
                                    if (amount <= interestDue) {
                                      repayCommit!(s, v, ownerId, now2, accrued, amount,
                                                   amount, 0, *payment, *ret2)
                                    } else {
                                      repayCommit!(s, v, ownerId, now2, accrued, amount,
                                                   interestDue, amount - interestDue,
                                                   *payment, *ret2)
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                  _ => { ret2!((false, "asset", *payment)) }
                }
              }
            }
          }
        }
      }
    }
  } |

  // Permissionless liquidation. The only authority is the liquidation cap held by
  // LiquidationEngine. A liquidator burns stablecoin and receives REV at the
  // accrual-consistent price plus the bonus, bounded by the close factor. If the
  // vault cannot cover the bonus slice, it may be cleared only by repaying at
  // least the collateral's value; the uncovered residual is written to badDebt.
  contract VaultBook(@"liquidate", @ownerId, @auth, payment, @minCollateral, ret2) = {
    if (auth != *liquidationAuth) { ret2!((false, "bad liquidation authority", *payment)) }
    else {
      new amtCh in {
        Stablecoin!("amountOf", *payment, *amtCh) |
        for (@a <- amtCh) {
          match a {
            (true, amount) => {
              if (amount <= 0) { ret2!((false, "amount", *payment)) }
              else {
                for (@s <<- vaultState; @ps <- paramsState) {
                  match s.get("vaults").get(ownerId) {
                    Nil => { ret2!((false, "no vault", *payment)) }
                    v => {
                      new nowCh2, rateCh, accCh, mathCh in {
                        vaultNow!(*nowCh2) |
                        vaultPrice!(currency, ps.get("params").get("maxOracleAge"), *rateCh) |
                        for (@now2 <- nowCh2; @rr <- rateCh) {
                          match rr {
                            (rate, fresh) => {
                              if (fresh == false) { ret2!((false, "stale feed", *payment)) }
                              else {
                                if (rate <= 0) { ret2!((false, "no rate", *payment)) }
                                else {
                                  vaultMath!(*mathCh) |
                                  for (CollateralMath <- mathCh) {
                                    CollateralMath!("accrue", v.get("debt"), v.get("lastHeight"),
                                                    now2, ps.get("params").get("ratePerBlock"), *accCh) |
                                    for (@accrued <- accCh) {
                                      new hCh, pCh in {
                                        CollateralMath!("health", v.get("collateral"), accrued,
                                                        rate, ps.get("params").get("mcrBps"), *hCh) |
                                        for (@healthy <- hCh) {
                                          if (healthy) { ret2!((false, "healthy", *payment)) }
                                          else {
                                            match ((accrued * ps.get("params").get("closeFactorBps") + 9999) / 10000).toInt() {
                                              maxRepay => {
                                                if (amount > maxRepay) {
                                                  ret2!((false, "close factor", *payment))
                                                } else {
                                                  CollateralMath!("payout", amount,
                                                                  ps.get("params").get("bonusBps"),
                                                                  rate, *pCh) |
                                                  for (@seized0 <- pCh) {
                                                    if (seized0 <= v.get("collateral")) {
                                                      if (seized0 < minCollateral) {
                                                        ret2!((false, "slippage", *payment))
                                                      } else {
                                                        vaultLiquidateCommit!(s, v, ownerId, now2,
                                                          accrued, amount, seized0, false,
                                                          *payment, *ret2)
                                                      }
                                                    } else {
                                                      if (amount * 100000000 < v.get("collateral") * rate) {
                                                        ret2!((false, "underwater repayment", *payment))
                                                      } else {
                                                        if (v.get("collateral") < minCollateral) {
                                                          ret2!((false, "slippage", *payment))
                                                        } else {
                                                          vaultLiquidateCommit!(s, v, ownerId, now2,
                                                            accrued, amount, v.get("collateral"), true,
                                                            *payment, *ret2)
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
            _ => { ret2!((false, "not a stablecoin payment", *payment)) }
          }
        }
      }
    }
  } |

  contract VaultBook(@"vault", @ownerId, ret2) = {
    for (@s <<- vaultState; @ps <- paramsState) {
      match s.get("vaults").get(ownerId) {
        Nil => { ret2!((false, "no vault")) }
        v => {
          new nowCh2, rateCh, hCh, mathCh, accCh in {
            vaultNow!(*nowCh2) |
            vaultPrice!(currency, ps.get("params").get("maxOracleAge"), *rateCh) |
            for (@now2 <- nowCh2; @rr <- rateCh) {
              match rr {
                (rate, fresh) => {
                  vaultMath!(*mathCh) |
                  for (CollateralMath <- mathCh) {
                    CollateralMath!("accrue", v.get("debt"), v.get("lastHeight"),
                                    now2, ps.get("params").get("ratePerBlock"), *accCh) |
                    for (@accrued <- accCh) {
                      CollateralMath!("health", v.get("collateral"), accrued,
                                      rate, ps.get("params").get("mcrBps"), *hCh) |
                      for (@healthy <- hCh) {
                        ret2!((true, {
                          "ownerId": ownerId,
                          "collateral": v.get("collateral"),
                          "debt": accrued,
                          "storedDebt": v.get("debt"),
                          "accruedInterest": accrued - v.get("debt"),
                          "lastHeight": v.get("lastHeight"),
                          "health": healthy,
                          "fresh": fresh,
                          "rate": rate
                        }))
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract VaultBook(@"vaults", ret2) = {
    for (@s <<- vaultState) { ret2!((true, s.get("vaults").keys())) }
  } |

  contract VaultBook(@"totals", ret2) = {
    for (@s <<- vaultState; @p <- psmState; @b <- bufferState) {
      ret2!((true, {
        "totalDebt": s.get("totalDebt"),
        "totalAccruedInterest": s.get("totalAccruedInterest"),
        "totalCollateral": s.get("totalCollateral"),
        "badDebt": s.get("badDebt"),
        "sin": b.get("sin"),
        "psmDebt": p.get("stableDebt"),
        "paused": s.get("paused"),
        "rev": s.get("rev")
      }))
    }
  } |

  contract VaultBook(@"params", ret2) = {
    for (@ps <<- paramsState) { ret2!((true, ps.get("params"))) }
  } |

  contract VaultBook(@"pause", @paused, @nonce, @sigs, ret2) = {
    for (@s <<- vaultState) {
      new gCh, vCh in {
        vaultGovernor!(*gCh) |
        for (Governor <- gCh) {
          Governor!("authorize", "stablecoin:" ++ currency, nonce, "setPaused",
                    paused.toString(), sigs, *vCh) |
          for (@v <- vCh) {
            match v {
              (true, Nil) => {
                for (@s2 <- vaultState) {
                  vaultState!(s2.set("paused", paused).set("rev", s2.get("rev") + 1)) |
                  ret2!((true, Nil))
                }
              }
              _ => { ret2!(v) }
            }
          }
        }
      }
    }
  } |

  contract VaultBook(@"attest", ret2) = {
    ret2!((true, {
      "currency": currency,
      "paramsHash": paramsHash,
      "sponsor": sponsorHex,
      "template": "rcash:stablecoin-vault:v1"
    }))
  } |

  // The engine holds the liquidation cap; the VaultBook keeps the accounting.
  // Anyone may call the engine, but nothing else can act as a liquidator.
  contract LiquidationEngine(@"liquidate", @ownerId, payment, @minCollateral, ret2) = {
    VaultBook!("liquidate", ownerId, *liquidationAuth, *payment, minCollateral, *ret2)
  } |

  contract LiquidationEngine(@"attest", ret2) = {
    ret2!((true, {
      "currency": currency,
      "template": "rcash:liquidation-engine:v1"
    }))
  } |

  contract bufferCancelled(@surplus, @sin, ret) = {
    if (surplus < sin) { ret!(surplus) } else { ret!(sin) }
  } |

  contract callerOwner(dId, ret) = {
    new pkCh, aCh in {
      deployerIdOps!("pubKeyBytes", *dId, *pkCh) |
      for (@pk <- pkCh) {
        revAddress!("fromPublicKey", pk, *aCh) |
        for (@addr <- aCh) { ret!(addr) }
      }
    }
  } |

  contract SavingsPool(@"deposit", dId, payment, ret2) = {
    new oCh, amtCh, dCh, shCh in {
      callerOwner!(*dId, *oCh) |
      for (@ownerId <- oCh) {
        @issuer!("getAmountOf", *payment, *amtCh) |
        for (@a <- amtCh) {
          match a {
            (true, amount) => {
              if (amount <= 0) { ret2!((false, "amount", *payment)) }
              else {
                for (@s <- savingsState) {
                  if (s.get("totalShares") == 0) { shCh!(amount) }
                  else {
                    if (s.get("totalAssets") <= 0) { shCh!(0) }
                    else { shCh!((amount * s.get("totalShares")) / s.get("totalAssets")) }
                  } |
                  for (@shares <- shCh) {
                    if (shares <= 0) {
                      savingsState!(s) | ret2!((false, "shares", *payment))
                    } else {
                      @savingsPurse!("deposit", *payment, *dCh) |
                      for (@d <- dCh) {
                        match d {
                          (true, _) => {
                            new hCh in {
                              match s.get("shares").get(ownerId) {
                                Nil => { hCh!(0) }
                                held => { hCh!(held) }
                              } |
                              for (@held <- hCh) {
                                savingsState!(s.set("totalShares", s.get("totalShares") + shares)
                                  .set("totalAssets", s.get("totalAssets") + amount)
                                  .set("shares", s.get("shares").set(ownerId, held + shares))) |
                                ret2!((true, shares))
                              }
                            }
                          }
                          _ => { savingsState!(s) | ret2!((false, "deposit", *payment)) }
                        }
                      }
                    }
                  }
                }
              }
            }
            _ => { ret2!((false, "asset", *payment)) }
          }
        }
      }
    }
  } |

  contract SavingsPool(@"withdraw", dId, @shares, ret2) = {
    new oCh, amtCh, wCh in {
      callerOwner!(*dId, *oCh) |
      for (@ownerId <- oCh) {
        for (@s <- savingsState) {
          match s.get("shares").get(ownerId) {
            Nil => { savingsState!(s) | ret2!((false, "shares")) }
            held => {
              if (shares <= 0 || shares > held || s.get("totalShares") <= 0
                  || s.get("totalAssets") <= 0) {
                savingsState!(s) | ret2!((false, "shares"))
              } else {
                amtCh!(((s.get("totalAssets") * shares) / s.get("totalShares")).toInt()) |
                for (@amount <- amtCh) {
                  @savingsPurse!("withdraw", (brand, amount), *wCh) |
                  for (@w <- wCh) {
                    match w {
                      (true, payment) => {
                        savingsState!(s.set("totalShares", s.get("totalShares") - shares)
                          .set("totalAssets", s.get("totalAssets") - amount)
                          .set("shares", s.get("shares").set(ownerId, held - shares))) |
                        ret2!((true, payment, amount))
                      }
                      _ => { savingsState!(s) | ret2!((false, "payment")) }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract SavingsPool(@"notify", payment, @auth, ret2) = {
    if (auth != *savingsNotifyAuth) { ret2!((false, "bad savings authority", *payment)) }
    else {
      new amtCh, dCh in {
        @issuer!("getAmountOf", *payment, *amtCh) |
        for (@a <- amtCh) {
          match a {
            (true, amount) => {
              @savingsPurse!("deposit", *payment, *dCh) |
              for (@d <- dCh) {
                match d {
                  (true, _) => {
                    for (@s <- savingsState) {
                      savingsState!(s.set("totalAssets", s.get("totalAssets") + amount).set("rev", s.get("rev") + 1)) |
                      ret2!((true, amount))
                    }
                  }
                  _ => { ret2!((false, "deposit", *payment)) }
                }
              }
            }
            _ => { ret2!((false, "asset", *payment)) }
          }
        }
      }
    }
  } |

  contract SavingsPool(@"info", ret2) = {
    for (@s <<- savingsState) {
      match s.get("totalShares") {
        0 => {
          ret2!((true, {"totalShares": 0, "totalAssets": s.get("totalAssets"),
                        "shareValueE8": 0, "rev": s.get("rev")}))
        }
        ts => {
          ret2!((true, {"totalShares": ts, "totalAssets": s.get("totalAssets"),
                        "shareValueE8":
                          (s.get("totalAssets") * 100000000 / ts).toInt(),
                        "rev": s.get("rev")}))
        }
      }
    }
  } |

  contract SavingsPool(@"position", @ownerId, ret2) = {
    for (@s <<- savingsState) {
      match s.get("shares").get(ownerId) {
        Nil => { ret2!((true, 0)) }
        held => { ret2!((true, held)) }
      }
    }
  } |

  contract SurplusBuffer(@"deposit", payment, @auth, ret2) = {
    if (auth != *bufferDepositAuth) { ret2!((false, "bad buffer authority", *payment)) }
    else {
      new amtCh, dCh in {
        @issuer!("getAmountOf", *payment, *amtCh) |
        for (@a <- amtCh) {
          match a {
            (true, amount) => {
              @bufferPurse!("deposit", *payment, *dCh) |
              for (@d <- dCh) {
                match d {
                  (true, _) => {
                    for (@s <- bufferState) {
                      bufferState!(s.set("surplus", s.get("surplus") + amount).set("rev", s.get("rev") + 1)) |
                      ret2!((true, amount))
                    }
                  }
                  _ => { ret2!((false, "deposit", *payment)) }
                }
              }
            }
            _ => { ret2!((false, "asset", *payment)) }
          }
        }
      }
    }
  } |

  contract SurplusBuffer(@"paySavings", @auth, ret2) = {
    if (auth != *bufferPayAuth) { ret2!((false, "bad buffer authority")) }
    else {
      for (@s <- bufferState) {
        match ((s.get("surplus") * s.get("savingsShareBps")) / 10000).toInt() {
          move => {
            if (move <= 0) { bufferState!(s) | ret2!((true, 0, s.get("surplus"))) }
            else {
              new ssCh in {
                for (@ss <- savingsState) {
                  if (ss.get("totalShares") <= 0) {
                    bufferState!(s) | ret2!((true, 0, s.get("surplus")))
                  } else {
                    new wCh, nCh in {
                      @bufferPurse!("withdraw", (brand, move), *wCh) |
                      for (@w <- wCh) {
                        match w {
                          (true, payment) => {
                            SavingsPool!("notify", payment, *savingsNotifyAuth, *nCh) |
                            for (@n <- nCh) {
                              match n {
                                (true, _) => {
                                  bufferState!(s.set("surplus", s.get("surplus") - move).set("rev", s.get("rev") + 1)) |
                                  ret2!((true, move, s.get("surplus") - move))
                                }
                                _ => { ret2!(1 / 0) }
                              }
                            }
                          }
                          _ => { bufferState!(s) | ret2!((false, "payment")) }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract SurplusBuffer(@"cover", @badDebt, @auth, ret2) = {
    if (auth != *bufferCoverAuth) { ret2!((false, "bad buffer authority")) }
    else {
      if (badDebt < 0) { ret2!((false, "amount")) }
      else {
        for (@s <- bufferState) {
          match (s.get("sin") + badDebt) {
            newSin => {
              new cCh in {
              bufferCancelled!(s.get("surplus"), newSin, *cCh) |
              for (@cancelled <- cCh) {
                  if (cancelled <= 0) {
                    bufferState!(s.set("sin", newSin).set("rev", s.get("rev") + 1)) |
                    ret2!((true, 0, newSin))
                  } else {
                    new wCh, bCh in {
                      @bufferPurse!("withdraw", (brand, cancelled), *wCh) |
                      for (@w <- wCh) {
                        match w {
                          (true, payment) => {
                            Stablecoin!("burn", payment, cancelled, *burnAuth, *bCh) |
                            for (@b <- bCh) {
                              match b {
                                (true, _, _) => {
                                  bufferState!(s.set("surplus", s.get("surplus") - cancelled)
                                    .set("sin", newSin - cancelled).set("rev", s.get("rev") + 1)) |
                                  ret2!((true, cancelled, newSin - cancelled))
                                }
                                _ => { ret2!(1 / 0) }
                              }
                            }
                          }
                          _ => { bufferState!(s) | ret2!((false, "payment")) }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  contract SurplusBuffer(@"info", ret2) = {
    for (@s <<- bufferState) {
      ret2!((true, {"surplus": s.get("surplus"), "sin": s.get("sin"),
                    "savingsShareBps": s.get("savingsShareBps"),
                    "rev": s.get("rev")}))
    }
  } |

  contract SurplusBuffer(@"scheduleShare", @bps, @nonce, @sigs, ret2) = {
    if (bps < 0 || bps > 10000) { ret2!((false, "bps")) }
    else {
      new gCh, vCh in {
        vaultGovernor!(*gCh) |
        for (Governor <- gCh) {
          Governor!("schedule", "stablecoin:" ++ currency, nonce,
                    "setSavingsShare", bps.toString(), bps, sigs, *vCh) |
          for (@v <- vCh) {
            match v {
              (true, readyAt) => { ret2!((true, readyAt)) }
              _ => { ret2!(v) }
            }
          }
        }
      }
    }
  } |

  contract SurplusBuffer(@"applyShare", @nonce, ret2) = {
    new gCh, eCh in {
      vaultGovernor!(*gCh) |
      for (Governor <- gCh) {
        Governor!("execute", "stablecoin:" ++ currency, nonce, *eCh) |
        for (@ex <- eCh) {
          match ex {
            (true, action, argsHash, args) => {
              if (action != "setSavingsShare") { ret2!((false, "action")) }
              else {
                if (args < 0 || args > 10000) { ret2!((false, "bps")) }
                else {
                  if (argsHash != args.toString()) { ret2!((false, "params hash")) }
                  else {
                    for (@s <- bufferState) {
                      bufferState!(s.set("savingsShareBps", args)
                        .set("rev", s.get("rev") + 1)) |
                      ret2!((true, args))
                    }
                  }
                }
              }
            }
            _ => { ret2!(ex) }
          }
        }
      }
    }
  } |

  contract PegStabilityModule(@"fundRev", payment, ret2) = {
    new amtCh, dCh in {
      @revIssuer!("getAmountOf", *payment, *amtCh) |
      for (@a <- amtCh) {
        match a {
          (true, amount) => {
            @psmRevPurse!("deposit", *payment, *dCh) |
            for (@d <- dCh) {
              match d {
                (true, _) => { ret2!((true, amount)) }
                _ => { ret2!((false, "deposit", *payment)) }
              }
            }
          }
          _ => { ret2!((false, "asset", *payment)) }
        }
      }
    }
  } |

  contract PegStabilityModule(@"sellStable", payment, revFacet, @minRev, ret2) = {
    new amtCh, rateCh, balCh, grossCh, feeCh in {
      @issuer!("getAmountOf", *payment, *amtCh) |
      for (@a <- amtCh) {
        match a {
          (true, amount) => {
            for (@ps <<- paramsState; @st <- psmState) {
              vaultPrice!(currency, ps.get("params").get("maxOracleAge"), *rateCh) |
              for (@rr <- rateCh) {
                match rr {
                  (rate, fresh) => {
                    if (fresh == false || rate <= 0) {
                      ret2!((false, "stale feed", *payment))
                    } else {
                      grossCh!(((amount * 100000000) / rate).toInt()) |
                      for (@grossRev <- grossCh) {
                        feeCeil!(grossRev, st.get("feeBps"), *feeCh) |
                        for (@feeRev <- feeCh) {
                          match (grossRev - feeRev) {
                            revOut => {
                              @psmRevPurse!("getCurrentAmount", *balCh) |
                              for (@bal <- balCh) {
                                match bal {
                                  (true, available) => {
                                    if (revOut <= 0 || revOut < minRev) {
                                      ret2!((false, "min rev", *payment))
                                    } else {
                                      if (revOut > available) {
                                        ret2!((false, "buffer", *payment))
                                      } else {
                                        psmSellCommit!(amount, revOut, feeRev, st,
                                                       *payment, revFacet, *ret2)
                                      }
                                    }
                                  }
                                  _ => { ret2!((false, "balance", *payment)) }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
          _ => { ret2!((false, "asset", *payment)) }
        }
      }
    }
  } |

  contract PegStabilityModule(@"buyStable", payment, stableFacet, @minStable, ret2) = {
    new amtCh, rateCh, grossCh, feeCh in {
      @revIssuer!("getAmountOf", *payment, *amtCh) |
      for (@a <- amtCh) {
        match a {
          (true, amount) => {
            for (@ps <<- paramsState; @st <- psmState; @vs <- vaultState) {
              if (vs.get("paused")) {
                ret2!((false, "paused", *payment))
              } else {
                vaultPrice!(currency, ps.get("params").get("maxOracleAge"), *rateCh) |
                for (@rr <- rateCh) {
                  match rr {
                    (rate, fresh) => {
                      if (fresh == false || rate <= 0) {
                        ret2!((false, "stale feed", *payment))
                      } else {
                        grossCh!(((amount * rate) / 100000000).toInt()) |
                        for (@gross <- grossCh) {
                          feeCeil!(gross, st.get("feeBps"), *feeCh) |
                          for (@fee <- feeCh) {
                            match (gross - fee) {
                              stableOut => {
                                if (stableOut <= 0 || stableOut < minStable) {
                                  ret2!((false, "min stable", *payment))
                                } else {
                                  if (st.get("stableDebt") + stableOut > st.get("ceiling")) {
                                    ret2!((false, "ceiling", *payment))
                                  } else {
                                    psmBuyCommit!(stableOut, fee, st, *payment,
                                                  stableFacet, *ret2)
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
          _ => { ret2!((false, "asset", *payment)) }
        }
      }
    }
  } |

  contract PegStabilityModule(@"schedulePolicy", @feeBps, @ceiling, @nonce, @sigs, ret2) = {
    if (feeBps < 0 || feeBps > 1000) { ret2!((false, "psm fee")) }
    else {
      if (ceiling < 0) { ret2!((false, "ceiling")) }
      else {
        new gCh, sCh in {
          vaultGovernor!(*gCh) |
          for (Governor <- gCh) {
            Governor!("schedule", "stablecoin:" ++ currency, nonce, "setPsmPolicy",
                      feeBps.toString() ++ "|" ++ ceiling.toString(),
                      {"feeBps": feeBps, "ceiling": ceiling}, sigs, *sCh) |
            for (@gv <- sCh) {
              match gv {
                (true, readyAt) => { ret2!((true, readyAt)) }
                _ => { ret2!(gv) }
              }
            }
          }
        }
      }
    }
  } |

  contract PegStabilityModule(@"applyPolicy", @nonce, ret2) = {
    new gCh, eCh in {
      vaultGovernor!(*gCh) |
      for (Governor <- gCh) {
        Governor!("execute", "stablecoin:" ++ currency, nonce, *eCh) |
        for (@ex <- eCh) {
          match ex {
            (true, action, argsHash, args) => {
              if (action != "setPsmPolicy") { ret2!((false, "action")) }
              else {
                match (args.get("feeBps")) {
                  feeBps => {
                    match (args.get("ceiling")) {
                      ceiling => {
                        if (feeBps < 0 || feeBps > 1000) { ret2!((false, "psm fee")) }
                        else {
                          if (ceiling < 0) { ret2!((false, "ceiling")) }
                          else {
                            if (argsHash != feeBps.toString() ++ "|" ++ ceiling.toString()) {
                              ret2!((false, "params hash"))
                            } else {
                              for (@s <- psmState) {
                                if (ceiling < s.get("stableDebt")) {
                                  ret2!((false, "ceiling"))
                                } else {
                                  psmState!(s.set("feeBps", feeBps)
                                    .set("ceiling", ceiling)
                                    .set("rev", s.get("rev") + 1)) |
                                  ret2!((true, {"feeBps": feeBps, "ceiling": ceiling}))
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
            _ => { ret2!(ex) }
          }
        }
      }
    }
  } |

  contract PegStabilityModule(@"info", ret2) = {
    new balCh in {
      @psmRevPurse!("getCurrentAmount", *balCh) |
      for (@s <<- psmState; @b <- balCh) {
        match b {
          (true, revBalance) => {
            ret2!((true, {"stableDebt": s.get("stableDebt"),
                          "feeBps": s.get("feeBps"),
                          "ceiling": s.get("ceiling"),
                          "revBalance": revBalance,
                          "rev": s.get("rev")}))
          }
          _ => { ret2!((false, "balance")) }
        }
      }
    }
  } |

  contract PegStabilityModule(@"debt", ret2) = {
    for (@s <<- psmState) { ret2!((true, s.get("stableDebt"))) }
  } |

                    issuerState!({
                      "totalPrincipal": 0,
                      "maxSupply": 2000000000000000
                    }) |
                    paramsState!({"params": params, "hash": paramsHash, "rev": 0}) |
                    savingsState!({"totalShares": 0, "totalAssets": 0,
                                   "shares": {}, "rev": 0}) |
                    bufferState!({"surplus": 0, "sin": 0,
                                  "savingsShareBps": params.get("savingsShareBps"),
                                  "rev": 0}) |
                    psmState!({"stableDebt": 0, "feeBps": params.get("psmFeeBps"),
                               "ceiling": params.get("debtCeiling"), "rev": 0}) |
                    vaultState!({
                      "vaults": {},
                      "totalDebt": 0,
                      "totalAccruedInterest": 0,
                      "totalCollateral": 0,
                      "badDebt": 0,
                      "paused": false,
                      "rev": 0
                    }) |
                    rs!(bundle+{*Stablecoin}, *uSC) |
                    rs!(bundle+{*CollateralCustody}, *uCustody) |
                    rs!(bundle+{*RiskParameters}, *uParams) |
                    rs!(bundle+{*VaultBook}, *uVault) |
                    rs!(bundle+{*LiquidationEngine}, *uLiq) |
                    rs!(bundle+{*SavingsPool}, *uSavings) |
                    rs!(bundle+{*SurplusBuffer}, *uBuffer) |
                    rs!(bundle+{*PegStabilityModule}, *uPsm) |
                    for (@scUri <- uSC; @custodyUri <- uCustody;
                         @paramsUri <- uParams; @vaultUri <- uVault;
                         @liqUri <- uLiq; @savingsUri <- uSavings;
                         @psmUri <- uPsm; @bufferUri <- uBuffer) {
                      Stablecoin!("attest", *attCh) |
                      for (@att <- attCh) {
                        deployId!([scUri, custodyUri, paramsUri, vaultUri, liqUri,
                                   savingsUri, psmUri, bufferUri, att])
                      }
                    }
                  }
                }
              }
            }
          }
        }
        _ => { deployId!(check) }
      }
    }
  }
}
