// v0.4 AccountFactory: ownerId -> account capability and proof authority.
// getOrCreate creates the account contract with the proof in its closure. The
// proof is never returned or passed through a message; verify compares it by
// name. The full purse/transfer Account arrives in Phase 2; this first account
// exposes vaultOpen so the issuer can be used without a proof leak.
// Placeholders: __ROOT_URI__.
new
  AccountFactory, factoryState,
  revAddress(`rho:rev:address`),
  rl(`rho:registry:lookup`),
  rs(`rho:registry:insertArbitrary`),
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`),
  rootCh, Root, uFactory, ack
in {

  contract AccountFactory(@"getOrCreate", @pubKeyBytes, ret) = {
    new addrCh in {
      revAddress!("fromPublicKey", pubKeyBytes, *addrCh) |
      for (@ownerId <- addrCh) {
        for (@s <<- factoryState) {
          match s.get("accounts").get(ownerId) {
            Nil => {
              for (@s2 <- factoryState) {
                match s2.get("accounts").get(ownerId) {
                  Nil => {
                    new proof, account in {
                      contract account(@"vaultOpen", @vaultUri, ret2) = {
                        new vc in {
                          rl!(vaultUri, *vc) |
                          for (VaultBook <- vc) {
                            VaultBook!("open", ownerId, *proof, *ret2)
                          }
                        }
                      } |
                      factoryState!(s2.set("accounts",
                        s2.get("accounts").set(ownerId, {
                          "account": bundle+{*account},
                          "proof": *proof
                        }))) |
                      ret!((true, bundle+{*account}, ownerId))
                    }
                  }
                  entry => {
                    factoryState!(s2) |
                    ret!((true, entry.get("account"), ownerId))
                  }
                }
              }
            }
            entry => {
              ret!((true, entry.get("account"), ownerId))
            }
          }
        }
      }
    }
  } |

  contract AccountFactory(@"verify", @ownerId, proof, ret) = {
    for (@s <<- factoryState) {
      match s.get("accounts").get(ownerId) {
        Nil => { ret!((true, false)) }
        stored => { ret!((true, stored.get("proof") == *proof)) }
      }
    }
  } |

  contract AccountFactory(@"accountOf", @ownerId, ret) = {
    for (@s <<- factoryState) {
      match s.get("accounts").get(ownerId) {
        Nil => { ret!((false, "no account")) }
        entry => { ret!((true, entry.get("account"))) }
      }
    }
  } |

  factoryState!({"accounts": {}}) |

  rl!(`__ROOT_URI__`, *rootCh) |
  for (Root <- rootCh) {
    rs!(bundle+{*AccountFactory}, *uFactory) |
    for (@uri <- uFactory) {
      Root!("register", "component:account-factory", uri, 1, "account", *deployerId, *ack) |
      for (@r <- ack) { deployId!([uri]) }
    }
  }
}
