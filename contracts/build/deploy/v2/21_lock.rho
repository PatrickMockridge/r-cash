// v0.2 install step 7b: create the liquidity lock for one market.
// The pool capability is read from the registry; the lock creates its own LP purse.
new
  rl(`rho:registry:lookup`),
  compCh, regCh,
  poolCh,
  lpCh,
  lpPurseCh,
  LiquidityLock, lockState, lockNow, lockAdminApply,
  capOutCh,
  bd(`rho:block:data`),
  deployerIdOps(`rho:rchain:deployerId:ops`),
  verify(`rho:crypto:secp256k1Verify`),
  hash(`rho:crypto:blake2b256Hash`),
  guardArgsToString, guardArgsAppend, guardAnySig, guardCount, verifyAdmin,
  baseCh, quoteCh, marketIdCh,
  deployId(`rho:rchain:deployId`)
in {
  baseCh!("__BASE__") |
  quoteCh!("__QUOTE__") |
  marketIdCh!("__MARKET_ID__") |
  for (@base <- baseCh; @quote <- quoteCh; @marketId <- marketIdCh) {
    rl!(`__COMPONENTS_URI__`, *compCh) |
    for (Components <- compCh) {
      Components!("get", "component:listings", *regCh) |
      for (@(true, ListingRegistry) <- regCh) {
      @ListingRegistry!("marketCap", marketId, "pool", *poolCh) |
      for (@(true, pool) <- poolCh) {
        @pool!("lpAsset", *lpCh) |
        for (@(true, lpBrand, lpIssuer) <- lpCh) {
          @lpIssuer!("makeEmptyPurse", *lpPurseCh) |
          for (@(true, lpPurse) <- lpPurseCh) {
            lockState!({
              "marketId": marketId,
              "termsHash": "__TERMS_HASH__".hexToBytes(),
              "beneficiaryPubKey": "__SPONSOR_PUB__".hexToBytes(),
              "beneficiaryOwnerId": "__SPONSOR_OWNER__",
              "lpBrand": lpBrand,
              "lpIssuer": lpIssuer,
              "minShares": __INITIAL_SHARES__,
              "untilHeight": __LOCK_UNTIL__,
              "shares": 0,
              "funded": false,
              "released": false,
              "cancelled": false,
              "fundedAt": 0,
              "admins": __ADMIN_KEYS__,
              "threshold": 2,
              "govNonce": 0
            }) |
// ---- begin lib/Guard.rho ----
// Guard: M-of-N admin signature verification over a canonical payload.
//
// Off-chain canonical string (tools/sign_payload.py):
//   "rcash:admin:v1|<component>|<nonce>|<action>|<arg0>,<arg1>,..."
// The contract hashes the UTF-8 bytes with blake2b256 and verifies DER secp256k1 signatures
// with `secp256k1Verify(hash, sig, pubkey)`.
//
// Captured system channels: hash (`rho:crypto:blake2b256Hash`), verify
// (`rho:crypto:secp256k1Verify`). Helper names are declared by the including component.

contract guardArgsToString(@args, ret) = {
  if (args.length() == 0) {
    ret!("")
  } else {
    match args.nth(0) {
      a => {
        new restCh in {
          guardArgsAppend!(args, 1, a.toString(), *restCh) |
          for (@s <- restCh) { ret!(s) }
        }
      }
    }
  }
} |

contract guardArgsAppend(@args, @i, @acc, ret) = {
  if (i >= args.length()) {
    ret!(acc)
  } else {
    match args.nth(i) {
      a => {
        guardArgsAppend!(args, i + 1, acc ++ "," ++ a.toString(), *ret)
      }
    }
  }
} |

contract guardAnySig(@digest, @sigs, @j, @key, ret) = {
  if (j >= sigs.length()) {
    ret!(false)
  } else {
    match sigs.nth(j) {
      sig => {
        new vCh in {
          verify!(digest, sig, key, *vCh) |
          for (@ok <- vCh) {
            if (ok) { ret!(true) } else { guardAnySig!(digest, sigs, j + 1, key, *ret) }
          }
        }
      }
    }
  }
} |

contract guardCount(@digest, @sigs, @i, @count, @keys, @threshold, ret) = {
  if (i >= keys.length()) {
    ret!(count >= threshold)
  } else {
    match keys.nth(i) {
      key => {
        new anyCh in {
          guardAnySig!(digest, sigs, 0, key, *anyCh) |
          for (@any <- anyCh) {
            if (any) { guardCount!(digest, sigs, i + 1, count + 1, keys, threshold, *ret) }
            else { guardCount!(digest, sigs, i + 1, count, keys, threshold, *ret) }
          }
        }
      }
    }
  }
} |

contract verifyAdmin(@component, @nonce, @action, @args, @sigs, @keys, @threshold, ret) = {
  new strCh, hashCh, okCh in {
    guardArgsToString!(args, *strCh) |
    for (@argStr <- strCh) {
      match "rcash:admin:v1|" ++ component ++ "|" ++ nonce.toString() ++ "|" ++ action ++ "|" ++ argStr {
        payload => {
          hash!(payload.toUtf8Bytes(), *hashCh) |
          for (@digest <- hashCh) {
            guardCount!(digest, sigs, 0, 0, keys, threshold, *okCh) |
            for (@ok <- okCh) { ret!(ok) }
          }
        }
      }
    }
  }
} |
// ---- end lib/Guard.rho ----
// ---- begin lock/LiquidityLock.rho ----
// LiquidityLock: the sponsor's initial LP shares, locked until a height.
//
// Captured: lockState, lpIssuer, lpBrand, lpPurse, deployerIdOps, bd, Guard helpers.
// State: {marketId, termsHash, beneficiaryPubKey, beneficiaryOwnerId, lpBrand, lpIssuer,
//         minShares, untilHeight, shares, funded, released, cancelled, fundedAt,
//         admins, threshold, govNonce}
// Release is beneficiary-only and time-locked. A 2-of-3 cancel is the fallback for a
// cancelled draft market; delisting an active market does not release the seed early.

contract lockNow(ret) = {
  new ch in { bd!(*ch) | for (@h, @s, @t <- ch) { ret!(h) } }
} |

contract LiquidityLock(@"lock", lpPayment, ret) = {
  new amtCh, nowCh in {
    @lpIssuer!("getAmountOf", *lpPayment, *amtCh) |
    lockNow!(*nowCh) |
    for (@a <- amtCh; @now <- nowCh) {
      match a {
        (true, shares) => {
          for (@s <<- lockState) {
            if (s.get("funded")) { ret!((false, "already funded")) }
            else {
              if (s.get("cancelled")) { ret!((false, "cancelled")) }
              else {
                if (shares < s.get("minShares")) { ret!((false, "below min shares")) }
                else {
                  if (now >= s.get("untilHeight")) { ret!((false, "lock expired")) }
                  else {
                    new depCh in {
                      @lpPurse!("deposit", *lpPayment, *depCh) |
                      for (@d <- depCh) {
                        match d {
                          (true, bal) => {
                            for (@cur <- lockState) {
                              if (cur.get("funded")) { lockState!(cur) | ret!((false, "already funded")) }
                              else {
                                lockState!(cur.set("shares", shares).set("funded", true)
                                              .set("fundedAt", now)) |
                                ret!((true, shares))
                              }
                            }
                          }
                          _ => ret!((false, "deposit refused"))
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        _ => ret!((false, "not an LP payment"))
      }
    }
  }
} |

contract LiquidityLock(@"release", deployerId, ret) = {
  new pkCh, nowCh in {
    deployerIdOps!("pubKeyBytes", *deployerId, *pkCh) |
    lockNow!(*nowCh) |
    for (@pk <- pkCh; @now <- nowCh) {
      for (@s <- lockState) {
        if (pk != s.get("beneficiaryPubKey")) { lockState!(s) | ret!((false, "not beneficiary")) }
        else {
          if (s.get("funded") == false) { lockState!(s) | ret!((false, "not funded")) }
          else {
            if (s.get("released")) { lockState!(s) | ret!((false, "already released")) }
            else {
              if (now < s.get("untilHeight") && s.get("cancelled") == false) {
                lockState!(s) | ret!((false, "not yet"))
              } else {
                new wdCh in {
                  @lpPurse!("withdraw", (lpBrand, s.get("shares")), *wdCh) |
                  for (@w <- wdCh) {
                    match w {
                      (true, pay) => {
                        lockState!(s.set("released", true)) |
                        ret!((true, s.get("shares"), pay))
                      }
                      _ => { lockState!(s) | ret!((false, "withdraw refused")) }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
} |

contract LiquidityLock(@"info", ret) = {
  for (@s <<- lockState) {
    ret!((true, {
      "marketId": s.get("marketId"),
      "termsHash": s.get("termsHash"),
      "beneficiaryPubKey": s.get("beneficiaryPubKey"),
      "beneficiaryOwnerId": s.get("beneficiaryOwnerId"),
      "lpBrand": s.get("lpBrand"),
      "lpIssuer": s.get("lpIssuer"),
      "minShares": s.get("minShares"),
      "shares": s.get("shares"),
      "untilHeight": s.get("untilHeight"),
      "funded": s.get("funded"),
      "released": s.get("released"),
      "cancelled": s.get("cancelled"),
      "fundedAt": s.get("fundedAt")
    }))
  }
} |

contract lockAdminApply(@action, @nonce, ret) = {
  for (@s <- lockState) {
    if (nonce <= s.get("govNonce")) { lockState!(s) | ret!((false, "replay")) }
    else {
      if (action == "cancel") {
        lockState!(s.set("cancelled", true).set("govNonce", nonce)) | ret!((true, Nil))
      } else { lockState!(s) | ret!((false, "unknown action")) }
    }
  }
} |

contract LiquidityLock(@"admin", @nonce, @action, @args, @sigs, ret) = {
  for (@s <<- lockState) {
    match s.get("admins") {
      Nil => ret!((false, "no admins"))
      admins => {
        match s.get("threshold") {
          threshold => {
            match s.get("govNonce") {
              lastNonce => {
                if (nonce <= lastNonce) { ret!((false, "replay")) }
                else {
                  new okCh in {
                    verifyAdmin!("lock:" ++ s.get("marketId"), nonce, action, args, sigs,
                                 admins, threshold, *okCh) |
                    for (@ok <- okCh) {
                      if (ok) { lockAdminApply!(action, nonce, *ret) }
                      else { ret!((false, "signatures")) }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
} |
// ---- end lock/LiquidityLock.rho ----
            @ListingRegistry!("registerMarketCap", marketId, "lock", *LiquidityLock, *capOutCh) |
            for (@capOut <- capOutCh) { deployId!(capOut) }
          }
        }
      }
      }
    }
  }
}
