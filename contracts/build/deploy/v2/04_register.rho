// v0.2 install step 5: register the Directory names used by v0.2 and lock it.
// The live registry and market capabilities live in ComponentRegistry, not Directory.
// Placeholders: __DIRECTORY_URI__, __ACCOUNTS_URI__, __ORACLE_URI__.
new
  rl(`rho:registry:lookup`),
  dirCh,
  Directory,
  a1, a2, a3,
  lockCh,
  deployId(`rho:rchain:deployId`)
in {
  rl!(`__DIRECTORY_URI__`, *dirCh) |
  for (Directory <- dirCh) {
    Directory!("register", "component:accounts", "__ACCOUNTS_URI__", *a1) |
    Directory!("register", "component:oracle", "__ORACLE_URI__", *a2) |
    Directory!("registerAsset", "REV", "rev", "system:ertp", 8, *a3) |
    for (@r1 <- a1; @r2 <- a2; @r3 <- a3) {
      Directory!("lock", *lockCh) |
      for (@l <- lockCh) { deployId!((r1, r2, r3, l)) }
    }
  }
}
