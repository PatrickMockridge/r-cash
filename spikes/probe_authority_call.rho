// Phase-0 gate: present the deploy's own unforgeable deployerId to the auth contract.
new
  rl(`rho:registry:lookup`),
  ch,
  ret,
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`)
in {
  rl!(`__URI__`, *ch) |
  for (auth <- ch) {
    auth!("check", *deployerId, *ret) |
    for (@ok <- ret) { deployId!(ok) }
  }
}
