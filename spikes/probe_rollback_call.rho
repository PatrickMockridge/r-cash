// Phase-0 gate: trigger the rollback arm. The deploy is expected to fail.
new
  rl(`rho:registry:lookup`),
  ch,
  ret,
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`)
in {
  rl!(`__URI__`, *ch) |
  for (c <- ch) {
    c!("boom", *deployerId, *ret) |
    for (@x <- ret) { deployId!(x) }
  }
}
