// Phase-0 gate: fund a contract-held REV purse from the caller's own native vault.
// __URI__ and __AMOUNT__ are substituted by the harness.
new
  rl(`rho:registry:lookup`),
  ch,
  ret,
  deployerId(`rho:rchain:deployerId`),
  deployId(`rho:rchain:deployId`)
in {
  rl!(`__URI__`, *ch) |
  for (custody <- ch) {
    custody!("fundFor", *deployerId, __AMOUNT__, *ret) |
    for (@r <- ret) { deployId!(r) }
  }
}
