{
  "name": "rcash-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "predev": "node scripts/build-wasm.mjs && node scripts/sync-manifest.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-wasm.mjs && node scripts/sync-manifest.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:wasm": "node scripts/build-wasm.mjs && node tests/wasm-smoke.mjs",
    "wasm:build": "node scripts/build-wasm.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
